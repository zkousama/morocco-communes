---
/**
 * The Arabic version of /docs/insights/. Same content, same code: see that file for the
 * comment that says where each sentence comes from.
 */
import Docs from "../../../layouts/Docs.astro";
import { t } from "../../../i18n/ui";
import { numbers, percent } from "../../../lib/format";
import { method } from "../../../lib/insights";

const locale = "ar";
const copy = t(locale);

const toc = [
  { id: "stands-out", label: "ما يبرز" },
  { id: "left-out", label: "ما يُستبعد" },
  { id: "context", label: "ما يرافق كل رقم" },
];

const n = numbers(locale);
const count = (value: number) => n.format(value);
const whole = (fraction: number) => percent(locale, fraction * 100, { digits: 0 });
const pct = (value: number) => percent(locale, value, { digits: 0 });

---

<Docs
  locale={locale}
  route="docs/insights/"
  title="طريقة اختيار الأرقام البارزة"
  description="كيف تختار صفحة الجماعة الأرقام البارزة، وما تستبعده، ومن أين يأتي كل رقم يرافقها."
  lede="قد تعرض صفحة الجماعة الأرقام التي تبتعد فيها الجماعة أكثر عن غيرها، ومع كل رقم الجماعات المجاورة وسنة 2014. هذه طريقة اختيارها ومصدر كل رقم. لا يكتب أي نموذج لغوي شيئا منها."
  toc={toc}
>
  <p class="note"><a href="/ar/insights/">{copy.insightsFigures}</a></p>
  <section id="stands-out">
    <h2>ما يبرز</h2>
    <p>
      تبرز جماعة يبلغ عدد سكانها {count(method.extremeFloor)} نسمة أو أكثر حين تكون ضمن أعلى أو
      أدنى {whole(method.extremeTail)} من هذه الجماعات في مؤشر ما. وتبرز وحدة حين يبتعد تغير رقمها منذ 2014
      بمقدار {count(method.deviations)} انحرافات معيارية أو أكثر عن متوسط التغير في مستواها، إذا ضم
      المستوى {count(method.changeLevelSize)} وحدات أو أكثر وكان سؤال المؤشر قد طرح بالطريقة نفسها في إحصاء 2014.
      وتبرز جماعة أو عمالة أو إقليم أيضا حين يبتعد الفرق بين الرقم ورقم الوحدة الأعلى، أي العمالة أو الإقليم أو
      الجهة، بمقدار {count(method.deviations)} انحرافات معيارية أو أكثر عن متوسط هذا الفرق داخل الوحدة الأعلى، إذا
      ضمت {count(method.gapGroupSize)} وحدات أو أكثر. ولا يحتسب التغير والفرق إلا في الجماعات التي يبلغ عدد
      سكانها {count(method.changeGapFloor)} نسمة أو أكثر، حيث لا تستطيع بضع أسر وحدها أن تغير نسبة.
    </p>
    <p>
      كل مؤشر هو معدل أو نسبة أو متوسط، لأن العدد الخام يبرز معه المكان الكبير لمجرد أنه كبير. الجماعة التي ربطت
      بسنة 2014 عبر جدول المطابقة ليس لها تغير يقارن، لأن رقمها في 2014 يغطي ترابا آخر. يحتفظ الموقع
      بأبرز {count(method.kept)} رقم، على ألا تتجاوز {count(method.perPlace)} للمكان الواحد. ولا تنشر إلا أرقام
      الجماعات، لأنها تظهر في صفحة الجماعة.
    </p>
  </section>

  <section id="left-out">
    <h2>ما يُستبعد</h2>
    <p>
      يستبعد ما قد يكون خطأ في البيانات. اللغات المستعملة والمقروءة والمكتوبة، والمستوى الدراسي، والأمية تتغير
      ببطء. فإذا تغير أحدها كثيرا في مكان تغير عدد سكانه بأقل من {whole(method.artefactCeiling)}، ولم تتغير أي
      جماعة مجاورة في الاتجاه نفسه بنصف ذلك على الأقل، فقد يكون الرقم خطأ في البيانات. وكذلك كل رقم في سجل لا
      يمكن أن يكون صحيحا، مثل أكثر من {count(method.peoplePerRoom)} أشخاص في الغرفة أو أسرة من أكثر
      من {count(method.householdSize)} فردا.
    </p>
    <p>
      وتستبعد كذلك كل جماعة لها رقم لا يتطابق فيه الإحصاءان. في اللغات المحلية المستعملة، هو نسبة تغيرت بأكثر
      من {count(method.swing)} نقطة بين إحصاء 2014 وإحصاء 2024، صعودا أو نزولا. وفي الماء الجاري والكهرباء وشبكة
      التطهير السائل والمرحاض والمطبخ، هو نسبة انخفضت بأكثر من {count(method.fall)} نقطة. وفي الحالتين يجب أن
      يفوق هذا التغير تغير عدد السكان نفسه، بالنسبة المئوية. الرقمان معا من المندوبية السامية للتخطيط، كما
      نشرتهما. ولأن الإحصاءين لا يتطابقان، لا تقارن الجماعة بأي جماعة مجاورة، ولا قسم لها هنا.
    </p>
    <p>
      تستبعد أيضا نسبتا الرجال والنساء، لأن جماعات عدة في الجنوب تضم فئات خاصة من السكان. ويستبعد التنقل إلى
      العمل بالترامواي أو القطار أو الحافلة أو سيارة الأجرة أو نقل يوفره المشغل، لأن هذه الخدمات لا توجد إلا في
      بعض الجماعات. وإذا وضعت قائمة بمصطلحات خاصة، يحجب كل رقم يستعمل سطره أحدها.
    </p>
    <p>
      يستبعد رقم من أرقام الاقتصاد أو السكن حين تضم الجماعة أقل من {count(method.smallBase)} مؤسسة، أو أقل
      من {count(method.smallBase)} مسكن حضري. فعدد قليل منها يكفي لتغيير نسبة.
    </p>
    <p>
      الجماعة التي تضم أقل من {count(method.minHouseholds)} أسرة، أو أكثر من {count(method.maxPerHousehold)} أفراد
      في الأسرة في المتوسط، تستبعد من الأرقام البارزة ومن كل مقارنة بين الجماعات: الجماعة المجاورة، والجماعة
      الأكثر شبها بها، وعجلة الملامح، والأسطر عما تغير وما هو نادر. أرقامها تبقى في صفحتها. في بعض جماعات
      الجنوب آلاف السكان وبضع عشرات من الأسر فقط، لأن باقي السكان لا يحصيهم الإحصاء ضمن أسر، فنسبة من الأسر
      هناك تمثل بضع عائلات.
    </p>
  </section>

  <section id="context">
    <h2>ما يرافق كل رقم</h2>
    <p>
      <strong>أرقام الجماعة الأخرى.</strong> تعرض الأرقام البارزة للجماعة معا، ويذكر سجل كل رقم في API الأرقام
      الأخرى.
    </p>
    <p>
      <strong>الجماعات المجاورة.</strong> تتجاور جماعتان حين يكون لحدودهما في OpenStreetMap مقطع مشترك. بجانب كل
      رقم يعرض وسيط الرقم نفسه في هذه الجماعات، والجماعة الأبعد عن رقم الجماعة نفسها. تستبعد الجماعة المجاورة
      التي يقل عدد سكانها عن {count(method.neighbourFloor)} نسمة، وكذلك التي لها رقم لا يتطابق فيه الإحصاءان.
      وفي التغير منذ 2014، يقارن تغير هذه الجماعات، وتستبعد الجماعة المجاورة التي ربطت بسنة 2014 عبر جدول
      المطابقة.
    </p>
    <p>
      <strong>2014 والمغرب.</strong> حين يكون سؤال الرقم قد طرح بالطريقة نفسها في إحصاء 2014، تعطي الصفحة رقم
      الجماعة في 2014 وتغير رقم المغرب، بنقط كاملة إذا كان نسبة. ولا تعطيهما لجماعة ربطت عبر جدول المطابقة.
    </p>
    <p>
      <strong>تقدير انطلاقا من عينة.</strong> في الجماعات التي تضم {count(method.sampleHouseholds)} أسرة أو أكثر،
      وجهت الاستمارة المطولة إلى عينة من الأسر. يحمل رقم الإحصاء هناك ملاحظة تقول إنه تقدير، مع رابط
      إلى <a href="/ar/docs/indicators/#reading">طريقة قراءة الإحصاء</a>.
    </p>
    <p>
      <strong>الجماعات من الصنف نفسه.</strong> يقارن رقم الإحصاء أيضا بالجماعات من النوع نفسه، حضرية أو قروية،
      ومن الحجم نفسه: أقل من {count(method.peerSmall)} نسمة، من {count(method.peerSmall)} إلى {count(method.peerMid)}، أو
      أكثر من {count(method.peerMid)}. وإذا كان ضمن أعلى {pct(method.peerTop)} أو {pct(method.peerHigh)} أو {pct(method.peerWide)} في
      مجموعة من {count(method.peerGroup)} جماعة على الأقل، يشير سطر إلى ذلك. أرقام الاقتصاد والسكن لا تقارن
      بهذه الطريقة.
    </p>
  </section>

</Docs>
