---
import Base from "../layouts/Base.astro";
import { path, t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<Base locale={locale} title={copy.notFoundTitle} description={copy.notFoundBody} current={false}>
  <section class="lost">
    <p class="mono code">404</p>
    <h1>{copy.notFoundTitle}</h1>
    <p>{copy.notFoundBody}</p>
    <p><a href={path(locale)}>{copy.notFoundHome}</a></p>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(3rem, 12vw, 8rem);
    max-width: 40rem;
  }

  .code {
    color: var(--brass);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(var(--t-lg), 5vw, var(--t-xl));
    line-height: 1.1;
    margin: 0 0 1rem;
  }
</style>
