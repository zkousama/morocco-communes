---
/**
 * Communes whose figures don't go together the way they do elsewhere. Each row names
 * the odd part, and the first row opens the scatter.
 */
import Base from "../layouts/Base.astro";
import { t, type Locale } from "../i18n/ui";
import { path } from "../i18n/ui";
import { cloudOf, oddAxis, oddHeading, oddLine, oddPage, scatter } from "../lib/odd";
import { pageOf } from "../lib/places";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const rows = oddPage.flatMap((row) => {
  const page = pageOf(row.code);
  if (!page) return [];
  const cloud = cloudOf(row.a, row.b);
  const highlight = cloud.points.findIndex((point) => point.code === row.code);
  const sentence = oddLine(locale, row, page.name.fr);
  const at = sentence.indexOf(page.name.fr);
  return [{
    row,
    page,
    heading: oddHeading(locale, row),
    before: at < 0 ? "" : sentence.slice(0, at),
    after: at < 0 ? sentence : sentence.slice(at + page.name.fr.length),
    svg: scatter(cloud.points, highlight, {
      label: copy.oddScatter,
      xLabel: oddAxis(locale, row.a),
      yLabel: oddAxis(locale, row.b),
      slope: cloud.slope,
      intercept: cloud.intercept,
    }),
  }];
});
---

<Base locale={locale} route="odd/" title={copy.oddTitle} description={copy.oddLede}>
  <article class="odd">
    <h1>{copy.oddTitle}</h1>
    <p class="lede">{copy.oddLede}</p>
    <ol>
      {rows.map(({ page, heading, before, after, svg }, i) => (
        <li>
          <h2>{heading}</h2>
          <p>{before}<a href={path(locale, page.route)}>{page.name.fr}</a>{after}</p>
          <details open={i === 0}>
            <summary>{copy.oddScatter}</summary>
            <div class="plot" set:html={svg} />
          </details>
        </li>
      ))}
    </ol>
  </article>
</Base>

<style>
  .odd {
    padding-block: clamp(2rem, 6vw, 4rem);
    max-width: 46rem;
  }

  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(var(--t-lg), 5vw, var(--t-xl));
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .lede {
    color: var(--quiet);
    font-size: var(--t-md);
    max-width: 62ch;
  }

  ol {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  li {
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  li h2 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--t-base);
    line-height: 1.3;
    margin: 0 0 0.35rem;
  }

  li p {
    margin: 0;
  }

  li p + p {
    margin-top: 0.35rem;
  }

  li a {
    font-weight: 500;
  }

  details {
    margin-top: 0.5rem;
  }

  summary {
    font-size: var(--t-sm);
    color: var(--quiet);
    cursor: pointer;
  }

  summary:hover {
    color: var(--ink);
  }

  li :global(svg) {
    display: block;
    width: min(100%, 20rem);
    height: auto;
    margin-top: 0.75rem;
  }

  li :global(.dot) {
    fill: var(--quiet);
    opacity: 0.45;
  }

  li :global(.here) {
    fill: var(--brass);
  }

  li :global(.line) {
    stroke: var(--quiet);
    stroke-width: 1;
    opacity: 0.4;
  }

  li :global(.axis) {
    fill: var(--quiet);
    font-family: var(--sans);
    font-size: 9px;
  }
</style>
