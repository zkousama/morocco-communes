---
import { LIMIT, PER_PAGE, RADIUS_KM } from "../../../api/src/lib/params.ts";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);

// The limits are read from the Worker's own module, so this table cannot disagree with it.
const fill = (text: string, values: Record<string, number>) =>
  text.replace(/\{(\w+)\}/g, (_, key: string) => String(values[key] ?? `{${key}}`));

const routes = [
  {
    path: "/api/search",
    params: [
      { name: "q", value: copy.refRequired, required: true, text: copy.pQ },
      { name: "levels", value: copy.refAll, text: copy.pLevels },
      { name: "limit", value: String(LIMIT.default), text: fill(copy.pLimit, { max: LIMIT.max }) },
    ],
  },
  {
    path: "/api/communes/near",
    params: [
      { name: "lat", value: copy.refRequired, required: true, text: copy.pLat },
      { name: "lng", value: copy.refRequired, required: true, text: copy.pLng },
      { name: "radius", value: String(RADIUS_KM.default), text: fill(copy.pRadius, { max: RADIUS_KM.max }) },
      { name: "limit", value: String(LIMIT.default), text: fill(copy.pLimit, { max: LIMIT.max }) },
    ],
  },
  {
    path: "/api/communes",
    params: [
      { name: "region, province, cercle", value: "", text: copy.pUnit },
      { name: "type", value: "", text: copy.pType },
      { name: "page", value: "1", text: fill(copy.pPage, { per: PER_PAGE }) },
      { name: "q", value: "", text: copy.pCommunesQ },
    ],
  },
];
---

<div class="ref">
  {routes.map((route) => (
    <section class="route">
      <h3 class="mono"><span class="verb">GET</span> {route.path}</h3>
      <table>
        <colgroup>
          <col class="c-name" />
          <col class="c-value" />
          <col />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">{copy.refParam}</th>
            <th scope="col">{copy.refDefault}</th>
            <th scope="col"><span class="sr-only">{copy.refParam}</span></th>
          </tr>
        </thead>
        <tbody>
          {route.params.map((p) => (
            <tr>
              <td class="mono name">{p.name}</td>
              <td class:list={["mono", "value", { required: p.required }]}>{p.value}</td>
              <td class="text">{p.text}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
  <p class="machine">
    <a href="/api/openapi.json">OpenAPI</a>
    <a href="/llms.txt">llms.txt</a>
  </p>
</div>

<style>
  /* The same reference, for programs and agents rather than people. */
  .machine {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    font-size: var(--t-sm);
  }

  .ref {
    display: grid;
    gap: 2rem;
    margin-top: 1.75rem;
  }

  h3 {
    margin: 0 0 0.6rem;
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .verb {
    color: var(--quiet);
  }

  .route {
    overflow-x: auto;
  }

  /* Fixed layout with shared column widths, so the three tables line up as one
     reference instead of each sizing itself around its own longest name. */
  table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: var(--t-sm);
  }

  .c-name {
    width: 12.5rem;
  }

  .c-value {
    width: 7rem;
  }

  th {
    text-align: start;
    font-weight: 400;
    font-size: var(--t-xs);
    color: var(--quiet);
    padding: 0 1rem 0.45rem 0;
    border-bottom: 1px solid var(--rule);
  }

  td {
    padding: 0.55rem 1rem 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: baseline;
  }

  .name {
    color: var(--brass);
  }

  .value {
    white-space: nowrap;
    color: var(--quiet);
  }

  .value.required {
    color: var(--ink);
  }

  .text {
    color: var(--quiet);
  }
</style>
