---
/**
 * Whether the 2014 to 2024 crosswalk holds up: the growth of the communes matched through it
 * against the growth of those whose code didn't change. If the matches were wrong, the 2
 * would scatter apart. On the glossary, under the crosswalk.
 */
import { spread } from "../generated/charts";
import { REPO_URL, t, type Locale } from "../i18n/ui";
import { escapeHtml } from "../lib/highlight";
import { percent as formatPercent } from "../lib/format";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const group = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-GB");

/* Chart 3: the two growth distributions, on one shared scale. */
const lo = Math.min(...spread.map((s) => s.p10));
const hi = Math.max(...spread.map((s) => s.p90));
const pad = (hi - lo) * 0.08;
const scale = (v: number) => ((v - (lo - pad)) / (hi - lo + pad * 2)) * 100;
const ticks = [-20, -10, 0, 10, 20];
const signed = (v: number) => formatPercent(locale, v, { signed: true, fixed: true });
const spoken = (row: (typeof spread)[number]) =>
  copy.srSpread.replace(/\{(\w+)\}/g, (_, key: string) =>
    signed((row as unknown as Record<string, number>)[key] ?? 0),
  );

---

<figure class="chart">
    <figcaption>
    <h3>{copy.chartSpread}</h3>
    <p>{copy.chartSpreadBody}</p>
  </figcaption>
  <div class="rangegrid">
    {spread.map((row) => (
    <>
      <span class="rangename">
        {row.basis === "exact_code" ? copy.spreadUnchanged : copy.spreadCrosswalk}
        <span class="n">{group.format(row.count)}</span>
        <span class="sr-only">{locale === "fr" ? " : " : ": "}{spoken(row)}</span>
      </span>
      <span class="rangetrack" aria-hidden="true">
        {ticks.map((tick) => (
          <span class:list={["tick", { zeroline: tick === 0 }]} style={`inset-inline-start:${scale(tick)}%`}></span>
        ))}
        <span
          class="whisker"
          style={`inset-inline-start:${scale(row.p10)}%;width:${scale(row.p90) - scale(row.p10)}%`}
        ></span>
        <span
          class="box"
          style={`inset-inline-start:${scale(row.p25)}%;width:${scale(row.p75) - scale(row.p25)}%`}
        ></span>
        <span class="median" style={`inset-inline-start:${scale(row.median)}%`}></span>
      </span>
    </>
    ))}
    <span class="spacer" aria-hidden="true"></span>
    <span class="scalebar" aria-hidden="true">
    {ticks.map((tick) => (
      <span style={`inset-inline-start:${scale(tick)}%`} class="tick-label">{formatPercent(locale, tick, { signed: true, digits: 0 })}</span>
    ))}
    </span>
  </div>
  <p
    class="note"
    set:html={escapeHtml(copy.chartSpreadNote).replace(
    "{crosswalk}",
    `<a href="${REPO_URL}/blob/main/data/v1/crosswalk/README.md">${escapeHtml(copy.linkCrosswalk)}</a>`,
    )}
  />
</figure>

<style>
  .chart {
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .chart h3 {
    margin: 0 0 0.3rem;
    font-size: var(--t-base);
    font-weight: 500;
  }

  .chart figcaption p {
    margin: 0;
    color: var(--quiet);
    font-size: var(--t-sm);
  }

  .chart .note {
    margin: 0;
    color: var(--quiet);
    font-size: var(--t-xs);
  }

  /* Box and whisker --------------------------------------------------------- */

  .rangegrid {
    display: grid;
    grid-template-columns: minmax(9rem, 17rem) minmax(0, 1fr);
    gap: 0.6rem 1rem;
    align-items: center;
  }

  .rangename {
    font-size: var(--t-sm);
    color: var(--ink);
    line-height: 1.4;
  }

  .rangename .n {
    font-size: var(--t-xs);
    color: var(--quiet);
    margin-inline-start: 0.5rem;
    font-variant-numeric: tabular-nums;
  }


  .rangetrack {
    position: relative;
    display: block;
    height: 1.5rem;
  }

  .tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }

  .tick.zeroline {
    background: var(--quiet);
  }

  .whisker {
    position: absolute;
    top: 50%;
    height: 1px;
    background: var(--chart-up);
    transform: translateY(-50%);
  }

  .box {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    background: var(--chart-up);
    opacity: 0.28;
    border-radius: 3px;
  }

  /* Reads against the box it sits inside, which the accent colour would not. */
  .median {
    position: absolute;
    top: 0.1rem;
    bottom: 0.1rem;
    width: 2px;
    background: var(--ink);
  }

  .scalebar {
    position: relative;
    display: block;
    height: 1rem;
  }

  .scalebar span {
    position: absolute;
    transform: translateX(-50%);
    font-size: var(--t-xs);
    color: var(--quiet);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 62rem) {
    .rangegrid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }

    .spacer {
      display: none;
    }
  }
</style>
