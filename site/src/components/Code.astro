---
import { escapeHtml } from "../lib/highlight";
import { highlight, type Lang } from "../lib/syntax";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** The text as it should be copied. */
  code?: string;
  /** Pre-rendered markup, for JSON coloured at build time. Its text is what's copied. */
  html?: string;
  label?: string;
  /** Caps the height, for a long response that would otherwise run for pages. */
  tall?: boolean;
  /** Colours the code by its language. */
  lang?: Lang;
}
const { locale, code = "", html, label, tall = false, lang } = Astro.props;
const markup = html ?? (lang ? highlight(code, lang) : escapeHtml(code));
const copy = t(locale);
---

<figure class="code">
  <figcaption>
    <span>{label}</span>
    <button type="button" data-copy data-label={copy.copy} data-done={copy.copied}>{copy.copy}</button>
  </figcaption>
  <pre class:list={{ tall }} tabindex="0"><code set:html={markup} /></pre>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const text = button.closest("figure")?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = button.dataset.done ?? "";
        setTimeout(() => (button.textContent = button.dataset.label ?? ""), 1600);
      } catch {
        // Clipboard access needs a secure context and a user gesture; without them the
        // text is still there to select by hand.
      }
    });
  }
</script>

<style>
  .code {
    margin: 0 0 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--well);
    min-width: 0;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.4rem 0.5rem 0.4rem 0.9rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  button {
    font: inherit;
    color: var(--quiet);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--ink);
    border-color: var(--quiet);
  }

  pre {
    margin: 0;
    padding: 0.85rem 0.9rem;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: var(--t-xs);
    line-height: 1.6;
    font-variant-ligatures: none;
    tab-size: 2;
  }

  pre.tall {
    max-height: 26rem;
    overflow-y: auto;
  }

  /* Shiki's token roles, mapped to the page's text colours: green for keywords and
     numbers, brown for strings, the quiet grey for comments and punctuation. */
  .code {
    --code-foreground: var(--ink);
    --code-token-keyword: var(--code-number);
    --code-token-constant: var(--code-number);
    --code-token-string: var(--code-string);
    --code-token-string-expression: var(--code-string);
    --code-token-link: var(--code-string);
    --code-token-comment: var(--quiet);
    --code-token-punctuation: var(--quiet);
    --code-token-function: var(--ink);
    --code-token-parameter: var(--ink);
    --code-token-inserted: var(--code-number);
    --code-token-deleted: var(--code-string);
    --code-token-changed: var(--ink);
  }

  /* JSON, coloured by what each token is. Text tokens keep the page's ink roles. */
  pre :global(.j-k) {
    color: var(--ink);
  }
  pre :global(.j-s) {
    color: var(--code-string);
  }
  pre :global(.j-n) {
    color: var(--code-number);
  }
  pre :global(.j-l) {
    color: var(--quiet);
  }
</style>
