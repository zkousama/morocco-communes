---
import { changeBreaks, densityBreaks, illiteracyBreaks, markup, shapes, viewBox } from "../generated/map";
import { path, t, type Locale } from "../i18n/ui";
import { percent } from "../lib/format";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const n = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-GB");

// One legend per view. Each swatch names its class the way the map's data attributes do.
const range = (breaks: number[], i: number, format: (v: number) => string) =>
  i === 0 ? `< ${format(breaks[0]!)}` : i === breaks.length ? `${format(breaks[i - 1]!)}+` : `${format(breaks[i - 1]!)}–${format(breaks[i]!)}`;
const views = [
  {
    id: "density",
    label: copy.mapDensity,
    unit: copy.legendDensity,
    swatches: [0, 1, 2, 3, 4, 5].map((i) => ({ cls: `d${i}`, text: range(densityBreaks, i, (v) => n.format(v)) })),
  },
  {
    id: "change",
    label: copy.mapChange,
    unit: copy.legendChange,
    // "−10 to −2%": the unit once, at the end, so two minus signs don't meet across a dash.
    swatches: [
      ...[0, 1, 2, 3, 4, 5].map((i) => {
        const pc = (v: number) => percent(locale, v, { signed: true, digits: 0 });
        const bare = (v: number) => pc(v).replace(/\s?%$/, "").replace(/\u202f%$/, "");
        const text =
          i === 2
            ? copy.mapAbout
            : i === 0
              ? `< ${pc(changeBreaks[0]!)}`
              : i === changeBreaks.length
                ? `> ${pc(changeBreaks[i - 1]!)}`
                : `${bare(changeBreaks[i - 1]!)} ${copy.mapTo} ${pc(changeBreaks[i]!)}`;
        return { cls: `g${i}`, text };
      }),
      { cls: "gn", text: copy.mapNoFigure },
    ],
  },
  {
    id: "illiteracy",
    label: copy.mapIlliteracy,
    unit: copy.legendIlliteracy,
    swatches: [
      ...[0, 1, 2, 3, 4, 5].map((i) => ({
        cls: `r${i}`,
        text: range(illiteracyBreaks, i, (v) => percent(locale, v, { digits: 0 })),
      })),
      { cls: "rn", text: copy.mapNoValue },
    ],
  },
  {
    id: "type",
    label: copy.mapType,
    unit: "",
    swatches: [
      { cls: "tu", text: copy.urban },
      { cls: "tr", text: copy.rural },
    ],
  },
];
const communesRoute = path(locale, "communes/");
---

<figure class="atlas" data-view="density" data-base={communesRoute} data-lang={locale}
  data-people={copy.tipPeople} data-density={copy.tipDensity} data-change={copy.tipChange}
  data-illiteracy={copy.tipIlliteracy}
  data-urban={copy.urban} data-rural={copy.rural} data-open={copy.tipOpen}
  data-gap={copy.gapAny} data-gap-03={copy.gap03} data-gap-04={copy.gap04}>
  <div class="frame">
    <svg class="map" viewBox={viewBox} role="img" aria-label={copy.mapAlt.replace("{n}", n.format(shapes))} set:html={markup} />
    <p id="map-keys" hidden>{copy.mapKeys}</p>
    <div class="zoom" role="group" aria-label={copy.mapZoom} hidden>
      <button type="button" data-zoom="in" aria-label={copy.mapZoomIn}>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.5v9M3.5 8h9" /></svg>
      </button>
      <button type="button" data-zoom="out" aria-label={copy.mapZoomOut} aria-disabled="true">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 8h9" /></svg>
      </button>
      <button type="button" data-zoom="reset" aria-label={copy.mapZoomReset} hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3.25 8a4.75 4.75 0 1 0 4.75-4.75 5.15 5.15 0 0 0-3.56 1.44L3.25 5.89" />
          <path d="M3.25 3.25v2.64h2.64" />
        </svg>
      </button>
    </div>
    <div class="tip" hidden></div>
  </div>
  <figcaption>
    <div class="views" role="group" aria-label={copy.mapShade} hidden>
      {views.map((v, i) => (
        <button type="button" data-view={v.id} aria-pressed={i === 0 ? "true" : "false"}>{v.label}</button>
      ))}
    </div>
    {views.map((v, i) => (
      <div class="legend" data-for={v.id} hidden={i !== 0}>
        <ul>
          {v.swatches.map((s) => <li><span class:list={["swatch", s.cls]} />{s.text}</li>)}
          <li><span class="swatch hatched" />{copy.mapNoBoundary}</li>
        </ul>
        {v.unit && <p>{v.unit}</p>}
      </div>
    ))}
    <p class="credit">
      <span>{copy.mapCaption.replace("{n}", n.format(shapes))}</span>
      <a href={communesRoute}>{copy.mapBrowse}</a>
      <span>{copy.mapCredit}</span>
    </p>
  </figcaption>
</figure>

<script>
  import {
    MAX_ZOOM,
    MIN_ZOOM,
    between,
    panBy,
    parseBox,
    pinch,
    toMap,
    toScreen,
    viewBoxOf,
    wheelZoom,
    whole,
    zoomAt,
    type Point,
    type View,
  } from "../lib/zoom";

  type Row = [
    slug: string,
    name: string,
    type: "urban" | "rural",
    people: number,
    density: number | null,
    change: number | null,
    illiteracy: number | null,
  ];

  const atlas = document.querySelector<HTMLElement>(".atlas");
  const frame = atlas?.querySelector<HTMLElement>(".frame");
  const svg = atlas?.querySelector<SVGSVGElement>("svg.map");
  const tip = atlas?.querySelector<HTMLElement>(".tip");
  if (atlas && frame && svg && tip) {
    const d = atlas.dataset;
    const number = new Intl.NumberFormat(d.lang === "fr" ? "fr-FR" : "en-GB", { maximumFractionDigits: 1 });
    const rounded = new Intl.NumberFormat(d.lang === "fr" ? "fr-FR" : "en-GB", { maximumFractionDigits: 0 });
    const tenths = new Intl.NumberFormat(d.lang === "fr" ? "fr-FR" : "en-GB", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    let rows: Record<string, Row> | null = null;
    let loading: Promise<void> | null = null;
    const load = () =>
      (loading ??= fetch("/map/communes.json")
        .then((r) => r.json())
        .then((json) => {
          rows = json;
        })
        .catch(() => undefined));

    // What the map shows, in its own units. Every gesture below works out a new view, and
    // draw() writes it to the viewBox, at most once a frame.
    const box = parseBox(svg.getAttribute("viewBox") ?? "");
    let view: View = whole(box);
    const bounds = () => svg.getBoundingClientRect();

    // The shape under the pointer is drawn again on top, so its outline isn't hidden under
    // its neighbours.
    const focus = document.createElementNS("http://www.w3.org/2000/svg", "path");
    focus.setAttribute("class", "focus");
    svg.append(focus);

    // The tooltip remembers the map point it was opened at, so it moves with the map when
    // the map is zoomed or dragged under it.
    let anchor: Point | null = null;
    let tipWidth = 0;
    let tipHeight = 0;
    const place = (x: number, y: number, frameBox: DOMRect) => {
      const left = Math.min(Math.max(x - frameBox.left + 14, 0), frameBox.width - tipWidth);
      const below = y - frameBox.top + 14;
      const top = below + tipHeight > frameBox.height ? y - frameBox.top - tipHeight - 14 : below;
      tip.style.transform = `translate(${left}px, ${Math.max(top, 0)}px)`;
    };
    const open = (x: number, y: number) => {
      tip.hidden = false;
      tipWidth = tip.offsetWidth;
      tipHeight = tip.offsetHeight;
      const frameBox = bounds();
      anchor = toMap(view, box, frameBox, { x, y });
      place(x, y, frameBox);
    };

    const escape = (s: string) => s.replace(/[&<>"]/g, (ch) => `&#${ch.charCodeAt(0)};`);
    const show = (shape: SVGPathElement, x: number, y: number, pinned: boolean) => {
      focus.setAttribute("d", shape.getAttribute("d") ?? "");
      const row = rows?.[shape.dataset.c ?? ""];
      if (!row) return;
      const [slug, name, type, people, density, change, illiteracy] = row;
      const signed =
        change === null
          ? ""
          : `${change > 0 ? "+" : change < 0 ? "−" : ""}${tenths.format(Math.abs(change))}${d.lang === "fr" ? "\u202f%" : "%"}`;
      tip.innerHTML =
        `<strong>${escape(name)}</strong><span>${type === "urban" ? d.urban : d.rural}</span>` +
        `<span>${number.format(people)} ${d.people}</span>` +
        (density === null ? "" : `<span>${(density >= 100 ? rounded : number).format(density)} ${d.density}</span>`) +
        (signed ? `<span>${signed} ${d.change}</span>` : "") +
        (illiteracy === null ? "" : `<span>${tenths.format(illiteracy)}${d.lang === "fr" ? "\u202f%" : "%"} ${d.illiteracy}</span>`) +
        (pinned ? `<a href="${d.base}${slug}/">${d.open}</a>` : "");
      tip.dataset.slug = slug;
      open(x, y);
    };
    // Land no commune covers says what it is instead of naming a commune.
    const showGap = (shape: SVGPathElement, x: number, y: number) => {
      focus.setAttribute("d", shape.getAttribute("d") ?? "");
      const region = shape.dataset.gap ?? "";
      // data-gap-03 is dataset["gap-03"]: a dash before a digit isn't camel-cased.
      tip.textContent = (d as Record<string, string | undefined>)[`gap-${region}`] ?? d.gap ?? "";
      open(x, y);
    };
    const hide = () => {
      tip.hidden = true;
      focus.setAttribute("d", "");
      anchor = null;
    };

    // Drawing -----------------------------------------------------------------------------

    const hatch = svg.querySelector("pattern");
    const controls = atlas.querySelector<HTMLElement>(".zoom");
    const zoomIn = controls?.querySelector<HTMLButtonElement>('[data-zoom="in"]');
    const zoomOut = controls?.querySelector<HTMLButtonElement>('[data-zoom="out"]');
    const reset = controls?.querySelector<HTMLButtonElement>('[data-zoom="reset"]');
    let drawnK = MIN_ZOOM;
    let pending = 0;
    // Only what changed is written, since this runs every frame of a gesture.
    const mark = (button: HTMLButtonElement | null | undefined, off: boolean) => {
      if (button && button.getAttribute("aria-disabled") !== String(off)) button.setAttribute("aria-disabled", String(off));
    };
    const draw = () => {
      pending = 0;
      const frameBox = bounds();
      svg.setAttribute("viewBox", viewBoxOf(view, box));
      // The hatching is drawn in map units, so it's shrunk by the zoom to keep its spacing
      // on screen. The lines are measured on screen already; see the styles.
      if (view.k !== drawnK) {
        drawnK = view.k;
        hatch?.setAttribute("patternTransform", `rotate(45) scale(${1 / view.k})`);
      }
      const zoomed = view.k > MIN_ZOOM;
      frame.classList.toggle("zoomed", zoomed);
      mark(zoomIn, view.k >= MAX_ZOOM);
      mark(zoomOut, !zoomed);
      if (reset && reset.hidden === zoomed) {
        if (!zoomed && document.activeElement === reset) zoomIn?.focus();
        reset.hidden = !zoomed;
      }
      if (anchor && !tip.hidden) {
        const p = toScreen(view, box, frameBox, anchor);
        const inside = p.x >= frameBox.left && p.x <= frameBox.right && p.y >= frameBox.top && p.y <= frameBox.bottom;
        if (inside) place(p.x, p.y, frameBox);
        else hide();
      }
    };
    const go = (next: View) => {
      if (![next.k, next.x, next.y].every(Number.isFinite)) return;
      view = next;
      pending ||= requestAnimationFrame(draw);
    };

    // A button, key or double-click eases to its view in 240ms. Pinches, drags and the wheel
    // move the map at once.
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    let aim: View | null = null;
    let flight = 0;
    const land = () => {
      cancelAnimationFrame(flight);
      flight = 0;
      aim = null;
    };
    const glide = (target: View) => {
      land();
      if (still.matches) return go(target);
      const from = view;
      const start = performance.now();
      aim = target;
      const step = (now: number) => {
        const t = Math.min((now - start) / 240, 1);
        view = between(from, target, box, 1 - (1 - t) ** 3);
        cancelAnimationFrame(pending);
        draw();
        if (t < 1) flight = requestAnimationFrame(step);
        else land();
      };
      flight = requestAnimationFrame(step);
    };
    const middle = (): Point => {
      const b = bounds();
      return { x: b.left + b.width / 2, y: b.top + b.height / 2 };
    };
    const zoomBy = (factor: number, p = middle()) => {
      const base = aim ?? view;
      glide(zoomAt(base, box, bounds(), p, base.k * factor));
    };
    // A pinch that ends a hair past 1x goes back to the whole map, since at any zoom above
    // 1x a finger on the map drags it instead of scrolling the page.
    const settle = () => {
      if (view.k > MIN_ZOOM && view.k < 1.05) glide(whole(box));
    };

    // Pointers ----------------------------------------------------------------------------

    // Fingers, the mouse and pens on the map, where each is now.
    const down = new Map<number, Point>();
    // One pointer drags. Two pinch, from the view and positions they started with.
    let drag: { id: number; from: Point; start: View; moved: boolean } | null = null;
    let pair: { ids: [number, number]; from: [Point, Point]; start: View } | null = null;
    // Set once a press moves past a tap or a second finger lands; its click is dropped.
    let dragged = false;
    let lastType = "mouse";
    const slop = (type: string) => (type === "mouse" ? 4 : 8);

    // Whenever a pointer comes or goes, the gesture starts again from where things are, so
    // lifting one finger of a pinch carries on as a drag without a jump.
    const regrip = () => {
      const held = [...down.entries()];
      drag = null;
      pair = null;
      if (held.length >= 2) {
        const [a, b] = held as [[number, Point], [number, Point]];
        pair = { ids: [a[0], b[0]], from: [{ ...a[1] }, { ...b[1] }], start: view };
      } else if (held.length === 1) {
        const [id, p] = held[0]!;
        drag = { id, from: { ...p }, start: view, moved: dragged };
      }
    };

    svg.addEventListener("pointerdown", (event) => {
      lastType = event.pointerType;
      if (event.pointerType === "mouse" && event.button !== 0) return;
      // A mouse released outside the page leaves no pointerup behind.
      if (event.pointerType === "mouse") down.clear();
      if (down.size === 0) dragged = false;
      land();
      down.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (down.size >= 2) dragged = true;
      if (down.size <= 2) regrip();
    });

    svg.addEventListener("pointermove", (event) => {
      const p = down.get(event.pointerId);
      if (!p) return;
      p.x = event.clientX;
      p.y = event.clientY;
      if (pair) {
        const a = down.get(pair.ids[0]);
        const b = down.get(pair.ids[1]);
        if (a && b) go(pinch(pair.start, box, bounds(), pair.from, [a, b]));
      } else if (drag && drag.id === event.pointerId) {
        const dx = p.x - drag.from.x;
        const dy = p.y - drag.from.y;
        if (!drag.moved && Math.hypot(dx, dy) > slop(event.pointerType)) {
          drag.moved = true;
          dragged = true;
          if (event.pointerType === "mouse") {
            svg.setPointerCapture(event.pointerId);
            frame.classList.toggle("dragging", view.k > MIN_ZOOM);
          }
        }
        if (drag.moved) go(panBy(drag.start, box, bounds(), dx, dy));
      }
    });

    const lift = (event: PointerEvent) => {
      if (!down.delete(event.pointerId)) return;
      regrip();
      if (down.size === 0) {
        frame.classList.remove("dragging");
        settle();
      }
    };
    // On the window, since a mouse can be let go of anywhere once it's left the map.
    window.addEventListener("pointerup", lift);
    window.addEventListener("pointercancel", lift);

    // At 1x a finger scrolls the page, so the map only asks the browser to keep off 2
    // fingers, which would otherwise scroll it or zoom the page. Zoomed in, touch-action in
    // the styles hands every touch to the map.
    const twoFingers = (event: TouchEvent) => {
      if (event.touches.length > 1) event.preventDefault();
    };
    svg.addEventListener("touchstart", twoFingers, { passive: false });
    svg.addEventListener("touchmove", twoFingers, { passive: false });

    // Ctrl or ⌘ with the wheel, and a trackpad pinch, which arrives as the same. A wheel on
    // its own scrolls the page.
    let wheelEnd = 0;
    svg.addEventListener(
      "wheel",
      (event) => {
        if (!event.ctrlKey && !event.metaKey) return;
        event.preventDefault();
        land();
        go(zoomAt(view, box, bounds(), { x: event.clientX, y: event.clientY }, view.k * wheelZoom(event.deltaY, event.deltaMode)));
        clearTimeout(wheelEnd);
        wheelEnd = window.setTimeout(settle, 200);
      },
      { passive: false },
    );

    // Safari sends a trackpad pinch as gesture events instead. On a phone it sends them for
    // a pinch too, which the pointers above already follow.
    type Gesture = Event & { scale: number; clientX: number; clientY: number };
    let gestureStart: View | null = null;
    svg.addEventListener("gesturestart", (event) => {
      event.preventDefault();
      gestureStart = down.size === 0 ? view : null;
    });
    svg.addEventListener("gesturechange", (event) => {
      event.preventDefault();
      const g = event as Gesture;
      if (!gestureStart || down.size > 0 || !Number.isFinite(g.scale)) return;
      go(zoomAt(gestureStart, box, bounds(), { x: g.clientX, y: g.clientY }, gestureStart.k * g.scale));
    });
    svg.addEventListener("gestureend", (event) => {
      event.preventDefault();
      if (gestureStart) settle();
      gestureStart = null;
    });

    // Tooltip and clicks ------------------------------------------------------------------

    svg.addEventListener("pointerenter", () => void load());
    svg.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse" || drag?.moved) return;
      const target = event.target as Element;
      const shape = target.closest<SVGPathElement>("path[data-c]");
      const gap = target.closest<SVGPathElement>("path[data-gap]");
      if (shape) show(shape, event.clientX, event.clientY, false);
      else if (gap) showGap(gap, event.clientX, event.clientY);
      else hide();
    });
    svg.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") hide();
    });
    // A mouse click opens the commune. A tap shows it first, with a link, since there's no
    // hover to read it by. The page opens a moment after the click, in case it's the first
    // of a double-click, which zooms in instead.
    let clicks = 0;
    svg.addEventListener("click", async (event) => {
      if (dragged) return;
      const mouse = ((event as PointerEvent).pointerType || lastType) === "mouse";
      const ticket = ++clicks;
      if (mouse && event.detail > 1) return;
      const gap = (event.target as Element).closest<SVGPathElement>("path[data-gap]");
      if (gap) return showGap(gap, event.clientX, event.clientY);
      const shape = (event.target as Element).closest<SVGPathElement>("path[data-c]");
      if (!shape) return hide();
      await load();
      const row = rows?.[shape.dataset.c ?? ""];
      if (!row) return;
      if (!mouse) return show(shape, event.clientX, event.clientY, true);
      window.setTimeout(() => {
        if (ticket === clicks) window.location.href = `${d.base}${row[0]}/`;
      }, 300);
    });
    svg.addEventListener("dblclick", (event) => {
      event.preventDefault();
      clicks++;
      if (!dragged) zoomBy(2, { x: event.clientX, y: event.clientY });
    });

    // Buttons and keys --------------------------------------------------------------------

    // The map takes focus for the keys only once there's a script to answer them.
    svg.tabIndex = 0;
    svg.setAttribute("aria-describedby", "map-keys");
    if (controls && zoomIn && zoomOut && reset) {
      controls.hidden = false;
      const press = (button: HTMLButtonElement, act: () => void) =>
        button.addEventListener("click", () => {
          if (button.getAttribute("aria-disabled") !== "true") act();
        });
      press(zoomIn, () => zoomBy(2));
      press(zoomOut, () => zoomBy(0.5));
      press(reset, () => glide(whole(box)));
    }
    svg.addEventListener("keydown", (event) => {
      if (event.ctrlKey || event.metaKey || event.altKey) return;
      const base = aim ?? view;
      const step = bounds().width / 8;
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [step, 0],
        ArrowRight: [-step, 0],
        ArrowUp: [0, step],
        ArrowDown: [0, -step],
      };
      const move = moves[event.key];
      if (event.key === "+" || event.key === "=") zoomBy(2);
      else if (event.key === "-" || event.key === "_") zoomBy(0.5);
      // At 1x there's nowhere to move, so the arrows scroll the page as usual.
      else if (move && base.k > MIN_ZOOM) glide(panBy(base, box, bounds(), ...move));
      else return;
      event.preventDefault();
    });

    const views = atlas.querySelector<HTMLElement>(".views");
    if (views) views.hidden = false;
    for (const button of atlas.querySelectorAll<HTMLButtonElement>(".views button")) {
      button.addEventListener("click", () => {
        const view = button.dataset.view!;
        atlas.dataset.view = view;
        for (const b of atlas.querySelectorAll(".views button")) b.setAttribute("aria-pressed", String(b === button));
        for (const legend of atlas.querySelectorAll<HTMLElement>(".legend")) legend.hidden = legend.dataset.for !== view;
      });
    }
  }
</script>

<style>
  .atlas {
    margin: 0;
  }

  .frame {
    position: relative;
  }

  .map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    /* At 1x a finger scrolls the page past the map; 2 fingers are the map's. */
    touch-action: pan-x pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Chrome rings any focused SVG, even one a finger or the mouse focused. The keyboard
     still gets the page's ring. */
  .map:focus:not(:focus-visible) {
    outline: none;
  }

  /* Zoomed in, the map keeps to its frame and takes every touch, so a finger drags it. */
  .frame.zoomed .map {
    overflow: hidden;
    touch-action: none;
  }

  .frame.dragging .map,
  .frame.dragging .map :global(path) {
    cursor: grabbing;
  }

  /* Every commune is filled by the class it falls in for the view shown, and separated from
     its neighbours by a hairline of the page. */
  .map :global(.communes path) {
    fill: var(--map-none);
    fill-rule: evenodd;
    stroke: var(--paper);
    stroke-width: 0.35;
    stroke-linejoin: round;
    cursor: pointer;
  }

  .map :global(.gap) {
    fill: url(#gap-hatch);
    stroke: var(--quiet);
    stroke-width: 0.5;
    cursor: help;
  }

  .map :global(.hatch) {
    stroke: var(--quiet);
    stroke-width: 1.2;
  }

  .map :global(.regions) {
    fill: none;
    stroke: var(--paper);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .map :global(.focus) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* Zoomed in, lines in map units would thicken with the map, so they're measured on the
     screen instead, as a share of the frame's width. The map is 1000 units across (WIDTH in
     site/scripts/map.ts), so 0.035cqw is 0.35 units at 1x, and the map at 1x is drawn the
     same either way. Nothing is restyled while the map zooms, where changing the widths
     with the zoom would restyle every commune each frame. Without container units, lines
     stay in map units. */
