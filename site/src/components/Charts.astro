---
import { change, half, shrinking, since, sizes, spread } from "../generated/charts";
import { REPO_URL, t, type Locale } from "../i18n/ui";
import { escapeHtml } from "../lib/highlight";
import { percent as formatPercent } from "../lib/format";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
// French groups thousands with a thin space, English with a comma.
const group = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-GB");

/* Chart 1: percent change per région, diverging from a zero axis. The axis sits where
   the data puts it — one région shrank, and barely, so the gutter left of zero is thin. */
const mostNegative = Math.min(0, ...change.map((r) => r.pct));
const mostPositive = Math.max(0, ...change.map((r) => r.pct));
const span = mostPositive - mostNegative;
const zero = (-mostNegative / span) * 100;
const widthOf = (pct: number) => (Math.abs(pct) / span) * 100;

/* Chart 2: the size histogram. */
const maxCount = Math.max(...sizes.map((b) => b.count));

/* Charts 4 and 5: shares of a whole, as 100% bars with the part that matters filled. */
const fillIn = (text: string, values: Record<string, string | number>) =>
  text.replace(/\{(\w+)\}/g, (_, k: string) => String(values[k] ?? ""));
// Shares to one decimal, kept even when it's 0, and to 2 under 1%, so 0.45% doesn't round to a half.
const percent = (v: number) => formatPercent(locale, v, { digits: Math.abs(v) < 1 ? 2 : 1, fixed: true });
const shrinkMax = Math.max(...shrinking.map((s) => s.shrank + s.grew));

/* Chart 6: what the two censuses found, each rate a point in 2014 and a point in 2024,
   on one 0-to-100 scale so the five sit against each other. */
const sinceLabels = copy.sinceLabels as Record<string, string>;
const sinceRows = since.map((row) => ({
  ...row,
  label: sinceLabels[row.key] ?? row.key,
  from: Math.min(row.before, row.after),
  to: Math.max(row.before, row.after),
}));

/* Chart 3: the two growth distributions, on one shared scale. */
const lo = Math.min(...spread.map((s) => s.p10));
const hi = Math.max(...spread.map((s) => s.p90));
const pad = (hi - lo) * 0.08;
const scale = (v: number) => ((v - (lo - pad)) / (hi - lo + pad * 2)) * 100;
const ticks = [-20, -10, 0, 10, 20];
const signed = (v: number) => formatPercent(locale, v, { signed: true, fixed: true });
const spoken = (row: (typeof spread)[number]) =>
  copy.srSpread.replace(/\{(\w+)\}/g, (_, key: string) =>
    signed((row as unknown as Record<string, number>)[key] ?? 0),
  );
---

<div class="charts">
  <figure class="chart">
    <figcaption>
      <h3>{copy.chartChange}</h3>
      <p>{copy.chartChangeBody}</p>
    </figcaption>
    <ul class="diverge">
      {change.map((region) => (
        <li>
          <span class="rname">{region.name}</span>
          <span class="track" aria-hidden="true">
            <span class="axis" style={`inset-inline-start:${zero}%`}></span>
            <span
              class:list={["bar", region.pct >= 0 ? "up" : "down"]}
              style={
                region.pct >= 0
                  ? `inset-inline-start:${zero}%;width:${widthOf(region.pct)}%`
                  : `inset-inline-start:${zero - widthOf(region.pct)}%;width:${widthOf(region.pct)}%`
              }
            ></span>
          </span>
          <span class="rval">{signed(region.pct)}</span>
        </li>
      ))}
    </ul>
    <p class="note">{copy.chartChangeNote}</p>
  </figure>

  <figure class="chart">
    <figcaption>
      <h3>{copy.chartSize}</h3>
      <p>{copy.chartSizeBody}</p>
    </figcaption>
    <ul class="histogram">
      {sizes.map((bucket) => (
        <li>
          <span class="sr-only">{bucket.label}: {group.format(bucket.count)}</span>
          <span class="hwell" aria-hidden="true">
            <span class="hcount">{group.format(bucket.count)}</span>
            <span class="hbar" style={`height:${(bucket.count / maxCount) * 100}%`}></span>
          </span>
          <span class="hlabel" aria-hidden="true">{bucket.label}</span>
        </li>
      ))}
    </ul>
  </figure>

  <figure class="chart">
    <figcaption>
      <h3>{copy.chartHalf}</h3>
      <p>{fillIn(copy.chartHalfBody, { n: half.communes, rest: group.format(half.total - half.communes) })}</p>
    </figcaption>
    <dl class="shares">
      {[
        { label: copy.halfPeople, share: half.peopleShare },
        { label: copy.halfLand, share: half.landShare },
      ].map((row) => (
        <div>
          <dt>{row.label}</dt>
          <dd>
            <span class="share-track" aria-hidden="true">
              <span class="share-fill" style={`width:max(${row.share}%, 3px)`}></span>
            </span>
            <span class="share-value">{percent(row.share)}</span>
          </dd>
        </div>
      ))}
    </dl>
  </figure>

  <figure class="chart">
    <figcaption>
      <h3>{copy.chartShrank}</h3>
      <p>{fillIn(copy.chartShrankBody, { urban: signed(shrinking.find((s) => s.type === "urban")!.pct), rural: signed(shrinking.find((s) => s.type === "rural")!.pct) })}</p>
    </figcaption>
    <dl class="shares">
      {shrinking.map((row) => (
        <div>
          <dt>{row.type === "urban" ? copy.shrankUrban : copy.shrankRural}</dt>
          <dd>
            <span class="stack" style={`width:${((row.shrank + row.grew) / shrinkMax) * 100}%`} aria-hidden="true">
              <span class="lost" style={`flex:${row.shrank}`}>{group.format(row.shrank)}</span>
              <span class="gained" style={`flex:${row.grew}`}>{group.format(row.grew)}</span>
            </span>
            <span class="sr-only">{fillIn(copy.srShrank, { lost: row.shrank, gained: row.grew })}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="legend-row">
      <span><span class="key lost"></span>{copy.shrankLost}</span>
      <span><span class="key gained"></span>{copy.shrankGained}</span>
    </p>
  </figure>

  <figure class="chart wide">
    <figcaption>
      <h3>{copy.chartSince}</h3>
      <p>{copy.chartSinceBody}</p>
    </figcaption>
    <ul class="dumbbell">
      {sinceRows.map((row) => (
        <li>
          <span class="rname">{row.label}</span>
          <span class="track" aria-hidden="true">
            <span class="link" style={`inset-inline-start:${row.from}%;width:${row.to - row.from}%`}></span>
            <span class:list={["dot", "then"]} style={`inset-inline-start:${row.before}%`}></span>
            <span class:list={["dot", "now"]} style={`inset-inline-start:${row.after}%`}></span>
          </span>
          <span class="dval">
            <span class="was">{percent(row.before)}</span>
            <span aria-hidden="true">→</span>
            <span>{percent(row.after)}</span>
          </span>
          <span class="sr-only">{fillIn(copy.srSince, { label: row.label, before: percent(row.before), after: percent(row.after) })}</span>
        </li>
      ))}
    </ul>
    <p class="legend-row">
      <span><span class="key then"></span>2014</span>
      <span><span class="key now"></span>2024</span>
    </p>
  </figure>

  <figure class="chart wide">
    <figcaption>
      <h3>{copy.chartSpread}</h3>
      <p>{copy.chartSpreadBody}</p>
    </figcaption>
    <div class="rangegrid">
      {spread.map((row) => (
        <>
          <span class="rangename">
            {row.basis === "exact_code" ? copy.spreadUnchanged : copy.spreadCrosswalk}
            <span class="n">{group.format(row.count)}</span>
            <span class="sr-only">: {spoken(row)}</span>
          </span>
          <span class="rangetrack" aria-hidden="true">
            {ticks.map((tick) => (
              <span class:list={["tick", { zeroline: tick === 0 }]} style={`inset-inline-start:${scale(tick)}%`}></span>
            ))}
            <span
              class="whisker"
              style={`inset-inline-start:${scale(row.p10)}%;width:${scale(row.p90) - scale(row.p10)}%`}
            ></span>
            <span
              class="box"
              style={`inset-inline-start:${scale(row.p25)}%;width:${scale(row.p75) - scale(row.p25)}%`}
            ></span>
            <span class="median" style={`inset-inline-start:${scale(row.median)}%`}></span>
          </span>
        </>
      ))}
      <span class="spacer" aria-hidden="true"></span>
      <span class="scalebar" aria-hidden="true">
        {ticks.map((tick) => (
          <span style={`inset-inline-start:${scale(tick)}%`} class="tick-label">{formatPercent(locale, tick, { signed: true, digits: 0 })}</span>
        ))}
      </span>
    </div>
    <p
      class="note"
      set:html={escapeHtml(copy.chartSpreadNote).replace(
        "{crosswalk}",
        `<a href="${REPO_URL}/blob/main/data/v1/crosswalk/README.md">${escapeHtml(copy.linkCrosswalk)}</a>`,
      )}
    />
  </figure>
</div>

<style>
  .charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.75rem 3rem;
    margin-top: 1.75rem;
  }

  .chart.wide {
    grid-column: 1 / -1;
  }

  /* On the page ground, not a panel: the map is the one dark field, and four identical
     panels read as a card grid. A rule on top separates each chart instead. */
  .chart {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .chart figcaption {
    display: block;
  }

  .chart h3 {
    margin: 0 0 0.3rem;
    font-family: var(--display);
    font-size: var(--t-md);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .chart figcaption p {
    margin: 0;
    color: var(--quiet);
    font-size: var(--t-sm);
    max-width: 52ch;
  }

  .chart .note {
    margin: 0;
    color: var(--quiet);
    font-size: var(--t-xs);
    max-width: 62ch;
  }

  /* Shares of a whole ------------------------------------------------------- */

  .shares {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .shares dt {
    font-size: var(--t-xs);
    color: var(--quiet);
    margin-bottom: 0.3rem;
  }

  .shares dd {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .share-track {
    position: relative;
    flex: 1;
    height: 1.1rem;
    border-radius: 3px;
    background: var(--rule);
    overflow: hidden;
  }

  .share-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    background: var(--chart-up);
  }

  .share-value {
    min-width: 4rem;
    text-align: end;
    font-size: var(--t-md);
    font-variant-numeric: tabular-nums;
  }

  /* Two segments separated by a gap of the page, each labelled with its count. */
  .stack {
    display: flex;
    gap: 2px;
    height: 1.6rem;
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
  }

  .stack span {
    display: flex;
    align-items: center;
    padding-inline: 0.45rem;
    color: var(--paper);
    white-space: nowrap;
    overflow: hidden;
  }

  /* The deepest classes of the map's ramps, dark enough to carry text in the page's colour. */
  .stack .lost {
    background: var(--div-0);
    border-radius: 3px 0 0 3px;
  }

  .stack .gained {
    background: var(--seq-4);
    border-radius: 0 3px 3px 0;
  }

  .legend-row {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    font-size: var(--t-xs);
    color: var(--ink);
  }

  .legend-row > span {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .legend-row .key {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 2px;
  }

  .key.lost {
    background: var(--div-0);
  }

  .key.gained {
    background: var(--seq-4);
  }

  /* A rate in 2014 and the same rate in 2024, joined ------------------------- */

  .dumbbell {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .dumbbell li {
    display: grid;
    grid-template-columns: minmax(6rem, 11.75rem) minmax(0, 1fr) 7.5rem;
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.3rem;
  }

  .dumbbell .track {
    height: 0.7rem;
  }

  .link {
    position: absolute;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: var(--rule);
  }

  .dot {
    position: absolute;
    top: 50%;
    width: 0.62rem;
    height: 0.62rem;
    margin-inline-start: -0.31rem;
    border-radius: 50%;
    transform: translateY(-50%);
  }

  /* The older figure in grey, the newer in the chart's green: two filled dots, so neither
     reads as an outline of the other. */
  .dot.then,
  .key.then {
    background: var(--quiet);
  }

  /* The legend's marks are the chart's marks: round here, square where the chart's are. */
  .key.then,
  .key.now {
    border-radius: 50%;
  }

  /* On a phone the name and the two figures take the width the track needs, so the track
     goes under them and keeps its length. */
  @media (max-width: 40rem) {
    .dumbbell li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.3rem 0.75rem;
    }

    .dumbbell .rname {
      grid-column: 1;
      grid-row: 1;
    }

    .dumbbell .dval {
      grid-column: 2;
      grid-row: 1;
    }

    .dumbbell .track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /* One colour for 2024 whichever way the rate moved: a fall in illiteracy and a rise in
     running water are both the figure moving, and the line already shows which way. */
  .dot.now,
  .key.now {
    background: var(--chart-up);
  }

  .dval {
    display: flex;
    gap: 0.3rem;
    justify-content: flex-end;
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .dval .was,
  .dval [aria-hidden] {
    color: var(--quiet);
  }

  /* Diverging bars ---------------------------------------------------------- */

  .diverge,
  .histogram {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .diverge li {
    display: grid;
    grid-template-columns: minmax(6rem, 11.75rem) minmax(0, 1fr) 4rem;
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.22rem;
  }

  /* A long name wraps rather than being cut, which on a phone is most of them. */
  .rname {
    font-size: var(--t-xs);
    color: var(--ink);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .track {
    position: relative;
    display: block;
    height: 0.85rem;
  }

  .axis {
    position: absolute;
    top: -0.1rem;
    bottom: -0.1rem;
    width: 1px;
    background: var(--rule);
  }

  .bar {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 2px;
  }

  /* Rounded at the data end, flat where the bar leaves the zero axis. */
  .bar.up {
    background: var(--chart-up);
    border-start-end-radius: 4px;
    border-end-end-radius: 4px;
  }

  .bar.down {
    background: var(--chart-down);
    border-start-start-radius: 4px;
    border-end-start-radius: 4px;
  }

  .rval {
    font-size: var(--t-xs);
    text-align: end;
    color: var(--quiet);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Histogram --------------------------------------------------------------- */

  .histogram {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 0.5rem;
    align-items: end;
    flex: 1 1 auto;
    min-height: 12rem;
  }

  .histogram li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    text-align: center;
  }

  /* The bars are sized against this well, and the count above the tallest one spills into
     its top padding, so it never reaches the caption. */
  .hwell {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    padding-top: 1.6rem;
  }

  .hcount {
    font-size: var(--t-xs);
    color: var(--quiet);
    font-variant-numeric: tabular-nums;
  }

  .hbar {
    display: block;
    flex: 0 0 auto;
    background: var(--chart-up);
    border-radius: 4px 4px 0 0;
    min-height: 2px;
  }

  .hlabel {
    font-size: var(--t-xs);
    color: var(--quiet);
    white-space: nowrap;
  }

  /* Box and whisker --------------------------------------------------------- */

  .rangegrid {
    display: grid;
    grid-template-columns: minmax(9rem, 17rem) minmax(0, 1fr);
    gap: 0.6rem 1rem;
    align-items: center;
  }

  .rangename {
    font-size: var(--t-sm);
    color: var(--ink);
    line-height: 1.4;
  }

  .rangename .n {
    font-size: var(--t-xs);
    color: var(--quiet);
    margin-inline-start: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .rangetrack {
    position: relative;
    display: block;
    height: 1.5rem;
  }

  .tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }

  .tick.zeroline {
    background: var(--quiet);
  }

  .whisker {
    position: absolute;
    top: 50%;
    height: 1px;
    background: var(--chart-up);
    transform: translateY(-50%);
  }

  .box {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    background: var(--chart-up);
    opacity: 0.28;
    border-radius: 3px;
  }

  /* Reads against the box it sits inside, which the accent colour would not. */
  .median {
    position: absolute;
    top: 0.1rem;
    bottom: 0.1rem;
    width: 2px;
    background: var(--ink);
  }

  .scalebar {
    position: relative;
    display: block;
    height: 1rem;
  }

  .scalebar span {
    position: absolute;
    transform: translateX(-50%);
    font-size: var(--t-xs);
    color: var(--quiet);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 62rem) {
    .charts {
      grid-template-columns: minmax(0, 1fr);
    }

    .rangegrid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }

    .spacer {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .diverge li {
      grid-template-columns: minmax(4.5rem, 7rem) minmax(0, 1fr) 3.4rem;
      gap: 0.5rem;
    }

    .hlabel {
      font-size: 0.75rem;
    }
  }
</style>
