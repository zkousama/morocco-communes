---
import { change, sizes, spread } from "../generated/charts";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
// French groups thousands with a thin space, English with a comma.
const group = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-GB");

/* Chart 1: percent change per région, diverging from a zero axis. The axis sits where
   the data puts it — one région shrank, and barely, so the gutter left of zero is thin. */
const mostNegative = Math.min(0, ...change.map((r) => r.pct));
const mostPositive = Math.max(0, ...change.map((r) => r.pct));
const span = mostPositive - mostNegative;
const zero = (-mostNegative / span) * 100;
const widthOf = (pct: number) => (Math.abs(pct) / span) * 100;

/* Chart 2: the size histogram. */
const maxCount = Math.max(...sizes.map((b) => b.count));

/* Chart 3: the two growth distributions, on one shared scale. */
const lo = Math.min(...spread.map((s) => s.p10));
const hi = Math.max(...spread.map((s) => s.p90));
const pad = (hi - lo) * 0.08;
const scale = (v: number) => ((v - (lo - pad)) / (hi - lo + pad * 2)) * 100;
const ticks = [-20, -10, 0, 10, 20];
const signed = (v: number) => `${v > 0 ? "+" : v < 0 ? "−" : ""}${Math.abs(v).toFixed(1)}%`;
const spoken = (row: (typeof spread)[number]) =>
  copy.srSpread.replace(/\{(\w+)\}/g, (_, key: string) =>
    signed((row as unknown as Record<string, number>)[key] ?? 0),
  );
---

<div class="charts">
  <figure class="chart">
    <figcaption>
      <h3>{copy.chartChange}</h3>
      <p>{copy.chartChangeBody}</p>
    </figcaption>
    <ul class="diverge">
      {change.map((region) => (
        <li>
          <span class="rname">{region.name}</span>
          <span class="track" aria-hidden="true">
            <span class="axis" style={`inset-inline-start:${zero}%`}></span>
            <span
              class:list={["bar", region.pct >= 0 ? "up" : "down"]}
              style={
                region.pct >= 0
                  ? `inset-inline-start:${zero}%;width:${widthOf(region.pct)}%`
                  : `inset-inline-start:${zero - widthOf(region.pct)}%;width:${widthOf(region.pct)}%`
              }
            ></span>
          </span>
          <span class="rval">{region.pct >= 0 ? "+" : "−"}{Math.abs(region.pct).toFixed(1)}%</span>
        </li>
      ))}
    </ul>
    <p class="note">{copy.chartChangeNote}</p>
  </figure>

  <figure class="chart">
    <figcaption>
      <h3>{copy.chartSize}</h3>
      <p>{copy.chartSizeBody}</p>
    </figcaption>
    <ul class="histogram">
      {sizes.map((bucket) => (
        <li>
          <span class="sr-only">{bucket.label}: {group.format(bucket.count)}</span>
          <span class="hcount" aria-hidden="true">{group.format(bucket.count)}</span>
          <span class="hbar" style={`height:${(bucket.count / maxCount) * 100}%`} aria-hidden="true"></span>
          <span class="hlabel" aria-hidden="true">{bucket.label}</span>
        </li>
      ))}
    </ul>
  </figure>

  <figure class="chart wide">
    <figcaption>
      <h3>{copy.chartSpread}</h3>
      <p>{copy.chartSpreadBody}</p>
    </figcaption>
    <div class="rangegrid">
      {spread.map((row) => (
        <>
          <span class="rangename">
            {row.basis === "exact_code" ? copy.spreadUnchanged : copy.spreadCrosswalk}
            <span class="n">{group.format(row.count)}</span>
            <span class="sr-only">: {spoken(row)}</span>
          </span>
          <span class="rangetrack" aria-hidden="true">
            {ticks.map((tick) => (
              <span class:list={["tick", { zeroline: tick === 0 }]} style={`inset-inline-start:${scale(tick)}%`}></span>
            ))}
            <span
              class="whisker"
              style={`inset-inline-start:${scale(row.p10)}%;width:${scale(row.p90) - scale(row.p10)}%`}
            ></span>
            <span
              class="box"
              style={`inset-inline-start:${scale(row.p25)}%;width:${scale(row.p75) - scale(row.p25)}%`}
            ></span>
            <span class="median" style={`inset-inline-start:${scale(row.median)}%`}></span>
          </span>
        </>
      ))}
      <span class="spacer" aria-hidden="true"></span>
      <span class="scalebar" aria-hidden="true">
        {ticks.map((tick) => (
          <span style={`inset-inline-start:${scale(tick)}%`} class="tick-label">{tick > 0 ? `+${tick}` : tick}%</span>
        ))}
      </span>
    </div>
    <p class="note">{copy.chartSpreadNote}</p>
  </figure>
</div>

<style>
  .charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.75rem 3rem;
    margin-top: 1.75rem;
  }

  .chart.wide {
    grid-column: 1 / -1;
  }

  /* On the page ground, not a panel: the map is the one dark field, and four identical
     panels read as a card grid. A rule on top separates each chart instead. */
  .chart {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .chart figcaption {
    display: block;
  }

  .chart h3 {
    margin: 0 0 0.3rem;
    font-family: var(--display);
    font-size: var(--t-md);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .chart figcaption p {
    margin: 0;
    color: var(--quiet);
    font-size: var(--t-sm);
    max-width: 52ch;
  }

  .chart .note {
    margin: 0;
    color: var(--quiet);
    font-size: var(--t-xs);
    max-width: 62ch;
  }

  /* Diverging bars ---------------------------------------------------------- */

  .diverge,
  .histogram {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .diverge li {
    display: grid;
    grid-template-columns: minmax(6rem, 11.75rem) minmax(0, 1fr) 4rem;
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.22rem;
  }

  .rname {
    font-size: var(--t-xs);
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track {
    position: relative;
    display: block;
    height: 0.85rem;
  }

  .axis {
    position: absolute;
    top: -0.1rem;
    bottom: -0.1rem;
    width: 1px;
    background: var(--rule);
  }

  .bar {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 2px;
  }

  /* Rounded at the data end, flat where the bar leaves the zero axis. */
  .bar.up {
    background: var(--chart-up);
    border-start-end-radius: 4px;
    border-end-end-radius: 4px;
  }

  .bar.down {
    background: var(--chart-down);
    border-start-start-radius: 4px;
    border-end-start-radius: 4px;
  }

  .rval {
    font-size: var(--t-xs);
    text-align: end;
    color: var(--quiet);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Histogram --------------------------------------------------------------- */

  .histogram {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 0.5rem;
    align-items: end;
    flex: 1 1 auto;
    min-height: 12rem;
  }

  .histogram li {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    height: 100%;
    text-align: center;
  }

  .hcount {
    font-size: var(--t-xs);
    color: var(--quiet);
    font-variant-numeric: tabular-nums;
  }

  .hbar {
    display: block;
    flex: 0 0 auto;
    background: var(--chart-up);
    border-radius: 4px 4px 0 0;
    min-height: 2px;
  }

  .hlabel {
    font-size: var(--t-xs);
    color: var(--quiet);
    white-space: nowrap;
  }

  /* Box and whisker --------------------------------------------------------- */

  .rangegrid {
    display: grid;
    grid-template-columns: minmax(9rem, 17rem) minmax(0, 1fr);
    gap: 0.6rem 1rem;
    align-items: center;
  }

  .rangename {
    font-size: var(--t-sm);
    color: var(--ink);
    line-height: 1.4;
  }

  .rangename .n {
    font-size: var(--t-xs);
    color: var(--quiet);
    margin-inline-start: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .rangetrack {
    position: relative;
    display: block;
    height: 1.5rem;
  }

  .tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }

  .tick.zeroline {
    background: var(--quiet);
  }

  .whisker {
    position: absolute;
    top: 50%;
    height: 1px;
    background: var(--chart-up);
    transform: translateY(-50%);
  }

  .box {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    background: var(--chart-up);
    opacity: 0.28;
    border-radius: 3px;
  }

  /* Reads against the box it sits inside, which the accent colour would not. */
  .median {
    position: absolute;
    top: 0.1rem;
    bottom: 0.1rem;
    width: 2px;
    background: var(--ink);
  }

  .scalebar {
    position: relative;
    display: block;
    height: 1rem;
  }

  .scalebar span {
    position: absolute;
    transform: translateX(-50%);
    font-size: var(--t-xs);
    color: var(--quiet);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 62rem) {
    .charts {
      grid-template-columns: minmax(0, 1fr);
    }

    .rangegrid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }

    .spacer {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .diverge li {
      grid-template-columns: minmax(4.5rem, 7rem) minmax(0, 1fr) 3.4rem;
      gap: 0.5rem;
    }

    .hlabel {
      font-size: 0.75rem;
    }
  }
</style>
