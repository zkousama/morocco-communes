---
/**
 * The figures that stand out across Morocco, one commune each, worked out in
 * lib/insights.ts: one grid of cards in topic order, each topic's first card carrying its
 * anchor. Then the figures few communes reach, whose long lists sit in folds open in the
 * markup that shut as the page is read.
 */
import Base from "../layouts/Base.astro";
import RareLists from "./RareLists.astro";
import Standout from "./Standout.astro";
import { places } from "../i18n/places";
import { path, t, type Locale } from "../i18n/ui";
import { insightsOf, standouts } from "../lib/insights";
import { pageOf } from "../lib/places";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const how = places[locale].insightsMore;
const groups = standouts(insightsOf.values(), pageOf);
const topicName = (topic: string) => (copy.insightTopics as Record<string, string>)[topic] ?? topic;
---

<Base locale={locale} route="insights/" title={copy.insightsTitle} description={copy.insightsLede}>
  <article class="insights">
    <h1>{copy.insightsTitle}</h1>
    <p class="lede">
      {copy.insightsLede} <a href={path(locale, "docs/insights/")}>{how}</a>
    </p>
    {groups.length > 0 && (
      <nav class="topics" aria-label={copy.insightsTopics}>
        <ul>
          {groups.map((group) => (
            <li><a href={`#${group.topic}`}>{topicName(group.topic)}</a></li>
          ))}
          <li><a href="#rare">{copy.rareTitle}</a></li>
        </ul>
      </nav>
    )}
    <div class="grid">
      {groups.flatMap((group) =>
        group.rows.map((row, i) => (
          <Standout locale={locale} row={row} topic={topicName(group.topic)} id={i === 0 ? group.topic : undefined} />
        )),
      )}
    </div>
    <section id="rare">
      <h2>{copy.rareTitle}</h2>
      <p class="section-body">{copy.rareBody}</p>
      <RareLists locale={locale} />
    </section>
    <script is:inline>
      // Open in the markup, so the rest of a list shows without JavaScript. With it, the list
      // starts shut, and this runs as the page is read rather than after it loads, so the
      // page is never drawn open first.
      (function () {
        var folds = document.querySelectorAll(".insights details.more");
        for (var i = 0; i < folds.length; i++) folds[i].open = false;
      })();
    </script>
  </article>
</Base>

<style>
  .insights {
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  /* 2 cards a row where they fit, each with room for its plot. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 2rem 3rem;
    margin-top: 1.25rem;
  }

  .section-body {
    margin: 0.35rem 0 0;
    color: var(--quiet);
    font-size: var(--t-sm);
    max-width: 62ch;
  }

  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(var(--t-lg), 5vw, var(--t-xl));
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .lede {
    color: var(--quiet);
    font-size: var(--t-md);
    max-width: 42ch;
  }

  .topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: var(--t-sm);
  }

  .topics a {
    color: var(--quiet);
  }

  section {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    scroll-margin-top: calc(var(--bar-h, 4.5rem) + 0.75rem);
  }

  h2 {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 400;
    margin: 0;
  }

  details.more summary {
    margin: 1.25rem 0;
    font-size: var(--t-sm);
    color: var(--quiet);
    cursor: pointer;
  }

  details.more summary:hover {
    color: var(--ink);
  }

  details.more:not([open]) summary {
    margin-bottom: 0;
  }
</style>
