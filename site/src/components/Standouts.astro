---
/**
 * The figures that stand out across Morocco, one commune each. The list is worked out
 * in lib/insights.ts. The first 10 of a topic show, and the rest sit in a fold that is
 * open in the markup: a phone shuts it as the page is read, the same way a place page does.
 */
import Base from "../layouts/Base.astro";
import Standout from "./Standout.astro";
import { places } from "../i18n/places";
import { path, t, type Locale } from "../i18n/ui";
import { insightsOf, standouts } from "../lib/insights";
import { pageOf } from "../lib/places";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const how = places[locale].insightsMore;
const groups = standouts(insightsOf.values(), pageOf);
const topicName = (topic: string) => (copy.insightTopics as Record<string, string>)[topic] ?? topic;
const shown = 10;
---

<Base locale={locale} route="insights/" title={copy.insightsTitle} description={copy.insightsLede}>
  <article class="insights">
    <h1>{copy.insightsTitle}</h1>
    <p class="lede">
      {copy.insightsLede} <a href={path(locale, "docs/insights/")}>{how}</a>
    </p>
    {groups.length > 0 && (
      <nav class="topics" aria-label={copy.insightsTopics}>
        <ul>
          {groups.map((group) => (
            <li><a href={`#${group.topic}`}>{topicName(group.topic)}</a></li>
          ))}
        </ul>
      </nav>
    )}
    {groups.map((group) => {
      const rest = group.rows.slice(shown);
      return (
        <section id={group.topic}>
          <h2>{topicName(group.topic)}</h2>
          {group.rows.slice(0, shown).map((row) => <Standout locale={locale} row={row} />)}
          {rest.length > 0 && (
            <details class="more" open>
              <summary>{copy.insightsShowMore}</summary>
              {rest.map((row) => <Standout locale={locale} row={row} />)}
            </details>
          )}
        </section>
      );
    })}
    <script is:inline>
      // Open in the markup, so the rest of a topic shows without JavaScript. A phone starts
      // with it shut, and this runs as the page is read rather than after it loads, so the
      // page is never drawn open first. Same fold as a place page.
      (function () {
        if (!window.matchMedia("(max-width: 48rem)").matches) return;
        var folds = document.querySelectorAll(".insights details.more");
        for (var i = 0; i < folds.length; i++) folds[i].open = false;
      })();
    </script>
  </article>
</Base>

<style>
  .insights {
    padding-block: clamp(2rem, 6vw, 4rem);
    max-width: 46rem;
  }

  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(var(--t-lg), 5vw, var(--t-xl));
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .lede {
    color: var(--quiet);
    font-size: var(--t-md);
    max-width: 42ch;
  }

  .topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: var(--t-sm);
  }

  .topics a {
    color: var(--quiet);
  }

  section {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    scroll-margin-top: calc(var(--bar-h, 4.5rem) + 0.75rem);
  }

  h2 {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 400;
    margin: 0;
  }

  details.more summary {
    margin: 1.25rem 0;
    font-size: var(--t-sm);
    color: var(--quiet);
    cursor: pointer;
  }

  details.more summary:hover {
    color: var(--ink);
  }

  details.more:not([open]) summary {
    margin-bottom: 0;
  }
</style>
