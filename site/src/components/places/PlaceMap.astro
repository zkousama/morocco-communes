---
/**
 * A province's communes, shaded by density. Pointing at one shows the home map's card, its
 * name and the lines the home map starts with, straight away, and it goes once the pointer
 * leaves the shape. The card's text is written onto each shape here, so the script only shows it.
 */
import type { Locale } from "../../i18n/ui";
import { arrondissements, communeOf, type Drawing } from "../../lib/places";
import { shapeLines } from "../../lib/shapeTip";
import { nameIn } from "../../lib/names";

interface Props {
  locale: Locale;
  drawing: Drawing & { provinces?: { code: string; d: string }[] };
  label: string;
  /** Each shape's density class, 0 to 5, for the shading the home map uses. */
  classOf: (code: string) => string;
  /** A page for each shape, and its name for the tooltip. A shape with no page keeps its name. */
  linkOf: (code: string) => { href?: string; name: string } | null;
  /** The shape the page is about, drawn over the rest. */
  highlight?: string;
  /** The shapes that border it, outlined so the map says which ones the list names. */
  borders?: Set<string>;
  /** What to call land no commune's boundary covers. */
  gapLabel?: string;
}
const { locale, drawing, label, classOf, linkOf, highlight, borders, gapLabel = "" } = Astro.props;
const focus = highlight ? drawing.shapes.find((s) => s.code === highlight) : undefined;
const touching = borders ? drawing.shapes.filter((s) => borders.has(s.code)) : [];
---

<div class="place-map-frame">
<svg class="place-map" viewBox={drawing.viewBox} role="group" aria-label={label}>
  {drawing.gaps.length > 0 && (
    <defs>
      <pattern id="place-hatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line class="hatch" x1="0" y1="0" x2="0" y2="4" />
      </pattern>
    </defs>
  )}
  {drawing.shapes.map((shape) => {
    const link = linkOf(shape.code);
    const place = communeOf.get(shape.code) ?? arrondissements.find((a) => a.code === shape.code);
    const path = <path d={shape.d} data-d={classOf(shape.code)} />;
    // The page's own commune has no link, and still gets its card.
    const name = link?.name ?? (place && nameIn(locale, place.name));
    if (!name) return path;
    const lines = place ? shapeLines(locale, place).join("\n") : "";
    return link?.href ? (
      <a href={link.href} aria-label={name} data-name={name} data-lines={lines}>{path}</a>
    ) : (
      <g role="img" aria-label={name} data-name={name} data-lines={lines}>{path}</g>
    );
  })}
  {drawing.gaps.map((d) => <path class="gap" d={d} role="img" aria-label={gapLabel} data-name={gapLabel} />)}
  {drawing.provinces && <path class="provinces" d={drawing.provinces.map((p) => p.d).join("")} />}
  <path class="edge" d={drawing.outline} />
  {touching.length > 0 && <path class="touching" d={touching.map((s) => s.d).join("")} />}
  {focus && <path class="focus" d={focus.d} />}
</svg>
<div class="place-tip" hidden></div>
</div>

<script>
  import { placeTip } from "../../lib/tip";

  // A pointer shows the card at once and hides it as it leaves the shape; the keyboard
  // shows it on the link in focus. A tap follows the link, as before.
  for (const frame of document.querySelectorAll<HTMLElement>(".place-map-frame")) {
    const tip = frame.querySelector<HTMLElement>(".place-tip");
    if (!tip) continue;
    let current: Element | null = null;
    const show = (shape: Element) => {
      if (shape === current) return;
      current = shape;
      const name = document.createElement("strong");
      name.textContent = shape.getAttribute("data-name") ?? "";
      const lines = (shape.getAttribute("data-lines") ?? "")
        .split("\n")
        .filter(Boolean)
        .map((text) => Object.assign(document.createElement("span"), { textContent: text }));
      tip.replaceChildren(name, ...lines);
      tip.hidden = false;
    };
    const place = (x: number, y: number) => {
      const box = frame.getBoundingClientRect();
      const at = placeTip({ x: x - box.left, y: y - box.top }, { width: tip.offsetWidth, height: tip.offsetHeight }, box, null);
      tip.style.transform = `translate(${Math.round(at.x)}px, ${Math.round(at.y)}px)`;
    };
    const hide = () => {
      current = null;
      tip.hidden = true;
    };
    frame.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      const shape = (event.target as Element).closest("[data-name]");
      if (!shape) return hide();
      show(shape);
      place(event.clientX, event.clientY);
    });
    frame.addEventListener("pointerleave", hide);
    frame.addEventListener("focusin", (event) => {
      const shape = (event.target as Element).closest("[data-name]");
      if (!shape) return;
      show(shape);
      const box = shape.getBoundingClientRect();
      place(box.left + box.width / 2, box.top + box.height / 2);
    });
    frame.addEventListener("focusout", hide);
  }
</script>

<style>
  .place-map-frame {
    position: relative;
  }

  /* The home map's card. */
  .place-tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    display: grid;
    gap: 0.1rem;
    min-width: 11rem;
    max-width: min(16rem, 100%);
    padding: 0.55rem 0.75rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.12);
    font-size: var(--t-xs);
    line-height: 1.45;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  .place-tip[hidden] {
    display: none;
  }

  .place-tip :global(strong) {
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .place-tip :global(span) {
    color: var(--quiet);
  }

  .place-map {
    display: block;
    width: 100%;
    height: auto;
    max-height: 26rem;
    overflow: visible;
  }

  path {
    fill: var(--map-none);
    fill-rule: evenodd;
    stroke: var(--paper);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  [data-d="0"] { fill: var(--seq-0); }
  [data-d="1"] { fill: var(--seq-1); }
  [data-d="2"] { fill: var(--seq-2); }
  [data-d="3"] { fill: var(--seq-3); }
  [data-d="4"] { fill: var(--seq-4); }
  [data-d="5"] { fill: var(--seq-5); }

  a:hover path,
  a:focus-visible path {
    fill: var(--brass);
  }

  .gap {
    fill: url(#place-hatch);
    stroke: var(--quiet);
    stroke-width: 0.5;
  }

  .hatch {
    stroke: var(--quiet);
    stroke-width: 1.2;
  }

  .provinces {
    fill: none;
    stroke: var(--paper);
    stroke-width: 2;
    pointer-events: none;
  }

  .edge {
    fill: none;
    stroke: none;
    pointer-events: none;
  }

  /* The communes the page says it borders, in the colour of the commune itself so the
     two read as one family. Outlined rather than filled, since the fill is the density. */
  .touching {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.4;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .focus {
    fill: var(--brass);
    stroke: var(--ink);
    stroke-width: 1.4;
    pointer-events: none;
  }
</style>
