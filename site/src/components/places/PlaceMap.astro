---
import type { Drawing } from "../../lib/places";

interface Props {
  drawing: Drawing & { provinces?: { code: string; d: string }[] };
  label: string;
  /** Each shape's density class, 0 to 5, for the shading the home map uses. */
  classOf: (code: string) => string;
  /** A page for each shape, and its name for the tooltip. A shape with no page keeps its name. */
  linkOf: (code: string) => { href?: string; name: string } | null;
  /** The shape the page is about, drawn over the rest. */
  highlight?: string;
  /** What to call land no commune's boundary covers. */
  gapLabel?: string;
}
const { drawing, label, classOf, linkOf, highlight, gapLabel = "" } = Astro.props;
const focus = highlight ? drawing.shapes.find((s) => s.code === highlight) : undefined;
---

<svg class="place-map" viewBox={drawing.viewBox} role="group" aria-label={label}>
  {drawing.gaps.length > 0 && (
    <defs>
      <pattern id="place-hatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line class="hatch" x1="0" y1="0" x2="0" y2="4" />
      </pattern>
    </defs>
  )}
  {drawing.shapes.map((shape) => {
    const link = linkOf(shape.code);
    const path = <path d={shape.d} data-d={classOf(shape.code)} />;
    if (!link) return path;
    return link.href ? <a href={link.href}><title>{link.name}</title>{path}</a> : <g><title>{link.name}</title>{path}</g>;
  })}
  {drawing.gaps.map((d) => <path class="gap" d={d}><title>{gapLabel}</title></path>)}
  {drawing.provinces && <path class="provinces" d={drawing.provinces.map((p) => p.d).join("")} />}
  <path class="edge" d={drawing.outline} />
  {focus && <path class="focus" d={focus.d} />}
</svg>

<style>
  .place-map {
    display: block;
    width: 100%;
    height: auto;
    max-height: 26rem;
    overflow: visible;
  }

  path {
    fill: var(--map-none);
    fill-rule: evenodd;
    stroke: var(--paper);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  [data-d="0"] { fill: var(--seq-0); }
  [data-d="1"] { fill: var(--seq-1); }
  [data-d="2"] { fill: var(--seq-2); }
  [data-d="3"] { fill: var(--seq-3); }
  [data-d="4"] { fill: var(--seq-4); }
  [data-d="5"] { fill: var(--seq-5); }

  a:hover path,
  a:focus-visible path {
    fill: var(--brass);
  }

  .gap {
    fill: url(#place-hatch);
    stroke: var(--quiet);
    stroke-width: 0.5;
  }

  .hatch {
    stroke: var(--quiet);
    stroke-width: 1.2;
  }

  .provinces {
    fill: none;
    stroke: var(--paper);
    stroke-width: 2;
    pointer-events: none;
  }

  .edge {
    fill: none;
    stroke: none;
    pointer-events: none;
  }

  .focus {
    fill: var(--brass);
    stroke: var(--ink);
    stroke-width: 1.4;
    pointer-events: none;
  }
</style>
