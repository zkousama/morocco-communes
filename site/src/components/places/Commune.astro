---
import Place from "../../layouts/Place.astro";
import Code from "../Code.astro";
import PlaceMap from "./PlaceMap.astro";
import Arrow from "../Arrow.astro";
import Inset from "./Inset.astro";
import { ratedChange } from "../../lib/rate";
import ChangeChart from "./ChangeChart.astro";
import People from "./People.astro";
import Economy from "./Economy.astro";
import Housing from "./Housing.astro";
import Insights from "./Insights.astro";
import Douars from "./Douars.astro";
import { indicatorsOf } from "../../lib/indicators";
import { moveLine, movedMost, nextDoor, onlyHere, onlyHereLine, twinOf } from "../../lib/context";
import { contentsOf } from "../../lib/contents";
import { economyOf } from "../../lib/economy";
import { housingOf } from "../../lib/housing";
import { insightsOf } from "../../lib/insights";
import { de, fill, ordinal, places } from "../../i18n/places";
import { REPO_URL, path, t, type Locale } from "../../i18n/ui";
import { INTL } from "../../lib/intl";
import { ordinary } from "../../../../api/src/lib/ordinary.ts";
import { hasNeighbourhoods, postcodesOf, villagesOf } from "../../lib/neighbourhoods";
import { douarsOf } from "../../lib/douars";
import { density, listComma, numbers, percent } from "../../lib/format";
import { besideIn, byNameIn, nameBeside, nameIn } from "../../lib/names";
import { densityBreaks } from "../../generated/map";
import { placeData } from "../../lib/placeData";
import {
  arrondissementsOf,
  cercleOf,
  communeOf,
  communes,
  communesIn,
  drawArrondissements,
  drawProvince,
  inset,
  nationalRank,
  neighbours,
  pageOf,
  provinceOf,
  regionOf,
  sharedNames,
  type Commune,
} from "../../lib/places";

interface Props {
  locale: Locale;
  commune: Commune;
}
const { locale, commune: c } = Astro.props;
const p = places[locale];
const name = nameIn(locale, c.name);
const comma = listComma(locale);
const province = provinceOf.get(c.parents.province)!;
const region = regionOf.get(c.parents.region)!;
const cercle = c.parents.cercle ? cercleOf.get(c.parents.cercle) : undefined;

const n = new Intl.NumberFormat(INTL[locale]);
const n1 = new Intl.NumberFormat(INTL[locale], { maximumFractionDigits: 1 });
const signed = (v: number) => percent(locale, v, { signed: true, fixed: true });
const people = c.population["2024"];
const change = c.population.change;
// A rate from a handful of people is no rate: 55 people in 2014 and 5,728 now is +10,314.6%.
const rate = ratedChange(change, c.population["2014"]?.total);
const ptype = p.unitTypesLower[province.type];

const lede =
  locale === "fr"
    ? fill(c.type === "rural" && cercle ? p.communeLedeRural : p.communeLede, {
        type: c.type === "urban" ? p.urbanCommune : p.ruralCommune,
        ptype,
        ofProvince: de(province.name.fr),
        ofRegion: de(region.name.fr),
        ofCercle: cercle ? de(cercle.name.fr) : "",
      })
    : fill(c.type === "rural" && cercle ? p.communeLedeRural : p.communeLede, {
        type: c.type === "urban" ? p.urbanCommune : p.ruralCommune,
        ptype,
        province: nameIn(locale, province.name),
        region: nameIn(locale, region.name),
        cercle: cercle ? nameIn(locale, cercle.name) : "",
      });

const rank = nationalRank.get(c.code)!;
const siblings = communesIn(province.code);
const rankInProvince = siblings.findIndex((s) => s.code === c.code) + 1;

const href = (slug: string) => path(locale, `communes/${slug}/`);
const densityClass = (code: string) => {
  const d = communeOf.get(code)?.density;
  if (d == null) return "n";
  const i = densityBreaks.findIndex((b) => d < b);
  return String(i < 0 ? densityBreaks.length : i);
};
const drawing = drawProvince(province.code);
const where = inset({ region: region.code, province: province.code });
const bordering = (neighbours.get(c.code) ?? [])
  .map((n) => communeOf.get(n.code)!)
  .sort(byNameIn(locale));
const census = indicatorsOf.get(c.code);
const economy = economyOf.get(c.code);
const housing = housingOf.get(c.code);
const insights = insightsOf.get(c.code);
const fractions = douarsOf(c.code);
const arrondissements = arrondissementsOf(c.code);
const cityDrawing = drawArrondissements(c.code);
// Every arrondissement in Casablanca is past the top national break, so the city is shaded
// on its own scale: ranked by density and spread over classes 1 to 5.
const byDensity = arrondissements.filter((a) => a.density !== null).sort((a, b) => a.density! - b.density!);
const arrondissementClass = (code: string) => {
  const i = byDensity.findIndex((a) => a.code === code);
  return i < 0 ? "n" : String(1 + Math.floor((i * 5) / byDensity.length));
};
// Poste Maroc's postcodes, and whether the API has a neighbourhoods file for this commune.
const hoods = hasNeighbourhoods(c.code);
const codes = postcodesOf(c.code);
// A town's villages and hamlets, where OpenStreetMap maps any; a rural commune lists its douars.
const villages = c.type === "urban" ? villagesOf(c.code) : [];
/** Postcodes shown before "and N more". */
const CODES_SHOWN = 12;

const contents = contentsOf(locale, {
  change: Boolean(rate),
  people: Boolean(census),
  dwellings: Boolean(housing),
  work: Boolean(economy),
  urbanCentres: c.urbanCentres.length > 0,
  douars: fractions.length > 0,
  arrondissements: arrondissements.length > 0,
});

// Shares to one decimal, as People shows them, and household size the same way.
const share = (v: number) => percent(locale, v, { fixed: true });
const one = numbers(locale, 1, true);
const gap = nextDoor(c.code);
const gapPage = gap && pageOf(gap.code);
const [gapBefore, gapAfter] = gap
  ? fill((p.nextDoor as Record<string, string>)[gap.path]!, { there: share(gap.there), here: share(gap.here) }).split("{place}")
  : [];
const move = movedMost(c.code);
const moved = move && moveLine(locale, move);
const twin = twinOf(c.code);
const twinPage = twin && pageOf(twin.code);
const twinNames = p.twinNames as Record<string, string>;
const twinValue = (path: string, v: number) => (path === "households.averageSize" ? one.format(v) : share(v));
const rare = onlyHere(c.code).map((item) => onlyHereLine(locale, item));
const twinFigures = (twin?.closest ?? [])
  .map((f) => fill(p.twinFigure, { label: twinNames[f.path] ?? f.path, here: twinValue(f.path, f.here), there: twinValue(f.path, f.there) }))
  .join(p.twinJoin);
// The figures start a sentence of their own, and the labels are written to sit mid-sentence.
const [twinBefore, twinAfter] = fill(p.twin, { figures: twinFigures.charAt(0).toLocaleUpperCase(locale) + twinFigures.slice(1) }).split("{twin}");
// The compare page, set up with this commune and its closest match. Only for a commune it compares.
const ui = t(locale);
const comparable = indicatorsOf.has(c.code) && ordinary(people.total, people.households);
const twinSlug = twin ? communeOf.get(twin.code)?.slug : undefined;
const compareHref = comparable ? path(locale, `compare/?c=${[c.slug, twinSlug].filter(Boolean).join(",")}`) : null;
const compareText = twinPage ? fill(ui.compareWith, { name: nameIn(locale, twinPage.name) }) : ui.compareAnother;

const description =
  `${name} (${nameBeside(locale, c.name)}): ${n.format(people.total)} ${p.told.people}` +
  (rate ? `${comma}${signed(rate.pct)} ${p.told.since}` : "") +
  `. ${p.told.code} ${c.code}.`;

const snippet = `import { getCommune } from "morocco-communes";

getCommune("${c.slug}");`;
---

<Place
  locale={locale}
  route={`communes/${c.slug}/`}
  title={name}
  code={c.code}
  data={placeData({
    site: Astro.site,
    href: path(locale, `communes/${c.slug}/`),
    name: c.name,
    code: c.code,
    parent: { name: province.name.fr, href: path(locale, `provinces/${province.slug}/`) },
    osm: c.osm,
    centroid: c.centroid,
  })}
  documentTitle={sharedNames.has(c.name.fr) ? `${name}${comma}${nameIn(locale, province.name)}` : undefined}
  description={description}
  beside={nameBeside(locale, c.name)}
  lede={lede}
  trail={[
    { href: path(locale, "communes/"), label: p.browseTitle },
    { href: path(locale, `regions/${region.slug}/`), label: nameIn(locale, region.name) },
    { href: path(locale, `provinces/${province.slug}/`), label: nameIn(locale, province.name) },
  ]}
>
  <dl class="figures">
    <div>
      <dt>{p.population}</dt>
      <dd>{n.format(people.total)}</dd>
    </div>
    <div>
      <dt>{p.change}</dt>
      <dd class:list={[rate && (rate.pct >= 0 ? "up" : "down")]}>
        {rate ? (
          signed(rate.pct)
        ) : change ? (
          <>
            {n.format(c.population["2014"]!.total!)} <Arrow /> {n.format(people.total)}
          </>
        ) : (
          "—"
        )}
        {rate || !change ? (
          <small>{change ? fill(p.changeFrom, { n: n.format(c.population["2014"]!.total!) }) : p.noChange}</small>
        ) : (
          <small>{p.changeNoRate}</small>
        )}
      </dd>
    </div>
    <div>
      <dt>{p.density}</dt>
      <dd>
        {c.density === null ? "—" : density(locale, c.density)}
        <small>{c.density === null ? p.noBoundary : `${p.perKm2}${comma}${n1.format(c.areaKm2!)} ${p.told.km2}`}</small>
      </dd>
    </div>
    {people.households !== null && (
      <div>
        <dt>{p.households}</dt>
        <dd>{n.format(people.households)}</dd>
      </div>
    )}
    {people.foreign !== null && people.foreign > 0 && (
      <div>
        <dt>{p.foreign}</dt>
        <dd>{n.format(people.foreign)}</dd>
      </div>
    )}
    <div>
      <dt>{p.rank}</dt>
      <dd>
        {n.format(rank)}
        <small>
          {rank === 1 ? fill(p.rankFirst, { total: n.format(communes.length) }) : fill(p.rankText, { nth: ordinal(locale, rank), total: n.format(communes.length) })}
        </small>
        <small>{fill(p.rankProvince, { nth: ordinal(locale, rankInProvince), total: siblings.length, ptype })}</small>
      </dd>
    </div>
  </dl>

  {(gapPage || moved || twinPage || rare.length > 0 || compareHref) && (
    <div class="context">
      {gapPage && <p>{gapBefore}<a href={path(locale, gapPage.route)}>{nameIn(locale, gapPage.name)}</a>{gapAfter}</p>}
      {moved && <p>{moved}</p>}
      {twinPage && <p>{twinBefore}<a href={path(locale, twinPage.route)}>{nameIn(locale, twinPage.name)}</a>{twinAfter}</p>}
      {compareHref && <p class="compare"><a href={compareHref}>{compareText} <Arrow /></a></p>}
      {rare.map((line) => <p>{line}</p>)}
    </div>
  )}

  <nav class="contents" aria-label={p.onThisPage}>
    <ul>
      {contents.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
    </ul>
  </nav>

  <section class="pair" id="where">
    <div>
      <h2>{p.where}</h2>
      <p>{fill(p.whereBody, { ptype })}</p>
      {drawing && (
        <PlaceMap
          locale={locale}
          drawing={drawing}
          gapLabel={p.gapLabel}
          label={fill(p.mapLabel, { name: nameIn(locale, province.name) })}
          classOf={densityClass}
          linkOf={(code) => {
            const x = communeOf.get(code);
            return x && x.code !== c.code ? { href: href(x.slug), name: nameIn(locale, x.name) } : null;
          }}
          highlight={c.code}
          borders={new Set(bordering.map((b) => b.code))}
        />
      )}
    </div>
    <div class="side">
      <Inset {...where} label={fill(p.insetLabel, { name: nameIn(locale, province.name) })} />
      {bordering.length > 0 && (
        <>
          <h3>{p.bordering}</h3>
          <ul class="links">
            {bordering.map((b) => <li><a href={href(b.slug)}>{nameIn(locale, b.name)}</a></li>)}
          </ul>
        </>
      )}
      {codes.length > 0 && (
        <>
          <h3>{codes.length === 1 ? p.postcode : p.postcodes}</h3>
          <p class="postcodes">
            {codes.slice(0, CODES_SHOWN).join(comma)}{codes.length > CODES_SHOWN && <span class="postcodes-rest">{`${comma}${codes.slice(CODES_SHOWN).join(comma)}`}</span>}
            {codes.length > CODES_SHOWN && (
              <button type="button" class="postcodes-more" hidden>{fill(p.postcodesMore, { n: n.format(codes.length - CODES_SHOWN) })}</button>
            )}
          </p>
        </>
      )}
      {villages.length > 0 && (
        <>
          <h3>{p.villages}</h3>
          <p class="postcodes">
            {villages.slice(0, CODES_SHOWN).join(comma)}{villages.length > CODES_SHOWN && <span class="postcodes-rest">{`${comma}${villages.slice(CODES_SHOWN).join(comma)}`}</span>}
            {villages.length > CODES_SHOWN && (
              <button type="button" class="postcodes-more" hidden>{fill(p.postcodesMore, { n: n.format(villages.length - CODES_SHOWN) })}</button>
            )}
          </p>
        </>
      )}
    </div>
  </section>

  {rate && (
    <section id="change">
      <h2>{p.howItChanged}</h2>
      <p>{fill(p.chartBody, { name })}</p>
      <ChangeChart
        locale={locale}
        value={rate.pct}
        name={name}
        nationalLabel={p.chartNational}
        srText={`${name} ${signed(rate.pct)}`}
      />
    </section>
  )}

  {census && <People locale={locale} record={census} name={name} />}

  {housing && <Housing locale={locale} record={housing} name={name} />}

  {economy && <Economy locale={locale} record={economy} population={people.total} />}

  {insights && <Insights locale={locale} record={insights} />}

  {c.urbanCentres.length > 0 && (
    <section id="urban-centres">
      <h2>{p.urbanCentres}</h2>
      <p>{p.urbanCentresBody}</p>
      <div class="scroll" tabindex="0">
        <table>
          <tbody>
            {c.urbanCentres.map((u) => (
              <tr><td>{u.name}</td><td class="num">{u.population === null ? "—" : n.format(u.population)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {fractions.length > 0 && <Douars locale={locale} code={c.code} fractions={fractions} name={name} urban={c.type === "urban"} />}

  {arrondissements.length > 0 && (
    <section id="arrondissements">
      <h2>{p.arrondissements}</h2>
      <p>{p.arrondissementsBody}</p>
      <div class="pair">
        {cityDrawing && (
          <PlaceMap
            locale={locale}
            drawing={cityDrawing}
            label={fill(p.mapLabel, { name })}
            classOf={arrondissementClass}
            linkOf={(code) => {
              const a = arrondissements.find((x) => x.code === code);
              return a ? { name: nameIn(locale, a.name) } : null;
            }}
          />
        )}
        <div class="scroll" tabindex="0">
          <table>
            <thead>
              <tr>
                <th>{p.colArrondissement}</th>
                <th class="num">{p.colPopulation}</th>
                <th class="num">{p.colDensity}</th>
              </tr>
            </thead>
            <tbody>
              {arrondissements.map((a) => (
                <tr>
                  <td>{nameIn(locale, a.name)} <span {...besideIn(locale)} class="ar">{nameBeside(locale, a.name)}</span></td>
                  <td class="num">{n.format(a.population["2024"].total)}</td>
                  <td class="num">{a.density === null ? "—" : density(locale, a.density)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section id="data">
    <h2>{p.inTheData}</h2>
    <details class="more" open>
      <summary>{p.moreData}</summary>
      <dl class="data">
        <div><dt>{p.code}</dt><dd><code>{c.code}</code></dd></div>
        <div><dt>{p.codeDigits}</dt><dd><code>{c.codeDigits}</code></dd></div>
        <div><dt>{p.slug}</dt><dd><code>{c.slug}</code></dd></div>
        <div><dt>{p.record}</dt><dd><a href={`/api/communes/${c.code}.json`}><code>/api/communes/{c.code}.json</code></a></dd></div>
        {c.areaKm2 !== null && (
          <div><dt>{p.boundary}</dt><dd><a href={`/api/communes/${c.code}/boundary.geojson`}><code>/api/communes/{c.code}/boundary.geojson</code></a></dd></div>
        )}
        {census && (
          <div><dt>{p.census}</dt><dd><a href={`/api/communes/${c.code}/indicators.json`}><code>/api/communes/{c.code}/indicators.json</code></a></dd></div>
        )}
        {economy && (
          <div><dt>{p.work}</dt><dd><a href={`/api/communes/${c.code}/economy.json`}><code>/api/communes/{c.code}/economy.json</code></a></dd></div>
        )}
        {housing && (
          <div><dt>{p.dwellingsTitle}</dt><dd><a href={`/api/communes/${c.code}/housing.json`}><code>/api/communes/{c.code}/housing.json</code></a></dd></div>
        )}
        {insights && (
          <div><dt>{p.insightsTitle}</dt><dd><a href={`/api/communes/${c.code}/insights.json`}><code>/api/communes/{c.code}/insights.json</code></a></dd></div>
        )}
        {bordering.length > 0 && (
          <div><dt>{p.bordering}</dt><dd><a href={`/api/communes/${c.code}/neighbours.json`}><code>/api/communes/{c.code}/neighbours.json</code></a></dd></div>
        )}
        {hoods && (
          <div><dt>{p.neighbourhoodsData}</dt><dd><a href={`/api/communes/${c.code}/neighbourhoods.json`}><code>/api/communes/{c.code}/neighbourhoods.json</code></a></dd></div>
        )}
        {fractions.length > 0 && (
          <div><dt>{p.douars}</dt><dd><a href={`/api/communes/${c.code}/douars.json`}><code>/api/communes/{c.code}/douars.json</code></a></dd></div>
        )}
        {c.osm && (
          <div><dt>{p.osm}</dt><dd><a href={`https://www.openstreetmap.org/relation/${c.osm.relationId}`}>{c.osm.relationId}</a></dd></div>
        )}
      </dl>
      <Code locale={locale} label={p.inJs} code={snippet} lang="js" />
    </details>
    <p class="report"><a href={`${REPO_URL}/issues/new?template=data-error.yml&title=${encodeURIComponent(`${c.name.fr} (${c.code})`)}`}>{p.report}</a></p>
  </section>
</Place>

<style>
  .side {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  /* Under the map rather than beside it in weight: the neighbours are part of where the
     commune is, not a section of their own. */
  .side h3 {
    margin: 0.5rem 0 0;
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .postcodes {
    margin: 0;
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
  }

  .postcodes-more {
    margin-inline-start: 0.3em;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--quiet);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  .postcodes-more:hover {
    color: var(--ink);
  }

  .postcodes-more[hidden],
  .postcodes-rest[hidden] {
    display: none;
  }

  /* Read with the headline numbers rather than as a section of its own, so it sits close
     under them and has no heading. */
  .context {
    padding-top: 1.25rem;
  }

  .context p {
    margin: 0 0 0.5rem;
    max-width: var(--measure);
  }

  .context .compare {
    font-size: var(--t-sm);
  }

  /* Quiet like the breadcrumb, and wrapping the same way, so a phone gets 2 or 3 short
     lines rather than a page wider than the screen. Space alone parts the links: a
     separator would start a wrapped line. */
  .contents ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    font-size: var(--t-sm);
  }

  .contents a {
    color: var(--quiet);
    text-decoration: none;
  }

  .contents a:hover {
    color: var(--ink);
  }

  .ar {
    color: var(--quiet);
    margin-inline-start: 0.5rem;
  }
</style>

<script>
  // A city's postcodes past the first few, folded behind a button once this runs; without
  // it, every postcode shows.
  for (const more of document.querySelectorAll<HTMLButtonElement>(".postcodes-more")) {
    const rest = more.parentElement?.querySelector<HTMLElement>(".postcodes-rest");
    if (!rest) continue;
    rest.hidden = true;
    more.hidden = false;
    more.addEventListener("click", () => {
      rest.hidden = false;
      more.remove();
    });
  }
</script>
