---
/**
 * A province, a préfecture or a région: its figures, a map of its communes shaded by
 * density, and a table of what it holds, largest first.
 */
import Place from "../../layouts/Place.astro";
import PlaceMap from "./PlaceMap.astro";
import Inset from "./Inset.astro";
import People from "./People.astro";
import Economy from "./Economy.astro";
import Housing from "./Housing.astro";
import Insights from "./Insights.astro";
import { indicatorsOf } from "../../lib/indicators";
import { economyOf } from "../../lib/economy";
import { housingOf } from "../../lib/housing";
import { insightsOf } from "../../lib/insights";
import { de, fill, places } from "../../i18n/places";
import { path, REPO_URL, type Locale } from "../../i18n/ui";
import { density, percent } from "../../lib/format";
import { densityBreaks } from "../../generated/map";
import { placeData } from "../../lib/placeData";
import {
  arrondissementsInPrefecture,
  communeOf,
  communesIn,
  drawProvince,
  drawRegion,
  inset,
  provincesIn,
  regionOf,
  type Province,
  type Region,
} from "../../lib/places";

type Props = { locale: Locale } & ({ province: Province; region?: undefined } | { region: Region; province?: undefined });
const { locale, province, region: asRegion } = Astro.props;
const p = places[locale];
const region = asRegion ?? regionOf.get(province!.regionCode)!;
const unit = province ?? region;
const census = indicatorsOf.get(unit.code);
const economy = economyOf.get(unit.code);
const housing = housingOf.get(unit.code);
const insights = insightsOf.get(unit.code);
// Where the unit's own files are. A préfecture d'arrondissements has no communes of its
// own, so no list of them and no boundary drawn from them.
const api = `/api/${province ? "provinces" : "regions"}/${unit.code}`;

const n = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-GB");
const signed = (v: number) => percent(locale, v, { signed: true, fixed: true });

const communes = province ? communesIn(province.code) : provincesIn(region.code).flatMap((pr) => communesIn(pr.code));
const arrondissements = province?.type === "prefecture_of_arrondissements" ? arrondissementsInPrefecture(province.code) : [];
const subunits = province ? [] : provincesIn(region.code);

// Change over the communes with a figure for both years, so the total compares like with like.
const before = communes.reduce((s, c) => s + (c.population["2014"]?.total ?? 0), 0);
const after = communes.filter((c) => c.population["2014"]?.total != null).reduce((s, c) => s + c.population["2024"].total, 0);
const change = before > 0 ? ((after - before) / before) * 100 : null;
const area = communes.reduce((s, c) => s + (c.areaKm2 ?? 0), 0);

const title = unit.name.fr;
// Larache is a province and a commune, so the tab says which this is.
const documentTitle = province
  ? fill(p.provinceTitle, { name: title, ptype: p.unitTypesLower[province.type], Ptype: p.unitTypes[province.type], ofName: de(title) })
  : fill(p.regionTitle, { name: title, ofName: de(title) });
const lede = province
  ? locale === "fr"
    ? fill(p.provinceLede, { ptype: p.unitTypes[province.type], ofRegion: de(region.name.fr) })
    : fill(p.provinceLede, { ptype: p.unitTypes[province.type], region: region.name.fr })
  : p.regionLede;
const route = province ? `provinces/${province.slug}/` : `regions/${region.slug}/`;
const description =
  `${title} (${unit.name.ar}): ${n.format(unit.population["2024"].total)} ${locale === "fr" ? "habitants en 2024" : "people in 2024"}, ` +
  `${n.format(communes.length)} ${locale === "fr" ? "communes" : "communes"}. ${locale === "fr" ? "Code HCP" : "HCP code"} ${unit.code}.`;

const densityClass = (code: string) => {
  const d = communeOf.get(code)?.density;
  if (d == null) return "n";
  const i = densityBreaks.findIndex((b) => d < b);
  return String(i < 0 ? densityBreaks.length : i);
};
const drawing = province ? drawProvince(province.code) : drawRegion(region.code);
const where = inset(province ? { region: region.code, province: province.code } : { region: region.code });
const communeHref = (slug: string) => path(locale, `communes/${slug}/`);

// The communes that stand out, for the column beside the map.
const withChange = communes.filter((c) => c.population.change);
const withDensity = communes.filter((c) => c.density !== null);
const pick = <T,>(list: T[], better: (a: T, b: T) => boolean) =>
  list.reduce<T | undefined>((best, c) => (best === undefined || better(c, best) ? c : best), undefined);
const standouts = [
  { label: p.largest, commune: communes[0], value: communes[0] && n.format(communes[0].population["2024"].total) },
  (() => {
    const c = pick(withChange, (a, b) => a.population.change!.pct > b.population.change!.pct);
    return { label: p.grewMost, commune: c && c.population.change!.pct > 0 ? c : undefined, value: c && signed(c.population.change!.pct) };
  })(),
  (() => {
    const c = pick(withChange, (a, b) => a.population.change!.pct < b.population.change!.pct);
    return { label: p.shrankMost, commune: c && c.population.change!.pct < 0 ? c : undefined, value: c && signed(c.population.change!.pct) };
  })(),
  (() => {
    const c = pick(withDensity, (a, b) => a.density! > b.density!);
    return { label: p.densest, commune: c, value: c && `${density(locale, c.density!)} ${p.perKm2}` };
  })(),
].filter((s) => s.commune);
---

<Place
  locale={locale}
  route={route}
  title={title}
  code={unit.code}
  data={placeData({
    site: Astro.site,
    href: path(locale, route),
    name: unit.name,
    code: unit.code,
    parent: province ? { name: region.name.fr, href: path(locale, `regions/${region.slug}/`) } : undefined,
  })}
  documentTitle={documentTitle}
  description={description}
  arabic={unit.name.ar}
  lede={lede}
  trail={[
    { href: path(locale, "communes/"), label: p.browseTitle },
    ...(province ? [{ href: path(locale, `regions/${region.slug}/`), label: region.name.fr }] : []),
  ]}
>
  <dl class="figures">
    <div>
      <dt>{p.population}</dt>
      <dd>{n.format(unit.population["2024"].total)}</dd>
    </div>
    {change !== null && (
      <div>
        <dt>{p.change}</dt>
        <dd class:list={[change >= 0 ? "up" : "down"]}>{signed(change)}</dd>
      </div>
    )}
    {unit.population["2024"].households !== null && (
      <div>
        <dt>{p.households}</dt>
        <dd>{n.format(unit.population["2024"].households)}</dd>
      </div>
    )}
    <div>
      <dt>{arrondissements.length > 0 ? p.arrondissements : p.communes}</dt>
      <dd>{n.format(arrondissements.length > 0 ? arrondissements.length : communes.length)}</dd>
    </div>
    {subunits.length > 0 && (
      <div>
        <dt>{p.provinces}</dt>
        <dd>{subunits.length}</dd>
      </div>
    )}
    {area > 0 && (
      <div>
        <dt>{p.area}</dt>
        <dd>{n.format(Math.round(area))} km²</dd>
      </div>
    )}
  </dl>

  {drawing && (
    <section class="pair">
      <div>
        <PlaceMap
          drawing={drawing}
          gapLabel={p.gapLabel}
          label={fill(p.mapLabel, { name: title })}
          classOf={densityClass}
          linkOf={(code) => {
            const c = communeOf.get(code);
            return c ? { href: communeHref(c.slug), name: c.name.fr } : null;
          }}
        />
        <p class="note map-note">{p.mapNote}</p>
      </div>
      <div class="side">
        <Inset {...where} label={fill(p.insetLabel, { name: title })} />
        {standouts.length > 0 && (
          <dl class="standouts">
            {standouts.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd><a href={communeHref(s.commune!.slug)}>{s.commune!.name.fr}</a> <span>{s.value}</span></dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>
  )}

  {census && <People locale={locale} record={census} name={unit.name.fr} />}

  {housing && <Housing locale={locale} record={housing} name={unit.name.fr} />}

  {economy && <Economy locale={locale} record={economy} population={unit.population["2024"].total} />}

  {insights && <Insights locale={locale} record={insights} />}

  {subunits.length > 0 && (
    <section>
      <h2>{p.provinces}</h2>
      <div class="scroll" tabindex="0">
        <table>
          <thead>
            <tr><th>{p.colProvince}</th><th>{p.colType}</th><th class="num">{p.colPopulation}</th><th class="num">{p.colCommunes}</th></tr>
          </thead>
          <tbody>
            {subunits.map((s) => (
              <tr>
                <td><a href={path(locale, `provinces/${s.slug}/`)}>{s.name.fr}</a></td>
                <td>{p.unitTypesLower[s.type]}</td>
                <td class="num">{n.format(s.population["2024"].total)}</td>
                <td class="num">{s.communeCount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {arrondissements.length > 0 && (
    <section>
      <h2>{p.arrondissements}</h2>
      <div class="scroll" tabindex="0">
        <table>
          <thead><tr><th>{p.colArrondissement}</th><th class="num">{p.colPopulation}</th></tr></thead>
          <tbody>
            {arrondissements.map((a) => (
              <tr><td>{a.name.fr}</td><td class="num">{n.format(a.population["2024"].total)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {communes.length > 0 && (
    <section>
      <h2>{p.communes}</h2>
      <div class="scroll" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>{p.colCommune}</th>
              <th>{p.colType}</th>
              <th class="num">{p.colPopulation}</th>
              <th class="num">{p.colChange}</th>
              <th class="num">{p.colDensity}</th>
            </tr>
          </thead>
          <tbody>
            {communes.map((c) => (
              <tr>
                <td><a href={communeHref(c.slug)}>{c.name.fr}</a></td>
                <td>{c.type === "urban" ? p.urban : p.rural}</td>
                <td class="num">{n.format(c.population["2024"].total)}</td>
                <td class:list={["num", c.population.change && (c.population.change.pct >= 0 ? "up" : "down")]}>
                  {c.population.change ? signed(c.population.change.pct) : "—"}
                </td>
                <td class="num">{c.density === null ? "—" : density(locale, c.density)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section>
    <h2>{p.inTheData}</h2>
    <dl class="data">
      <div><dt>{p.code}</dt><dd><code>{unit.code}</code></dd></div>
      <div><dt>{p.codeDigits}</dt><dd><code>{unit.codeDigits}</code></dd></div>
      <div><dt>{p.record}</dt><dd><a href={`${api}.json`}><code>{api}.json</code></a></dd></div>
      {communes.length > 0 && (
        <>
          <div><dt>{p.communes}</dt><dd><a href={`${api}/communes/page/1.json`}><code>{api}/communes/page/1.json</code></a></dd></div>
          <div><dt>{p.boundary}</dt><dd><a href={`${api}/boundary.geojson`}><code>{api}/boundary.geojson</code></a></dd></div>
        </>
      )}
      {census && (
        <div><dt>{p.census}</dt><dd><a href={`${api}/indicators.json`}><code>{api}/indicators.json</code></a></dd></div>
      )}
      {economy && (
        <div><dt>{p.work}</dt><dd><a href={`${api}/economy.json`}><code>{api}/economy.json</code></a></dd></div>
      )}
      {housing && (
        <div><dt>{p.dwellingsTitle}</dt><dd><a href={`${api}/housing.json`}><code>{api}/housing.json</code></a></dd></div>
      )}
      {insights && (
        <div><dt>{p.insightsTitle}</dt><dd><a href={`${api}/insights.json`}><code>{api}/insights.json</code></a></dd></div>
      )}
    </dl>
    <p class="report"><a href={`${REPO_URL}/issues/new?template=data-error.yml&title=${encodeURIComponent(`${title} (${unit.code})`)}`}>{p.report}</a></p>
  </section>
</Place>

<style>
  .map-note {
    margin: 0.5rem 0 0;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .side {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .standouts {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .standouts div {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .standouts dt {
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .standouts dd {
    margin: 0.1rem 0 0;
    font-variant-numeric: tabular-nums;
  }

  .standouts dd span {
    color: var(--quiet);
    margin-inline-start: 0.35rem;
  }

</style>
