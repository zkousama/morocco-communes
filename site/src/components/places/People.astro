---
/**
 * HCP's census figures for a unit, one census at a time: headline figures, the age
 * pyramid, the languages its people use and read, and how they get to work.
 *
 * A unit the 2014 census counted gets both, and a button switches between them. Each chart
 * draws one census and nothing else; what the other one found is under each headline
 * figure, in words.
 */
import { fill, places } from "../../i18n/places";
import { path, type Locale } from "../../i18n/ui";
import { numbers, percent } from "../../lib/format";
import { figure, national, type Census, type IndicatorRecord, type Topics } from "../../lib/indicators";

interface Props {
  locale: Locale;
  record: IndicatorRecord;
  name: string;
}
const { locale, record, name } = Astro.props;
const p = places[locale];

// Each figure at the precision HCP publishes it: shares to one decimal, fertility to two.
const share = (v: number) => percent(locale, v, { fixed: true });
const pct = (v: number | null) => (v === null ? "—" : share(v));
const two = numbers(locale, 2, true);
const one = numbers(locale, 1, true);

// Oldest at the top, as a pyramid is read.
const BANDS = ["75+", "70-74", "65-69", "60-64", "55-59", "50-54", "45-49", "40-44", "35-39", "30-34", "25-29", "20-24", "15-19", "10-14", "5-9", "0-4"];
const band = (key: string) => (key.endsWith("+") ? fill(p.over, { n: key.slice(0, -1) }) : key.replace("-", "–"));

const names = p.languageNames as Record<string, string>;
const commuteNames = p.commuteNames as Record<string, string>;
const combinationNames = p.combinationNames as Record<string, string>;
const workplaceNames = p.workplaceNames as Record<string, string>;
const professionNames = p.professionNames as Record<string, string>;
const diplomaNames = p.diplomaNames as Record<string, string>;
const PROFESSIONS = ["managersAndProfessionals", "technicians", "clerks", "traders", "farmers", "artisans", "farmLabourers", "machineOperators", "labourers", "unclassified"];
const DIPLOMAS = ["none", "primary", "lowerSecondary", "upperSecondary", "bachelor", "masterOrDoctorate", "undeclared"];
// The 2014 workbook's 8 answers for where people work, "undetermined" included.
const WORKPLACES = ["ownNeighbourhood", "otherNeighbourhood", "otherCommune", "otherProvince", "noFixedPlace", "atHome", "elsewhere", "undetermined"];
// Every mode either census asks about: 2024 has 12, 2014 has 11, and the two overlap on 8.
const MODES = [
  "walking", "bikeOrMotorcycle", "privateCar", "bus", "taxi", "employerTransport", "train", "tram",
  "informalTransport", "animal", "other", "noTravel", "worksAtHome", "undetermined",
];

interface Figure {
  label: string;
  value: string | null;
  note: string;
  beside: string[];
}
interface Bar {
  key: string;
  label: string;
  value: number;
}

/** One census's figures for this unit, and the same figures at the other census. */
function view(census: Census, other: Census | null, year: "2024" | "2014") {
  const all = census.people.total?.all;
  const men = census.people.total?.male;
  const women = census.people.total?.female;
  const homes = census.households.total;
  const otherAll = other?.people.total?.all ?? null;
  const otherHomes = other?.households.total ?? null;
  const countryCensus = year === "2024" ? national : national["2014"];
  const country = countryCensus?.people.total?.all ?? null;
  const countryHomes = countryCensus?.households.total ?? null;
  const elsewhere = year === "2024" ? p.since2014 : p.since2024;

  const headline = (
    label: string,
    key: string,
    note: string,
    opts: { women?: boolean; format?: (v: number) => string; homes?: boolean } = {},
  ): Figure => {
    const source = opts.homes ? homes : all;
    const value = figure(source, key);
    const show = opts.format ?? share;
    const theirs = opts.women ? figure(women, key) : null;
    const countryValue = figure(opts.homes ? countryHomes : country, key);
    const then = figure(opts.homes ? otherHomes : otherAll, key);
    const beside = [
      then !== null ? fill(elsewhere, { v: show(then) }) : null,
      theirs !== null ? fill(p.womenFigure, { v: show(theirs) }) : null,
      record.level !== "country" && countryValue !== null ? fill(p.moroccoFigure, { v: show(countryValue) }) : null,
    ].filter(Boolean);
    return { label, value: value === null ? null : show(value), note, beside: beside as string[] };
  };

  const figures = [
    headline(p.illiteracy, "illiteracy.rate10Plus", p.illiteracyNote, { women: true }),
    headline(p.unemployment, "labour.unemploymentRate", "", { women: true }),
    headline(p.labourForce, "labour.activityRate", p.labourForceNote, { women: true }),
    year === "2024"
      ? headline(p.schooling, "schooling.rate6to11", p.schoolingNote)
      : headline(p.schooling7to12, "schooling.rate7to12", ""),
    headline(p.fertility, "fertility.totalFertilityRate", p.fertilityNote, { format: (v) => two.format(v) }),
    headline(p.disability, "disability.prevalence", p.disabilityNote),
    headline(p.householdSize, "households.averageSize", p.householdSizeNote, { homes: true, format: (v) => one.format(v) }),
    headline(p.runningWater, "amenities.runningWater", p.runningWaterNote, { homes: true }),
  ].filter((h) => h.value !== null);

  const ages = BANDS.map((key) => ({
    key,
    men: figure(men, `age.${key}`),
    women: figure(women, `age.${key}`),
    menOther: figure(other?.people.total?.male, `age.${key}`),
    womenOther: figure(other?.people.total?.female, `age.${key}`),
  }));

  const bars = (topic: string, keys: string[], labels: Record<string, string>) => {
    const rows = keys
      .map((key) => ({ key, label: labels[key] ?? key, value: figure(all, `${topic}.${key}`) }))
      .filter((b): b is Bar => b.value !== null);
    // A census that found nobody in a commune publishes every share as 0, which draws a
    // block of empty bars. Nothing there is worth a chart.
    if (!rows.some((b) => b.value > 0)) return [];
    return rows.sort((a, b) => b.value - a.value);
  };

  return {
    year,
    figures,
    ages,
    used: bars("localLanguages", ["darija", "tachelhit", "tamazight", "tarifit", "hassania"], names),
    read:
      year === "2024"
        ? bars("languagesReadAndWritten", ["arabic", "french", "english", "amazighTifinagh"], names)
        : bars("languageCombinations", ["arabicOnly", "arabicAndFrench", "arabicFrenchEnglish", "other"], combinationNames),
    readBody: year === "2024" ? p.languagesReadBody : p.combinationsBody,
    commute: bars("commute", MODES, commuteNames),
    workplace: year === "2014" ? bars("workplace", WORKPLACES, workplaceNames) : [],
    // The 2014 census is the only one that publishes these by commune.
    profession: year === "2014" ? bars("profession", PROFESSIONS, professionNames) : [],
    diploma: year === "2014" ? bars("diploma", DIPLOMAS, diplomaNames) : [],
  };
}

const before = record["2014"];
/** A census with nothing to draw for this unit: no figures, no ages, no bars. */
const holds = (v: ReturnType<typeof view>) =>
  v.figures.length > 0 ||
  v.ages.some((r) => r.men !== null || r.women !== null) ||
  [v.used, v.read, v.commute, v.workplace, v.profession, v.diploma].some((rows) => rows.length > 0);
const views = [view(record, before, "2024"), ...(before ? [view(before, record, "2014")] : [])].filter(holds);
const both = views.length > 1;

/**
 * A census's topics, in the order HCP asks them, with the empty ones dropped. 2024 has 3
 * and 2014 has 6, so the layout places them by count rather than by name.
 */
const topicsOf = (v: ReturnType<typeof view>) =>
  [
    { heading: p.languagesUsed, body: p.languagesUsedBody, rows: v.used },
    { heading: p.languagesRead, body: v.readBody, rows: v.read },
    { heading: p.commute, body: p.commuteBody, rows: v.commute },
    { heading: p.workplace, body: p.workplaceBody, rows: v.workplace },
    { heading: p.profession, body: p.professionBody, rows: v.profession },
    { heading: p.diploma, body: p.diplomaBody, rows: v.diploma },
  ].filter((block) => block.rows.length > 0);

// One scale for the pyramid, so a band's bar means the same width in either census.
const widest = Math.max(
  0,
  ...views.flatMap((v) => v.ages.flatMap((r) => [r.men ?? 0, r.women ?? 0, r.menOther ?? 0, r.womenOther ?? 0])),
);
const hasAges = widest > 0;
const width = (v: number | null) => `${((v ?? 0) / widest) * 100}%`;
const other = (year: string) => (year === "2024" ? "2014" : "2024");
const empty = views.length === 0;
---

<section class="people" data-census="2024">
  <h2>{p.people}</h2>
  {empty ? (
    <p>{fill(p.peopleLocal, { name })}</p>
  ) : (
    <>
      <div class="intro">
        <p>
          {record.fromLocalAdministration ? fill(p.peopleLocal, { name }) : p.peopleBody}{" "}
          <a href={path(locale, "docs/indicators/")}>{p.peopleMore}</a>{" · "}
          <a href={path(locale, "docs/glossary/#people")}>{p.glossary}</a>
        </p>
        {/* Hidden until the script that makes them work has run. */}
        {both && (
          <div class="years" role="group" aria-label={p.censusGroup} hidden>
            <span aria-hidden="true">{p.censusGroup}</span>
            {views.map((v, i) => (
              <button type="button" data-year={v.year} aria-pressed={i === 0 ? "true" : "false"}>{v.year}</button>
            ))}
          </div>
        )}
      </div>

      {views.map((v, i) => (
        <div class="census" data-year={v.year} hidden={i !== 0}>
          {v.figures.length > 0 && (
            <dl class="figures">
              {v.figures.map((h) => (
                <div>
                  <dt>{h.label}</dt>
                  <dd>
                    {h.value}
                    {h.note && <small>{h.note}</small>}
                    {h.beside.map((line) => <small>{line}</small>)}
                  </dd>
                </div>
              ))}
            </dl>
          )}

          <div class="top">
            {hasAges && (
              <div class="block">
                <h3>{p.age}</h3>
                <p class="note">{p.ageBody}</p>
                <table class="pyramid">
                  <caption class="sr-only">{fill(p.ageCaption, { name })}</caption>
                  <colgroup>
                    <col class="value" />
                    <col />
                    <col class="ages" />
                    <col />
                    <col class="value" />
                  </colgroup>
                  <thead>
                    <tr>
                      <th scope="col" class="men" colspan="2">{p.men}</th>
                      <th scope="col"><span class="sr-only">{p.age}</span></th>
                      <th scope="col" class="women" colspan="2">{p.women}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {v.ages.map((r) => (
                      <tr>
                        <td class="value men">{pct(r.men)}</td>
                        <td class="men">
                          <span class="bar" style={`--w: ${width(r.men)}`} />
                        </td>
                        <th scope="row">{band(r.key)}</th>
                        <td class="women">
                          <span class="bar" style={`--w: ${width(r.women)}`} />
                        </td>
                        <td class="value women">{pct(r.women)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {topicsOf(v).slice(0, hasAges ? 1 : 2).map((block) => (
              <div class="block">
                <h3>{block.heading}</h3>
                <p class="note">{block.body}</p>
                <ul class="bars">
                  {block.rows.map((b) => (
                    <li>
                      <span class="label">{b.label}</span>
                      <span class="track"><span class="bar" style={`--w: ${b.value}%`} /></span>
                      <span class="value">{pct(b.value)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          {topicsOf(v).length > (hasAges ? 1 : 2) && (
            <div class="spread">
              {topicsOf(v).slice(hasAges ? 1 : 2).map((block) => (
                <div class="block">
                <h3>{block.heading}</h3>
                <p class="note">{block.body}</p>
                <ul class="bars">
                  {block.rows.map((b) => (
                    <li>
                      <span class="label">{b.label}</span>
                      <span class="track"><span class="bar" style={`--w: ${b.value}%`} /></span>
                      <span class="value">{pct(b.value)}</span>
                    </li>
                  ))}
                </ul>
              </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </>
  )}
</section>

{both && (
  <script>
    // One section to a page: the buttons show the census they name and hide the other.
    const section = document.querySelector<HTMLElement>(".people[data-census]");
    const years = section?.querySelector<HTMLElement>(".years");
    if (years) years.hidden = false;
    years?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-year]");
      if (!button) return;
      const year = button.dataset.year!;
      section.dataset.census = year;
      for (const other of section.querySelectorAll<HTMLButtonElement>(".years button")) {
        other.setAttribute("aria-pressed", String(other === button));
      }
      for (const block of section.querySelectorAll<HTMLElement>(".census")) {
        block.hidden = block.dataset.year !== year;
      }
    });
  </script>
)}

<style>
  h3 {
    font-size: var(--t-sm);
    font-weight: 500;
    margin: 0 0 0.2rem;
  }

  /* The blocks fill both columns and the browser levels them, so the section ends on a
     straight edge however many topics a census has: 4 in 2024, 7 in 2014. A 2-column grid
     would leave whichever column is shorter as a hole down the page. */
  /* The pyramid with the first topic beside it, then the rest filling both columns. The
     browser levels a column flow, so the section ends on a straight edge however many
     topics a census has: 3 in 2024, 6 in 2014. */
  .top {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    margin-top: 1.75rem;
  }

  .spread {
    columns: 2;
    column-gap: clamp(1.5rem, 4vw, 3rem);
  }

  .block {
    break-inside: avoid;
    padding-bottom: 1.75rem;
  }

  @media (max-width: 48rem) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }

    .spread {
      columns: 1;
    }
  }

  .note {
    margin: 0 0 0.75rem;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  /* The years sit beside the section's own line, on the right, out of the reading column. */
  .intro {
    display: flex;
    gap: 1.5rem;
    align-items: start;
    justify-content: space-between;
  }

  .intro p {
    margin: 0;
    max-width: var(--measure);
  }

  /* display: flex would otherwise beat the hidden attribute the script clears. */
  .years[hidden] {
    display: none;
  }

  .years {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    flex: none;
  }

  .years > span {
    margin-inline-end: 0.15rem;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .years button {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: none;
    color: var(--quiet);
    font: inherit;
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .years button[aria-pressed="true"] {
    border-color: var(--ink);
    color: var(--ink);
  }

  .years button:hover {
    color: var(--ink);
  }

  /* Spread edge to edge like the home page's counts: 4 columns sized to what they hold,
     the first on the left margin and the last on the right, lined up across both rows.
     A rule above and below rather than under each figure, which spreading would break
     into dashes. */
  .people .figures {
    margin-top: 1.25rem;
    grid-template-columns: repeat(4, max-content);
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .people .figures > div {
    padding: 1rem 0 0;
    border-bottom: 0;
  }

  .people .figures dd small + small {
    margin-top: 0.1rem;
  }

  @media (max-width: 60rem) {
    .people .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: stretch;
    }

    .intro {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  /* The pyramid: a table, so it reads as one, with each share drawn as a bar out from the
     ages in the middle. The numbers show on hover. A fixed layout gives both sides the same
     width; left to the automatic one, a side grew with its heading, and "Women" is longer
     than "Men". */
  .pyramid {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
  }

  .pyramid th,
  .pyramid td {
    padding: 0;
    border: 0;
    height: 1.15rem;
  }

  .pyramid thead th {
    padding-bottom: 0.4rem;
    font-weight: 500;
    color: var(--ink);
  }

  .pyramid thead .men {
    text-align: end;
  }

  .pyramid thead .women {
    text-align: start;
  }

  .pyramid .ages {
    width: 6.5rem;
  }

  /* Wide enough for "100,0 %", the longest a share gets. */
  .pyramid col.value {
    width: 2.9rem;
  }

  .pyramid tbody th {
    padding: 0 0.6rem;
    text-align: center;
    font-weight: 400;
    color: var(--quiet);
    white-space: nowrap;
  }

  .pyramid td {
    position: relative;
  }

  .pyramid td .bar {
    position: absolute;
    top: 2px;
    bottom: 2px;
    width: var(--w);
  }

  .pyramid td.men .bar {
    right: 0;
    background: var(--seq-1);
    border-radius: 3px 0 0 3px;
  }

  .pyramid td.women .bar {
    left: 0;
    background: var(--seq-4);
    border-radius: 0 3px 3px 0;
  }

  /* Its own column outside the bar, so a long bar never draws under it: on the page
     ground rather than the bar's fill, the value reads at full contrast in either theme. */
  .pyramid td.value {
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.12s;
  }

  .pyramid td.value.men {
    text-align: end;
    padding-inline-end: 0.4rem;
  }

  .pyramid td.value.women {
    text-align: start;
    padding-inline-start: 0.4rem;
  }

  .pyramid tbody tr:hover .value {
    opacity: 1;
  }

  .pyramid tbody tr:hover th {
    color: var(--ink);
  }

</style>
