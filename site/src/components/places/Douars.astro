---
/**
 * A commune's douars, the villages and hamlets of its rural part, as the 2024 census counted
 * them: one table, a group of rows per fraction, each douar with its kind, its households
 * and people, and how far its homes are from a paved road, a primary school and a health
 * centre. The other figures HCP gives a douar are in the API and the downloads.
 *
 * HCP withholds a douar's figures under 30 households, so those rows show a dash, and say
 * why under the table. Rows past the first few fold away once the script runs; without it,
 * every row shows.
 *
 * A douar no source names in Latin shows its spelling from the Arabic, in italics, and can
 * take a visitor's spelling: the form under the table sends it to /api/douar-suggestions,
 * and the names visitors have had accepted since the page was built are laid over it live
 * from /api/communes/{code}/douar-names. Without the script, the form stays hidden.
 */
import { de, fill, places } from "../../i18n/places";
import { path, type Locale } from "../../i18n/ui";
import { counted as countedIn, numbers, type Forms } from "../../lib/format";
import { fractionLatinOf, latinOf, type Fraction } from "../../lib/douars";

interface Props {
  locale: Locale;
  /** The commune's code, which its accepted names are asked for under. */
  code: string;
  fractions: Fraction[];
  name: string;
  /** A commune the census counts as urban, whose douars are its rural part. */
  urban: boolean;
}
const { locale, code, fractions, name, urban } = Astro.props;
const p = places[locale];
const n = numbers(locale);
const km = numbers(locale, 1, true);

/** Rows shown before the fold, counting douars across fractions. */
const SHOWN = 12;
const total = fractions.reduce((sum, f) => sum + f.rows.length, 0);
const people = fractions.reduce((sum, f) => sum + f.population, 0);
const kinds = p.douarKinds as Record<string, string>;
const labels = p.fractionLabels as Record<string, string>;
const counted = (forms: Forms, v: number) => countedIn(locale, forms, v);
const distance = (v: number | null | undefined) => (v === null || v === undefined ? "—" : km.format(v));
const withheld = fractions.some((f) => f.rows.some((d) => d.topics === null));
// The douars a visitor can name: the ones spelt from the Arabic.
const open = fractions.flatMap((f) => f.rows).filter((d) => latinOf(d).spelt);

// Each fraction's place in the count, so a fraction whose rows all fall past the fold folds too.
let seen = 0;
const groups = fractions.map((f) => {
  const start = seen;
  seen += f.rows.length;
  return { ...f, start };
});
---

<section class="douars" id="douars">
  <h2>{p.douars}</h2>
  <p>
    {fill(urban ? p.douarsBodyUrban : p.douarsBody, {
      name,
      ofName: de(name),
      douars: counted(p.douarCount, total),
      fractions: counted(p.fractionCount, fractions.length),
      people: n.format(people),
    })}
    {" "}<a href={path(locale, "docs/indicators/#douars")}>{p.douarsMore}</a>
  </p>
  <div class="scroll" tabindex="0">
    <table class="douar-table">
      <thead>
        <tr>
          <th rowspan="2" scope="col">{p.colDouar}</th>
          <th rowspan="2" scope="col">{p.colKind}</th>
          <th rowspan="2" scope="col" class="num">{p.colHouseholds}</th>
          <th rowspan="2" scope="col" class="num">{p.colPeople}</th>
          <th colspan="3" scope="colgroup" class="num span">{p.colDistance}</th>
        </tr>
        <tr>
          <th scope="col" class="num">{p.colPavedRoad}</th>
          <th scope="col" class="num">{p.colSchool}</th>
          <th scope="col" class="num">{p.colHealth}</th>
        </tr>
      </thead>
      {groups.map((f) => (
        <tbody>
          <tr class:list={["fraction", { later: f.start >= SHOWN }]}>
            <th colspan="7" scope="rowgroup">
              <span lang="ar" dir="rtl">{f.name.ar}</span>
              {f.label ? (
                <span class="fraction-latin">{labels[f.label]}</span>
              ) : (
                <span class:list={["fraction-latin", { spelt: fractionLatinOf(f)!.spelt }]}>{fractionLatinOf(f)!.name}</span>
              )}
              <span class="sum">{fill(p.douarsFraction, { douars: counted(p.douarCount, f.rows.length), people: n.format(f.population) })}</span>
            </th>
          </tr>
          {f.rows.map((d, i) => (
            <tr id={`douar-${d.code}`} class:list={{ later: f.start + i >= SHOWN }}>
              <td>
                <span lang="ar" dir="rtl">{d.name.ar}</span>
                <span class:list={["latin", { spelt: latinOf(d).spelt }]}>
                  {latinOf(d).name}{latinOf(d).source === "visitors" && <span class="by">{p.douarsSuggested}</span>}
                </span>
              </td>
              <td>{kinds[d.type] ?? d.type}</td>
              <td class="num">{n.format(d.households)}</td>
              <td class="num">{n.format(d.population)}</td>
              <td class="num">{distance(d.topics?.distanceKm?.pavedRoad)}</td>
              <td class="num">{distance(d.topics?.distanceKm?.primarySchool)}</td>
              <td class="num">{distance(d.topics?.distanceKm?.healthCentre)}</td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
  {total > SHOWN && (
    <button type="button" class="douars-more" hidden aria-expanded="false" data-all={fill(p.douarsAll, { n: n.format(total) })} data-fewer={p.douarsFewer}>
      {fill(p.douarsAll, { n: n.format(total) })}
    </button>
  )}
  <p class="note">{p.douarsLatin} <a href={path(locale, "docs/names/")}>{p.douarsNamed}</a></p>
  {withheld && <p class="note">{p.douarsWithheld}</p>}
  {open.length > 0 && (
    <form class="suggest" hidden data-code={code} data-by={p.douarsSuggested}
      data-counted={p.suggestCounted} data-named={p.suggestNamed}
      data-mismatch={p.suggestMismatch} data-limit={p.suggestLimit} data-invalid={p.suggestInvalid} data-failed={p.suggestFailed}>
      <p class="suggest-ask">{p.suggestAsk}</p>
      <div class="suggest-fields">
        <label>
          <span>{p.suggestDouar}</span>
          <select name="douar" required>
            {open.map((d) => (
              <option value={d.code} data-latin={latinOf(d).name} data-ar={d.name.ar}>{latinOf(d).name} · {d.name.ar}</option>
            ))}
          </select>
        </label>
        <label>
          <span>{p.suggestName}</span>
          <input name="name" type="text" required minlength="2" maxlength="60" autocomplete="off" spellcheck="false" lang="fr" />
        </label>
        <button type="submit">{p.suggestSend}</button>
      </div>
      <p class="suggest-status" aria-live="polite"></p>
    </form>
  )}
</section>

<script>
  import { listbox } from "../../lib/listbox";
  for (const table of document.querySelectorAll<HTMLTableElement>(".douar-table")) {
    const more = table.closest("section")?.querySelector<HTMLButtonElement>(".douars-more");
    if (!more) continue;
    let expanded = false;
    const paint = () => {
      table.classList.toggle("folded", !expanded);
      more.setAttribute("aria-expanded", String(expanded));
      more.textContent = (expanded ? more.dataset.fewer : more.dataset.all) ?? "";
    };
    more.hidden = false;
    more.addEventListener("click", () => {
      expanded = !expanded;
      paint();
    });
    // A link to one douar, from the douars page, opens the fold if the douar is under it.
    const target = location.hash.startsWith("#douar-") ? table.querySelector<HTMLElement>(location.hash) : null;
    if (target?.classList.contains("later")) expanded = true;
    paint();
    target?.scrollIntoView({ block: "center" });
  }

  // Visitors' names: laid over the built page once accepted, and sent from the form.
  const form = document.querySelector<HTMLFormElement>("form.suggest");
  if (form) {
    const d = form.dataset;
    const select = form.querySelector<HTMLSelectElement>("select")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const status = form.querySelector<HTMLElement>(".suggest-status")!;
    // The page's own list over the select: each douar's Latin name, its Arabic beside it.
    listbox(select, (option) => {
      const line = document.createElement("span");
      line.className = "lb-douar";
      const latin = document.createElement("span");
      latin.textContent = option.dataset.latin ?? option.text;
      const arabic = document.createElement("span");
      arabic.lang = "ar";
      arabic.dir = "rtl";
      arabic.className = "lb-ar";
      arabic.textContent = option.dataset.ar ?? "";
      line.append(latin, arabic);
      return line;
    });
    const name = (douar: string, text: string) => {
      const latin = document.querySelector<HTMLElement>(`#douar-${douar} .latin`);
      if (latin) {
        latin.classList.remove("spelt");
        latin.textContent = text;
        const by = document.createElement("span");
        by.className = "by";
        by.textContent = d.by ?? "";
        latin.append(by);
      }
      select.querySelector(`option[value="${douar}"]`)?.remove();
      if (select.options.length === 0) form.hidden = true;
    };
    fetch(`/api/communes/${d.code}/douar-names`)
      .then((r) => (r.ok ? r.json() : null))
      .then((body: { data?: { names?: Record<string, string> } } | null) => {
        for (const [douar, text] of Object.entries(body?.data?.names ?? {})) name(douar, text);
      })
      .catch(() => undefined);
    form.hidden = select.options.length === 0;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = "";
      const douar = select.value;
      try {
        const response = await fetch("/api/douar-suggestions", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ douar, name: input.value }),
        });
        const body = (await response.json().catch(() => ({}))) as { status?: string; name?: string };
        const said: Record<string, string | undefined> = {
          counted: d.counted, named: d.named, mismatch: d.mismatch, limit: d.limit, invalid: d.invalid,
        };
        status.textContent = said[body.status ?? ""] ?? d.failed ?? "";
        if (body.status === "counted") input.value = "";
      } catch {
        status.textContent = d.failed ?? "";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .douar-table thead .span {
    text-align: center;
    border-bottom: 1px solid var(--rule);
  }

  /* A name on one line: an Arabic name broken across lines in a narrow column reads as 2. */
  .douar-table td:first-child {
    white-space: nowrap;
  }

  .douar-table .latin {
    display: block;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .douar-table .latin.spelt {
    font-style: italic;
  }

  .douar-table .fraction th {
    padding-top: 1rem;
    text-align: start;
    font-weight: 600;
  }

  .douar-table tbody:first-of-type .fraction th {
    padding-top: 0.5rem;
  }

  .douar-table .fraction-latin {
    margin-inline-start: 0.6rem;
    font-weight: 400;
  }

  .douar-table .fraction-latin.spelt {
    font-style: italic;
  }

  .douar-table .sum {
    margin-inline-start: 0.75rem;
    color: var(--quiet);
    font-size: var(--t-xs);
    font-weight: 400;
  }

  .douar-table.folded .later {
    display: none;
  }

  .douar-table tr:target td {
    background: var(--well);
  }

  .douars-more {
    margin: 1rem 0 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--quiet);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  .douars-more:hover {
    color: var(--ink);
  }

  .douars-more[hidden] {
    display: none;
  }

  .note {
    margin-top: 0.75rem;
    color: var(--quiet);
    font-size: var(--t-xs);
  }

  .douar-table .by,
  .douar-table :global(.by) {
    margin-inline-start: 0.4rem;
    font-style: normal;
    opacity: 0.8;
  }

  .douar-table :global(.by)::before,
  .douar-table .by::before {
    content: "· ";
  }

  .suggest {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .suggest[hidden] {
    display: none;
  }

  .suggest-ask {
    margin: 0 0 0.75rem;
    font-size: var(--t-sm);
  }

  .suggest-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: end;
  }

  .suggest label {
    display: grid;
    gap: 0.3rem;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .suggest select,
  .suggest input {
    min-width: min(100%, 14rem);
    max-width: 100%;
    font-size: var(--t-sm);
  }

  /* The douar list (lib/listbox.ts): the Latin name, then the Arabic in grey at the far end. */
  .suggest :global(.lb) {
    min-width: min(100%, 18rem);
    font-size: var(--t-sm);
  }

  .suggest :global(.lb-douar) {
    display: flex;
    flex: 1;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    min-width: 0;
  }

  .suggest :global(.lb-button .lb-douar span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggest :global(.lb-ar) {
    font-family: var(--sans);
    color: var(--quiet);
    font-weight: 400;
  }

  /* A pill, as the site's other buttons are, as tall as the fields beside it. */
  .suggest button {
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-size: var(--t-sm);
    cursor: pointer;
  }

  .suggest button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .suggest-status {
    min-height: 1.4em;
    margin: 0.6rem 0 0;
    font-size: var(--t-sm);
    color: var(--quiet);
  }
</style>
