---
/**
 * A commune's figures that stand out, as the insights pipeline published them in
 * data/v1/insights/, each with the communes it borders and 2014 set beside it. Every word
 * is the site's own and every number the censuses'; the lines are worked out in
 * lib/insights.ts, and a line with nothing to say is left out.
 *
 * A commune with nothing published has no file, and no section.
 */
import { fill, places } from "../../i18n/places";
import { path, type Locale } from "../../i18n/ui";
import { percent } from "../../lib/format";
import { nearLine, since2014Line } from "../../lib/insights";
import { pageOf } from "../../lib/places";
import type { CommuneFile } from "../../../../insights/src/run.ts";

interface Props {
  locale: Locale;
  record: CommuneFile;
}
const { locale, record } = Astro.props;
const p = places[locale];
const share = (v: number) => percent(locale, v, { fixed: true });
---

<section class="insights">
  <h2>{p.insightsTitle}</h2>
  <p>{p.insightsBody}</p>

  {record.findings.map((f) => {
    const near = nearLine(locale, f);
    const nearPage = near && pageOf(near.code);
    const since = since2014Line(locale, f);
    return (
      <div class="finding">
        <p class="line">{f.line[locale]}</p>
        {f.sampled && (
          <p class="note">
            <a href={`${path(locale, "docs/indicators/")}#reading`}>{p.insightsSample}</a>
          </p>
        )}
        {f.breakdown && (
          <p class="note">
            {fill(p.insightsMadeOf, { parts: f.breakdown.map((b) => `${b.label[locale]} ${share(b.value)}`).join(" · ") })}
          </p>
        )}
        {near && (
          <p class="context">
            {near.before}{nearPage ? <a href={path(locale, nearPage.route)}>{near.name}</a> : near.name}{near.after}
          </p>
        )}
        {since && <p class="context">{since}</p>}
      </div>
    );
  })}

  <p class="more">
    <a href={path(locale, "docs/insights/")}>{p.insightsMore}</a>
  </p>
</section>

<style>
  .finding {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    max-width: 68ch;
  }

  .line {
    margin: 0;
  }

  .note {
    margin: 0.35rem 0 0;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .context {
    margin: 0.35rem 0 0;
    font-size: var(--t-sm);
    color: var(--quiet);
  }

  .more {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: var(--t-xs);
  }

  .more a {
    color: var(--quiet);
  }
</style>
