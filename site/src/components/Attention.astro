---
/**
 * What people have opened most in the last 30 days, from the demand log's nightly
 * rollup. The ranking can name any level a page reports: a commune, a province, a région,
 * or an arrondissement, whose link goes to its city's page, the way the search box already
 * sends it there. A code the dataset no longer has, or that never had a page, is dropped
 * rather than shown broken.
 *
 * The list is built in, and the page then asks the API for last night's, so it doesn't
 * wait for a deploy to change.
 */
import Base from "../layouts/Base.astro";
import { attention, since } from "../generated/attention.ts";
import { pageOf } from "../lib/places";
import { path, t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const n = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-GB");

const rows = attention
  .map((row) => {
    const unit = pageOf(row.code);
    return unit ? { n: row.n, name: unit.name.fr, href: path(locale, unit.route) } : null;
  })
  .filter((row) => row !== null);
---

{/* Off the menus and out of the sitemap: its address still works, and search engines are asked
    not to list it. Its ranking still gives the search box its suggestions. */}
<Base locale={locale} route="most-looked-up/" title={copy.attention} description={copy.attentionBody} current={false}>
  <article class="page" data-base={path(locale)} data-locale={locale}>
    <h1>{copy.attention}</h1>
    <p class="lede">{copy.attentionBody}</p>
    <p class="empty" hidden={rows.length > 0}>{copy.attentionEmpty}</p>
    <ol class="ranking" hidden={rows.length === 0}>
      {rows.map((row) => (
        <li>
          <a href={row.href}>{row.name}</a>
          <span class="num">{n.format(row.n)}</span>
        </li>
      ))}
    </ol>
    <p class="note">{copy.attentionSince} <span class="since">{since}</span></p>
  </article>
</Base>

<script>
  interface Place {
    name: string;
    route: string;
    n: number;
  }

  // Last night's ranking in place of the one built in. Without an answer, the built one stays.
  const page = document.querySelector<HTMLElement>("article.page[data-base]");
  const list = page?.querySelector<HTMLOListElement>(".ranking");
  const empty = page?.querySelector<HTMLElement>(".empty");
  const since = page?.querySelector<HTMLElement>(".since");
  if (page && list && empty && since) {
    fetch("/api/most-looked-up")
      .then((response) => (response.ok ? response.json() : null))
      .then((body: { data?: { since?: string; places?: Place[] } } | null) => {
        const places = body?.data?.places;
        if (!Array.isArray(places)) return;
        const n = new Intl.NumberFormat(page.dataset.locale === "fr" ? "fr-FR" : "en-GB");
        list.replaceChildren(
          ...places.map((place) => {
            const item = document.createElement("li");
            const link = document.createElement("a");
            link.href = `${page.dataset.base}${place.route}`;
            link.textContent = place.name;
            const count = document.createElement("span");
            count.className = "num";
            count.textContent = n.format(place.n);
            item.append(link, count);
            return item;
          }),
        );
        list.hidden = places.length === 0;
        empty.hidden = places.length > 0;
        if (body?.data?.since) since.textContent = body.data.since;
      })
      .catch(() => {});
  }
</script>

<style>
  .page {
    padding-block: clamp(2rem, 6vw, 4rem);
    max-width: 40rem;
  }

  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(var(--t-lg), 5vw, var(--t-xl));
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .lede {
    color: var(--quiet);
    font-size: var(--t-md);
    max-width: 42ch;
  }

  .ranking {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
  }

  /* Global inside the list, since the rows the script writes carry no scoped attribute. */
  .ranking :global(li) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .ranking :global(li:first-child) {
    border-top: 1px solid var(--rule);
  }

  .ranking :global(a) {
    text-decoration: none;
  }

  .ranking :global(a:hover) {
    color: var(--brass);
  }

  .ranking :global(.num) {
    color: var(--quiet);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .note {
    color: var(--quiet);
    font-size: var(--t-sm);
  }
</style>
