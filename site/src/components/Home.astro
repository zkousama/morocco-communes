---
import Base from "../layouts/Base.astro";
import Beacon from "./Beacon.astro";
import Playground, { PLAYGROUND_KEYS } from "./Playground.tsx";
import Charts from "./Charts.astro";
import Atlas from "./Map.astro";
import { AUTHOR, COUNTED, REPO_URL, path, t, type Locale } from "../i18n/ui";
import { INTL } from "../lib/intl";
import { counts } from "../generated/hierarchy";
import { downloads } from "../generated/downloads";
import { reference } from "../generated/reference";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const counted = COUNTED[locale];
// The island's props are written into the page, so it gets its own strings, not all of them.
const playgroundCopy = Object.fromEntries(PLAYGROUND_KEYS.map((key) => [key, copy[key]])) as Record<
  (typeof PLAYGROUND_KEYS)[number],
  string
>;

// French groups thousands with a thin space, English with a comma.
const group = new Intl.NumberFormat(INTL[locale]);

const ways = [
  { route: "docs/api/", name: copy.navApi, text: copy.useApi },
  { route: "docs/mcp/", name: copy.navMcp, text: copy.useMcp },
  { route: "docs/components/", name: copy.navComponents, text: copy.useComponents },
  { route: "docs/npm/", name: copy.navNpm, text: copy.useNpm },
  { route: "docs/python/", name: copy.navPython, text: copy.usePython },
  { route: "docs/downloads/", name: copy.navDownloads, text: copy.useDownloads },
];

// What Google Dataset Search reads. It needs absolute URLs, so it's only written when the
// deployed origin is known, and only on the English page, so the dataset is listed once.
const site = Astro.site;
const n = new Intl.NumberFormat("en-GB");
const dataset =
  site && locale === "en"
    ? {
        "@context": "https://schema.org",
        "@type": "Dataset",
        name: "Morocco communes",
        description:
          `Morocco's ${counts.regions} régions, ${counts.provinces} provinces and préfectures, ${counts.cercles} cercles, ` +
          `${n.format(counts.communes)} communes and ${counts.arrondissements} arrondissements, with official HCP ` +
          "geographic codes, names in French and Arabic, population from the 2014 and 2024 censuses, the 2024 count " +
          "of economic establishments, and commune boundaries from OpenStreetMap.",
        url: new URL("/", site).href,
        sameAs: REPO_URL,
        version: reference.version,
        isAccessibleForFree: true,
        // HCP's tables are on CC BY 4.0 terms and the OpenStreetMap boundaries are ODbL,
        // as the README's table of directories says.
        license: ["https://creativecommons.org/licenses/by/4.0/", "https://opendatacommons.org/licenses/odbl/1-0/"],
        creator: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
        creditText: "Haut-Commissariat au Plan, RGPH 2024 and RGPH 2014. Boundaries © OpenStreetMap contributors, ODbL.",
        keywords: ["Morocco", "Maroc", "communes", "régions", "provinces", "census", "RGPH 2024", "HCP", "establishments"],
        spatialCoverage: { "@type": "Place", name: "Morocco" },
        temporalCoverage: "2014/2024",
        distribution: downloads.flatMap((g) =>
          g.files.map((f) => ({
            "@type": "DataDownload",
            name: `${copy[g.key as keyof typeof copy]}: ${f.label}`,
            encodingFormat: f.href.endsWith(".csv") ? "text/csv" : f.href.endsWith(".geojson") ? "application/geo+json" : "application/json",
            contentUrl: new URL(f.href, site).href,
          })),
        ),
      }
    : null;
---

<Base locale={locale}>
  {/* Search Console's proof that the site is Ousama's. It only reads the home page. */}
  <meta slot="head" name="google-site-verification" content="L222F8aGhOhS6v0FmK1h4pw6Y_4J2Pfwukw4wfiEE6c" />
  {dataset && <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(dataset)} />}
  <Beacon locale={locale} />
  <section class="hero">
    <div class="hero-words">
      <h1>{copy.tagline}</h1>
      <p class="lede">{copy.intro}</p>
    </div>

    <Atlas locale={locale} />

    <dl class="tally">
        <div><dt>{group.format(counts.regions)}</dt><dd>{counted.region}</dd></div>
        <div><dt>{group.format(counts.provinces)}</dt><dd>{counted.province}</dd></div>
        <div><dt>{group.format(counts.cercles)}</dt><dd>{counted.cercle}</dd></div>
        <div><dt>{group.format(counts.communes)}</dt><dd>{counted.commune}</dd></div>
        <div><dt>{group.format(counts.arrondissements)}</dt><dd>{counted.arrondissement}</dd></div>
    </dl>
  </section>

  <section class="band">
    <h2>{copy.chartsHeading}</h2>
    {copy.chartsBody && <p>{copy.chartsBody}</p>}
    <Charts locale={locale} />
  </section>

  <section class="band">
    <h2>{copy.tryHeading}</h2>
    <p>{copy.tryBody}</p>
    <Playground copy={playgroundCopy} client:load />
  </section>

  <section class="band">
    <h2>{copy.useHeading}</h2>
    {copy.useBody && <p>{copy.useBody}</p>}
    <ul class="ways">
      {ways.map((way) => (
        <li>
          <a href={path(locale, way.route)}>{way.name}</a>
          <span>{way.text}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Hero ------------------------------------------------------------------- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 4vw, 3.25rem);
    align-items: center;
    padding-top: clamp(0.5rem, 3vw, 2rem);
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(var(--t-lg), 5.2vw, var(--t-2xl));
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.021em;
    margin: 0 0 1.1rem;
    max-width: 27ch;
    text-wrap: balance;
  }


  .lede {
    color: var(--quiet);
    max-width: 46ch;
    margin-bottom: 0;
  }

  /* Spread edge to edge: the first figure on the left margin, the last on the right. */
  .tally {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 0 clamp(1.5rem, 4vw, 3.25rem);
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }

  .tally dt {
    font-size: var(--t-md);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .tally dd {
    margin: 0;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  @media (max-width: 40rem) {
    .tally {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem 1.5rem;
    }
  }



  /* Ways in ---------------------------------------------------------------- */

  .ways {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0 2rem;
  }

  .ways li {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }

  .ways a {
    font-weight: 500;
  }

  .ways span {
    color: var(--quiet);
    font-size: var(--t-sm);
  }

  /* Bands ------------------------------------------------------------------ */

  .band {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .band h2 {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 400;
    letter-spacing: 0;
    margin: 0 0 0.5rem;
  }

  .band > p {
    color: var(--quiet);
  }


  /* Wide: the words are centred on the map itself. The map's figure hands its parts to the
     grid, so the buttons and the legend below the map sit in the next row and no longer pull
     the words down as more views are added. */
  @media (min-width: 62.0625rem) {
    .hero {
      row-gap: 0;
    }

    .hero :global(.atlas) {
      display: contents;
    }

    .hero-words {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }

    .hero :global(.atlas > .frame) {
      grid-column: 2;
      grid-row: 1;
    }

    .hero :global(.atlas > figcaption) {
      grid-column: 2;
      grid-row: 2;
    }

    .tally {
      margin-top: clamp(1.5rem, 4vw, 3.25rem);
    }
  }

  @media (max-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
