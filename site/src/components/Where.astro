---
/**
 * Which communes have a tram, train commuters, a weekly souk or foreign residents.
 * A list over 30 rows shows the first 10, and the rest sit in a fold that is open in
 * the markup: a phone shuts it as the page is read, the same way a place page does.
 */
import Base from "../layouts/Base.astro";
import { path, t, type Locale } from "../i18n/ui";
import { numbers, percent } from "../lib/format";
import { WHERE_FOLD, WHERE_SHOWN, whereLists } from "../lib/where";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const sections = whereLists();
const figures = copy.whereFigures;
const amount = (id: string, value: number) =>
  id === "souk" ? numbers(locale).format(value) : percent(locale, value, { fixed: true });
---

<Base locale={locale} route="where/" title={copy.whereTitle} description={copy.whereLede}>
  <article class="where">
    <h1>{copy.whereTitle}</h1>
    <p class="lede">{copy.whereLede}</p>
    {sections.map((section) => {
      const figure = figures[section.id as keyof typeof figures];
      const fold = section.rows.length > WHERE_FOLD;
      const shown = fold ? section.rows.slice(0, WHERE_SHOWN) : section.rows;
      const rest = fold ? section.rows.slice(WHERE_SHOWN) : [];
      return (
        <section id={section.id}>
          <h2>{figure.title}</h2>
          <p class="rule">{figure.rule}</p>
          <ul>
            {shown.map((row) => (
              <li>
                <a href={path(locale, row.route)}>{row.name}</a>
                <span>{amount(section.id, row.value)}</span>
              </li>
            ))}
          </ul>
          {rest.length > 0 && (
            <details class="more" open>
              <summary>{copy.insightsShowMore}</summary>
              <ul>
                {rest.map((row) => (
                  <li>
                    <a href={path(locale, row.route)}>{row.name}</a>
                    <span>{amount(section.id, row.value)}</span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </section>
      );
    })}
    <script is:inline>
      // Open in the markup, so the rest of a list shows without JavaScript. A phone starts
      // with it shut, and this runs as the page is read rather than after it loads, so the
      // page is never drawn open first. Same fold as a place page.
      (function () {
        if (!window.matchMedia("(max-width: 48rem)").matches) return;
        var folds = document.querySelectorAll(".where details.more");
        for (var i = 0; i < folds.length; i++) folds[i].open = false;
      })();
    </script>
  </article>
</Base>

<style>
  .where {
    padding-block: clamp(2rem, 6vw, 4rem);
    max-width: 46rem;
  }

  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(var(--t-lg), 5vw, var(--t-xl));
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .lede,
  .rule {
    color: var(--quiet);
  }

  .lede {
    font-size: var(--t-md);
    max-width: 42ch;
  }

  section {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    scroll-margin-top: calc(var(--bar-h, 4.5rem) + 0.75rem);
  }

  h2 {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 400;
    margin: 0;
  }

  .rule {
    margin: 0.35rem 0 0;
    font-size: var(--t-sm);
    max-width: 62ch;
  }

  ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
    border-top: 1px solid var(--rule);
  }

  li span {
    color: var(--quiet);
    font-variant-numeric: tabular-nums;
  }

  details.more summary {
    margin: 1.25rem 0;
    font-size: var(--t-sm);
    color: var(--quiet);
    cursor: pointer;
  }

  details.more summary:hover {
    color: var(--ink);
  }

  details.more:not([open]) summary {
    margin-bottom: 0;
  }
</style>
