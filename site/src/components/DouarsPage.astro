---
/**
 * The douars page: a box to find a douar by name, Morocco's douars counted, the map with
 * every douar a map places as a dot and how far homes are by commune, how far rural homes
 * are from a lycée, a collège, a health centre, a paved road and a primary school, and the
 * communes furthest from a health centre. The finder loads /douars/names.json the first
 * time someone types; without JavaScript it stays hidden, and each commune's page still
 * lists its douars.
 */
import Base from "../layouts/Base.astro";
import Map from "./Map.astro";
import AccessBands from "./AccessBands.astro";
import { allDouars } from "../lib/douars";
import { summarise } from "../lib/access";
import { pageOf } from "../lib/places";
import { places } from "../i18n/places";
import { path, t, type Locale } from "../i18n/ui";
import { numbers } from "../lib/format";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const p = places[locale];
const n = numbers(locale);
const km = numbers(locale, 1, true);

const total = summarise(allDouars);

/** A commune enters the list with at least this many households counted, so a few homes can't top it. */
const FARTHEST_MIN = 100;
const SHOWN = 10;
const byCommune = new globalThis.Map<string, typeof allDouars>();
for (const d of allDouars) byCommune.set(d.communeCode, [...(byCommune.get(d.communeCode) ?? []), d]);
const farthest = [...byCommune]
  .map(([code, rows]) => ({ code, page: pageOf(code), summary: summarise(rows) }))
  .filter((c) => c.page && c.summary.km && c.summary.counted >= FARTHEST_MIN)
  .sort((a, b) => b.summary.km!.healthCentre - a.summary.km!.healthCentre)
  .slice(0, SHOWN);
---

<Base locale={locale} route="douars/" title={copy.douarsTitle} description={copy.douarsLede}>
  <article class="dp">
    <h1>{copy.douarsTitle}</h1>
    <p class="lede">{copy.douarsLede}</p>

    <section id="find" class="find">
      <h2 class="sr">{copy.douarsFind}</h2>
      <div class="finder" hidden data-base={path(locale, "communes/")} data-lang={locale}
        data-none={copy.douarsFindNone} data-more={copy.douarsFindMore} data-people={copy.douarsPeople}>
        <label for="douar-query">{copy.douarsFind}</label>
        <input id="douar-query" type="search" dir="auto" autocomplete="off" spellcheck="false" placeholder={copy.douarsFindPlaceholder} aria-describedby="find-hint find-status" />
        <p id="find-hint" class="hint">{copy.douarsFindBody} <a href={path(locale, "docs/names/")}>{copy.douarsNamed}</a></p>
        <p id="find-status" class="find-status" aria-live="polite"></p>
        <ul class="hits"></ul>
      </div>
      <noscript><p>{copy.douarsFindNoScript}</p></noscript>
    </section>

    <dl class="counts">
      <div><dt>{copy.douarsCountDouars}</dt><dd>{n.format(total.douars)}</dd></div>
      <div><dt>{copy.douarsCountFractions}</dt><dd>{n.format(total.fractions)}</dd></div>
      <div><dt>{copy.douarsCountCommunes}</dt><dd>{n.format(total.communes)}</dd></div>
      <div><dt>{copy.douarsCountPeople}</dt><dd>{n.format(total.people)}</dd></div>
    </dl>

    <section>
      <h2>{copy.douarsWhere}</h2>
      <div class="map">
        <Map locale={locale} views={["douars", "highSchool", "middleSchool", "healthCentre", "pavedRoad", "named"]} />
      </div>
    </section>

    <section>
      <h2>{copy.douarsHowFar}</h2>
      <p>{copy.douarsHowFarBody}</p>
      <AccessBands locale={locale} douars={allDouars} />
    </section>

    <section>
      <h2>{copy.douarsFarthest}</h2>
      <p>{copy.douarsFarthestBody}</p>
      <ol class="farthest">
        {farthest.map((c) => (
          <li>
            <a href={path(locale, c.page!.route) + "#douars"}>{c.page!.name.fr}</a>
            <span class="bar" aria-hidden="true"><span style={`width:${(c.summary.km!.healthCentre / farthest[0]!.summary.km!.healthCentre) * 100}%`}></span></span>
            <span class="num">{km.format(c.summary.km!.healthCentre)}</span>
          </li>
        ))}
      </ol>
      <p class="note">{copy.douarsFarthestNote}</p>
    </section>

    <p class="source">
      {copy.douarsSource} <a href={path(locale, "docs/indicators/#douars")}>{p.douarsMore}</a>
    </p>
  </article>
</Base>

<script>
  import { normalise } from "../../../api/src/lib/normalise";
  import { latinKeys, lookupKey } from "../../../api/src/lib/translit";

  type Names = {
    communes: [slug: string, name: string, prefix: string][];
    douars: [name: string, commune: number, rest: string, people: number, latin: string, spelt: 0 | 1, keys: string][];
  };

  const finder = document.querySelector<HTMLElement>(".finder");
  const input = finder?.querySelector<HTMLInputElement>("input");
  const status = finder?.querySelector<HTMLElement>(".find-status");
  const hits = finder?.querySelector<HTMLUListElement>(".hits");
  if (finder && input && status && hits) {
    finder.hidden = false;
    const d = finder.dataset;
    const count = new Intl.NumberFormat(d.lang === "fr" ? "fr-FR" : "en-GB");
    const LIMIT = 20;
    let names: Names | null = null;
    let arabic: string[] = [];
    let latin: string[] = [];
    let keyed: string[][] = [];
    let loading: Promise<void> | null = null;
    const load = () =>
      (loading ??= fetch("/douars/names.json")
        .then((r) => r.json())
        .then((json: Names) => {
          names = json;
          arabic = json.douars.map(([name]) => normalise(name));
          latin = json.douars.map((d) => normalise(d[4]));
          keyed = json.douars.map((d) => d[6].split("|"));
        })
        .catch(() => undefined));

    const escape = (s: string) => s.replace(/[&<>"]/g, (ch) => `&#${ch.charCodeAt(0)};`);
    /** Letters to change to turn one spelling into the other, over the longer's length. */
    const apart = (a: string, b: string) => {
      let row = Array.from({ length: b.length + 1 }, (_, j) => j);
      for (let i = 1; i <= a.length; i++) {
        const next = [i];
        for (let j = 1; j <= b.length; j++) next[j] = Math.min(row[j]! + 1, next[j - 1]! + 1, row[j - 1]! + (a[i - 1] === b[j - 1] ? 0 : 1));
        row = next;
      }
      return row[b.length]! / Math.max(a.length, b.length, 1);
    };
    const render = () => {
      const query = normalise(input.value);
      hits.replaceChildren();
      status.textContent = "";
      if (!query) return;
      if (!names) return;
      // In Arabic, a name that starts with the query comes first, then one with a word that
      // does, then any that holds it. In Latin, a name whose keys are the query's comes first,
      // then one whose keys start with them, then one whose Latin spelling holds the query.
      // The bigger douar first within each.
      const found: { i: number; rank: number; near?: number }[] = [];
      if (/\p{Script=Arabic}/u.test(query)) {
        arabic.forEach((name, i) => {
          const at = name.indexOf(query);
          if (at >= 0) found.push({ i, rank: at === 0 ? 0 : name[at - 1] === " " ? 1 : 2 });
        });
      } else {
        // Keys meet for spellings far apart (Tigraw and Ait Ettajr both come to tkr), so a
        // match is ranked by how close its Latin spelling is to what was typed.
        const wanted = latinKeys(query).map(lookupKey).filter(Boolean);
        // French writes w as ou, so the 2 are one letter here: Tigraw is Tigraou, not Tigrar.
        const sound = (s: string) => s.replace(/ /g, "").replace(/ou/g, "w");
        const typed = sound(query);
        keyed.forEach((own, i) => {
          const near = apart(typed, sound(latin[i]!));
          if (own.some((k) => wanted.includes(k))) found.push({ i, rank: 0, near });
          else if (wanted.some((w) => w.length >= 2 && own.some((k) => k.startsWith(w)))) found.push({ i, rank: 1, near });
          else if (query.length >= 3 && latin[i]!.includes(query)) found.push({ i, rank: 2, near });
        });
        // A close spelling beats a key match that reads nothing like it.
        for (const f of found) if (f.near! <= 0.34) f.rank = Math.min(f.rank, 0) - 1;
      }
      found.sort((a, b) => a.rank - b.rank || (a.near ?? 0) - (b.near ?? 0) || names!.douars[b.i]![3] - names!.douars[a.i]![3]);
      if (found.length === 0) {
        status.textContent = d.none ?? "";
        return;
      }
      if (found.length > LIMIT) status.textContent = (d.more ?? "").replace("{n}", count.format(found.length)).replace("{shown}", String(LIMIT));
      for (const { i } of found.slice(0, LIMIT)) {
        const [name, commune, rest, people, written, spelt] = names.douars[i]!;
        const [slug, communeName, prefix] = names.communes[commune]!;
        const li = document.createElement("li");
        li.innerHTML =
          `<a href="${d.base}${slug}/#douar-${prefix}${rest}"><span lang="ar" dir="rtl">${escape(name)}</span>` +
          `<span class="${spelt ? "latin spelt" : "latin"}">${escape(written)}</span>` +
          `<span class="in">${escape(communeName)} · ${(d.people ?? "{n}").replace("{n}", count.format(people))}</span></a>`;
        hits.append(li);
      }
    };
    input.addEventListener("focus", load, { once: true });
    input.addEventListener("input", () => {
      if (names) render();
      else load().then(render);
    });
  }
</script>

<style>
  .dp {
    padding-block: clamp(2rem, 6vw, 4rem);
    max-width: 60rem;
  }

  .dp h1 {
    font-family: var(--display);
    font-size: clamp(var(--t-lg), 5vw, var(--t-xl));
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }

  .lede {
    margin: 0;
    max-width: 52ch;
    font-size: var(--t-md);
    line-height: 1.45;
    color: var(--quiet);
  }

  .counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    border-top: 1px solid var(--rule);
  }

  .counts > div {
    padding: 1rem 1.25rem 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .counts dt {
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .counts dd {
    margin: 0.2rem 0 0;
    font-size: var(--t-lg);
    font-variant-numeric: tabular-nums;
  }

  section {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  h2 {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 400;
    margin: 0 0 0.5rem;
  }

  section > p {
    max-width: 60ch;
    color: var(--quiet);
  }

  .map {
    margin-top: 2rem;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The finder leads the page: a wide box, its label above it. */
  .find {
    padding-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  .finder label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--t-sm);
  }

  .hint {
    margin: 0.5rem 0 0;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  /* Ranked bars, as on the insights page's lists. */
  .farthest {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    max-width: 40rem;
  }

  .farthest li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) 3.5rem;
    gap: 0.75rem;
    align-items: center;
    font-size: var(--t-sm);
  }

  .farthest .bar {
    display: block;
    height: 0.7rem;
  }

  .farthest .bar span {
    display: block;
    height: 100%;
    background: var(--seq-5);
    border-radius: 0 2px 2px 0;
  }

  .farthest .num {
    text-align: end;
    font-size: var(--t-xs);
    color: var(--quiet);
    font-variant-numeric: tabular-nums;
  }

  .finder input {
    width: min(100%, 34rem);
    padding: 0.8rem 1rem;
    font-size: var(--t-md);
  }

  .finder[hidden] {
    display: none;
  }

  .find-status {
    margin: 0.5rem 0 0;
    min-height: 1.4em;
    font-size: var(--t-sm);
    color: var(--quiet);
  }

  .hits {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hits :global(li) {
    border-bottom: 1px solid var(--rule);
  }

  .hits :global(a) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0;
    color: var(--ink);
    text-decoration: none;
  }

  .hits :global(a:hover) :global(span[lang="ar"]) {
    text-decoration: underline;
  }

  .hits :global(.latin.spelt) {
    font-style: italic;
  }

  .hits :global(.in) {
    font-size: var(--t-sm);
    color: var(--quiet);
  }

  .note {
    margin-top: 0.75rem;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .source {
    margin-top: 3rem;
    font-size: var(--t-sm);
    color: var(--quiet);
  }
</style>
