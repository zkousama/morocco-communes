---
import Docs from "../../layouts/Docs.astro";
import Code from "../Code.astro";
import Params from "./Params.astro";
import { typeOf, type Schema } from "../../lib/schema";
import { reference } from "../../generated/reference";
import { docs, SPEC_FR } from "../../i18n/docs";
import { highlightJson } from "../../lib/highlight";
import { inline } from "../../lib/inline";
import { t, type Locale } from "../../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = docs[locale].api;
const copy = t(locale);
// French groups thousands with a thin space, English with a comma.
const group = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-GB");

const tiers = [
  // Counted from what the API build writes, so it follows every route added.
  { name: copy.tierPre, body: copy.tierPreBody.replace("{files}", group.format(reference.apiFiles)), header: copy.tierPreHeader },
  { name: copy.tierAlias, body: copy.tierAliasBody, header: "X-Api-Tier: alias" },
  { name: copy.tierComputed, body: copy.tierComputedBody, header: "X-Api-Tier: computed" },
];

const prerendered = `GET /api/regions.json
GET /api/regions/01/provinces.json
GET /api/provinces/01.511/communes/page/1.json
GET /api/communes/01.511.01.0.json
GET /api/communes/01.511.01.0/arrondissements.json
GET /api/communes/type/urban/page/1.json
GET /api/version.json`;

/** The pre-rendered routes, each a link to the file that answers it. */
const routeLines = prerendered.split("\n").map((line) => line.replace(/^GET /, ""));

interface Param {
  name: string;
  in: string;
  required?: boolean;
  description?: string;
  schema: Schema;
}
interface Operation {
  operationId: string;
  summary: string;
  description?: string;
  parameters?: Param[];
  responses: Record<string, { description: string }>;
}

// The English page speaks the spec's own words. The French one reads each line from the
// translation map, and every key the spec implies has to be there, with none left over.
const used = new Set<string>();
const say = (key: string, english: string) => {
  if (locale === "en") return english;
  used.add(key);
  const french = SPEC_FR[key];
  if (!french) throw new Error(`SPEC_FR has no ${key}; the spec says "${english}"`);
  return french;
};

const operations = reference.operations.map(({ path, method, op }) => {
  const o = op as unknown as Operation;
  const id = o.operationId;
  return {
    id,
    path,
    method: method.toUpperCase(),
    summary: say(`${id}.summary`, o.summary),
    description: o.description ? say(`${id}.description`, o.description) : null,
    params: (o.parameters ?? []).map((p) => ({
      ...p,
      description: p.description ? say(`${id}.param.${p.name}`, p.description) : "",
    })),
    responses: Object.entries(o.responses).map(([status, r]) => ({
      status,
      text: say(`${id}.${status}`, r.description),
    })),
    example: (reference.examples as Record<string, { request: string; body: unknown; cut?: { shown: number; total: number }; trimmed?: boolean }>)[id]!,
  };
});

if (locale === "fr") {
  const stale = Object.keys(SPEC_FR).filter((key) => !used.has(key));
  if (stale.length > 0) throw new Error(`SPEC_FR names what the spec no longer has: ${stale.join(", ")}`);
}

const origin = Astro.site?.origin ?? null;
const identifiers = ["01.511.01.0", "001511010", "1511010", "tanger"];
const fill = (text: string, values: Record<string, number>) =>
  text.replace(/\{(\w+)\}/g, (_, k: string) => String(values[k] ?? ""));
const errors = Object.entries(reference.errors as Record<string, { status: number; title: string }>);

const toc = [
  { id: "basics", label: d.basics },
  { id: "routes", label: d.routes },
  { id: "files", label: d.files },
  { id: "errors", label: d.errors },
  { id: "tiers", label: copy.tiersHeading },
];
---

<Docs locale={locale} route="docs/api/" title={d.title} description={d.description} lede={d.lede} toc={toc}>
  <section id="basics">
    <h2>{d.basics}</h2>
    <dl class="basics">
      <div>
        <dt>{d.baseUrl}</dt>
        <dd>
          {origin ? <code>{origin}</code> : <span class="quiet">{d.baseUrlLocal}</span>}.
          {" "}{d.baseUrlBody}
        </dd>
      </div>
      <div>
        <dt>{d.identifiers}</dt>
        <dd>
          {d.identifiersBody}{" "}
          {identifiers.map((id, i) => (
            <>{i > 0 && ", "}<code>{id}</code></>
          ))}.
        </dd>
      </div>
      <div><dt>{d.shape}</dt><dd set:html={inline(d.shapeBody)} /></div>
      <div>
        <dt>{d.spec}</dt>
        <dd>{d.specBody} <a href="/api/openapi.json"><code>/api/openapi.json</code></a></dd>
      </div>
    </dl>
  </section>

  <section id="routes">
    <h2>{d.routes}</h2>
    <ul class="index">
      {operations.map((op) => (
        <li><a href={`#${op.id}`}><span class="verb">{op.method}</span> <code>{op.path}</code></a></li>
      ))}
    </ul>

    {operations.map((op) => (
      <article class="route" id={op.id}>
        <h3><span class="verb">{op.method}</span> <code>{op.path}</code></h3>
        <p class="summary">{op.summary}</p>
        {op.description && <p class="quiet" set:html={inline(op.description)} />}

        {op.params.length > 0 && (
          <Params
            label={d.parameters}
            params={op.params.map((p) => ({
              name: p.name,
              type: typeOf(p.schema),
              required: p.required,
              note: p.required ? d.required : p.schema.default !== undefined ? d.byDefault.replace("{v}", String(p.schema.default)) : undefined,
              description: p.description,
            }))}
          />
        )}

        <ul class="responses" aria-label={d.responses}>
          {op.responses.map((r) => (
            <li>
              {r.status.startsWith("2") ? (
                <span class="mono status">{r.status}</span>
              ) : (
                <a class="mono status" href="#errors">{r.status}</a>
              )}
              <span set:html={inline(r.text)} />
            </li>
          ))}
        </ul>

        <details class="example">
          <summary>{d.example} · <code>GET {op.example.request}</code></summary>
          <Code locale={locale} label="JSON" html={highlightJson(op.example.body)} tall />
          {op.example.cut && <p class="note cut">{fill(op.example.cut.shown === 1 ? d.cutNoteOne : d.cutNote, op.example.cut)}</p>}
          {op.example.trimmed && <p class="note cut">{d.trimNote}</p>}
        </details>
      </article>
    ))}
  </section>

  <section id="files">
    <h2>{d.files}</h2>
    <p set:html={inline(d.filesBody)} />
    <div class="scroll" tabindex="0">
      <table class="stack">
        <thead>
          <tr>
            <th scope="col">{d.path}</th>
            <th scope="col">{d.holds}</th>
          </tr>
        </thead>
        <tbody>
          {reference.files.map((f) => (
            <tr>
              <td class="mono"><a href={f.example}>{f.pattern.split("/").map((part, i) => <>{i > 0 && <>/<wbr /></>}{part}</>)}</a></td>
              <td>{d.filesWhat[f.key as keyof typeof d.filesWhat]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="errors">
    <h2>{d.errors}</h2>
    <p set:html={inline(d.errorsBody)} />
    <dl class="errors">
      {errors.map(([kind, e]) => (
        <div id={kind}>
          <dt><code>{kind}</code> <span class="mono quiet">{e.status}</span></dt>
          <dd>
            <span class="title" lang={locale === "en" ? undefined : "en"}>{e.title}.</span> {d.errorWhen[kind]}
          </dd>
        </div>
      ))}
    </dl>
    <Code locale={locale} label={d.errorExample} html={highlightJson(reference.errorExample)} />
  </section>

  <section id="tiers">
    <h2>{copy.tiersHeading}</h2>
    <p class="quiet">{copy.tiersBody}</p>
    <ol class="tiers">
      {tiers.map((tier) => (
        <li>
          <h3>{tier.name}</h3>
          <p class="mono header">{tier.header}</p>
          <p>{tier.body}</p>
        </li>
      ))}
    </ol>
    <ul class="routes">
      {routeLines.map((route) => (
        <li><span class="verb">GET</span> <a href={route}>{route}</a></li>
      ))}
    </ul>
  </section>
</Docs>

<style>
  .example {
    margin-top: 0.75rem;
  }

  .example summary {
    cursor: pointer;
    font-size: var(--t-sm);
    color: var(--quiet);
    padding: 0.35rem 0;
  }

  .example summary:hover {
    color: var(--ink);
  }

  .example summary code {
    font-size: 0.9em;
  }

  .example[open] summary {
    margin-bottom: 0.5rem;
  }

  /* Tiers: a sequence, because a request really does fall through them in order. */
  .tiers {
    list-style: none;
    counter-reset: tier;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }

  .tiers li {
    counter-increment: tier;
    background: var(--paper);
    padding: 1.1rem 0;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 0 1rem;
    align-items: baseline;
  }

  .tiers li::before {
    content: counter(tier);
    font-family: var(--mono);
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .tiers h3 {
    margin: 0;
    font-size: var(--t-base);
    font-weight: 500;
  }

  .tiers .header {
    grid-column: 2;
    margin: 0.2rem 0 0;
    font-size: var(--t-xs);
    color: var(--brass);
    direction: ltr;
  }

  .tiers li p:last-child {
    grid-column: 3;
    grid-row: 1 / span 2;
    margin: 0;
    color: var(--quiet);
    font-size: var(--t-sm);
  }

  /* Routes and downloads are links now, so a reader can open the real response. */
  ul.routes {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 1.1rem 1.25rem;
    background: var(--well);
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: var(--t-xs);
    line-height: 1.9;
    overflow-x: auto;
  }

  ul.routes li {
    white-space: nowrap;
  }

  ul.routes .verb {
    color: var(--quiet);
  }

  ul.routes a {
    color: var(--code-string);
    text-decoration: none;
  }

  ul.routes a:hover {
    text-decoration: underline;
  }

  @media (max-width: 62rem) {
    .tiers li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .tiers li p:last-child {
      grid-column: 2;
      grid-row: auto;
      margin-top: 0.5rem;
    }
  }

  .basics,
  .errors {
    margin: 1rem 0 0;
    display: grid;
    gap: 0;
  }

  .basics > div,
  .errors > div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 1rem;
  }

  .basics > div:last-child,
  .errors > div:last-child {
    border-bottom: 0;
  }

  dt {
    font-weight: 500;
  }

  dd {
    margin: 0;
    max-width: var(--measure);
  }

  .errors {
    margin-bottom: 1.5rem;
  }

  .errors > div:target {
    background: var(--well);
  }

  .errors .title {
    font-weight: 500;
  }

  @media (max-width: 40rem) {
    .basics > div,
    .errors > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .index {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    columns: 2 18rem;
    column-gap: 2rem;
    font-size: var(--t-sm);
  }

  .index li {
    padding: 0.2rem 0;
    break-inside: avoid;
  }

  .index a {
    text-decoration: none;
  }

  .index a:hover code {
    color: var(--brass);
  }

  .verb {
    font-family: var(--mono);
    font-size: 0.82em;
    color: var(--quiet);
    margin-inline-end: 0.35rem;
  }

  .route {
    padding-top: 2.5rem;
    scroll-margin-top: 1rem;
  }

  .route h3 {
    margin: 0 0 0.35rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .route h3 code {
    font-size: 0.95em;
  }

  .summary {
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  .responses {
    list-style: none;
    margin: 0.5rem 0 1.25rem;
    padding: 0;
    font-size: var(--t-sm);
    display: grid;
    gap: 0.3rem;
  }

  .responses li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .status {
    color: var(--quiet);
  }

  .cut {
    margin-top: -0.75rem;
    font-size: var(--t-xs);
  }
</style>
