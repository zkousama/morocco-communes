---
/**
 * The census figures' data dictionary, read from the fields.json files the dataset ships,
 * so the page lists exactly the fields the files and the API carry, each under HCP's own
 * heading. A 2024 field the 2014 census asked the same way is marked as such, and the
 * fields 2014 asked its own way are listed on their own at the end.
 */
import { readFileSync } from "node:fs";
import Docs from "../../layouts/Docs.astro";
import { docs } from "../../i18n/docs";
import { inline } from "../../lib/inline";
import type { Locale } from "../../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = docs[locale].indicators;

interface Field {
  path: string;
  column: string;
  topic: string;
  label: string;
  heading: string;
  category?: string;
  unit: keyof typeof d.units;
  sexes?: ("all" | "male" | "female")[];
  comparableTo?: string;
  note?: string;
}
const dictionary = JSON.parse(readFileSync("data/v1/indicators/fields.json", "utf8")) as { people: Field[]; households: Field[] };
const dictionary2014 = JSON.parse(readFileSync("data/v1/indicators/2014/fields.json", "utf8")) as { people: Field[]; households: Field[] };
const establishments = (JSON.parse(readFileSync("data/v1/economy/fields.json", "utf8")) as { fields: Field[] }).fields;
const fields2014 = [...dictionary2014.people, ...dictionary2014.households];
const alsoIn2014 = new Set(fields2014.map((f) => f.comparableTo).filter(Boolean));
// The 2014 fields that don't line up with a 2024 one: a question that changed between the
// censuses, or one only 2014 asked.
const ownTo2014 = fields2014.filter((f) => f.comparableTo === undefined);

// Which sexes HCP gives a figure for: all three, everyone only, or everyone and women.
const sexesOf = (f: Field) => {
  if (!f.sexes || f.sexes.length === 0) return null;
  const phrase = d.sexes[f.sexes.join(",")];
  if (!phrase) throw new Error(`no phrase for the sexes ${f.sexes.join(", ")} of ${f.path}`);
  return phrase;
};
const meta = (f: Field) => [d.units[f.unit], sexesOf(f)].filter(Boolean).join(" · ");

/** Fields by topic, and within a topic, runs of fields under one heading. */
const topicsOf = (fields: Field[]) => {
  const topics: { topic: string; groups: { heading: string; grouped: boolean; fields: Field[] }[] }[] = [];
  for (const f of fields) {
    let topic = topics.at(-1);
    if (topic?.topic !== f.topic) topics.push((topic = { topic: f.topic, groups: [] }));
    const last = topic.groups.at(-1);
    if (last && last.grouped && f.category && last.heading === f.heading) last.fields.push(f);
    else topic.groups.push({ heading: f.heading, grouped: Boolean(f.category), fields: [f] });
  }
  return topics;
};

// HCP's headings are French. The French page reads them as they are; the English one
// leads with an English label and keeps HCP's wording beside it, marked as French.
const english = locale === "en";
// A column that opens a block has no heading above it, only a category, so the separator
// would lead. HCP's own wording is whichever of the two the workbook prints.
const source = (f: Field) => [f.heading, f.category].filter(Boolean).join(" · ");
const sections = [
  { id: "people", label: d.people, topics: topicsOf(dictionary.people) },
  { id: "households", label: d.households, topics: topicsOf(dictionary.households) },
];

const toc = [
  { id: "reading", label: d.reading },
  { id: "people", label: d.people },
  { id: "households", label: d.households },
  { id: "establishments", label: d.establishments },
  { id: "before", label: d.before },
  { id: "get", label: d.get },
];
---

<Docs locale={locale} route="docs/indicators/" title={d.title} description={d.description} lede={d.lede} toc={toc}>
  <section id="reading">
    <h2>{d.reading}</h2>
    <ul class="notes">
      {d.readingBody.map((line) => <li set:html={inline(line)} />)}
    </ul>
  </section>

  {sections.map((section) => (
    <section id={section.id}>
      <h2>{section.label}</h2>
      {section.topics.map(({ topic, groups }, i) => (
        // A topic whose columns are split by another topic comes back more than once, and
        // only the first run answers to the id.
        <div class="topic" id={section.topics.findIndex((t) => t.topic === topic) === i ? `topic-${topic}` : undefined}>
          <h3>{d.topics[topic as keyof typeof d.topics] ?? topic}</h3>
          {groups.map((g) => (
            <>
              {g.grouped && !english && <p class="heading">{g.heading}</p>}
              <dl class="fields">
                {g.fields.map((f) => (
                  <div>
                    <dt>
                      <code>{f.path}</code>
                      <span class="column">{d.column} <code>{f.column}</code></span>
                    </dt>
                    <dd>
                      <span>{english ? f.label : f.category ?? f.heading}</span>
                      <span class="meta">{meta(f)}</span>
                      {alsoIn2014.has(f.path) && <span class="meta also">{d.also}</span>}
                      {english && <span class="source" lang="fr">HCP: {source(f)}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            </>
          ))}
        </div>
      ))}
    </section>
  ))}

  <section id="establishments">
    <h2>{d.establishments}</h2>
    <ul class="notes">
      {d.establishmentsBody.map((line) => <li set:html={inline(line)} />)}
    </ul>
    {topicsOf(establishments).map(({ topic, groups }) => (
      <div class="topic" id={`topic-${topic}`}>
        <h3>{d.establishmentTopics[topic as keyof typeof d.establishmentTopics] ?? topic}</h3>
        {groups.map((g) => (
          <>
            {g.grouped && !english && <p class="heading">{g.heading}</p>}
            <dl class="fields">
              {g.fields.map((f) => (
                <div>
                  <dt>
                    <code>{f.path}</code>
                    <span class="column">{d.column} <code>{f.column}</code></span>
                  </dt>
                  <dd>
                    <span>{english ? f.label : f.category ?? f.heading}</span>
                    <span class="meta">{meta(f)}</span>
                    {english && <span class="source" lang="fr">HCP: {source(f)}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          </>
        ))}
      </div>
    ))}
  </section>

  <section id="before">
    <h2>{d.before}</h2>
    <ul class="notes">
      {d.beforeBody.map((line) => <li set:html={inline(line)} />)}
    </ul>
    <dl class="fields">
      {ownTo2014.map((f) => (
        <div>
          <dt>
            <code>{f.path}</code>
            <span class="column">{d.column} <code>{f.column}</code></span>
          </dt>
          <dd>
            <span>{english ? f.label : f.category ?? f.heading}</span>
            <span class="meta">{meta(f)}</span>
            {english && <span class="source" lang="fr">HCP: {source(f)}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="get">
    <h2>{d.get}</h2>
    <ul class="notes">
      {d.getBody.map((line) => <li set:html={inline(line)} />)}
    </ul>
  </section>
</Docs>

<style>
  .notes {
    margin: 0.75rem 0 0;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.45rem;
    max-width: var(--measure);
  }

  .topic {
    scroll-margin-top: 1rem;
  }

  .topic h3 {
    margin: 2rem 0 0.4rem;
    font-weight: 500;
  }

  .heading {
    margin: 0.75rem 0 0.25rem;
    font-size: var(--t-sm);
    color: var(--quiet);
  }

  .fields {
    margin: 0;
    border-top: 1px solid var(--rule);
    font-size: var(--t-sm);
  }

  .fields > div {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: 0.15rem 1.5rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
  }

  dt {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    overflow-wrap: anywhere;
  }

  .column {
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.75rem;
    align-items: baseline;
  }

  .meta {
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  .source {
    flex-basis: 100%;
    font-size: var(--t-xs);
    color: var(--quiet);
  }

  /* Marks a figure the 2014 census asked the same way, so the two subtract. */
  .also::before {
    content: "";
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-inline-end: 0.35rem;
    border-radius: 50%;
    background: currentColor;
    vertical-align: 0.05em;
  }

  @media (max-width: 40rem) {
    .fields > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
