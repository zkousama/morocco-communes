---
import { LOCALE_NAMES, LOCALES, REPO_URL, RTL, path, t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const rtl = RTL[locale];
---

<!doctype html>
<html lang={locale} dir={rtl ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.tagline} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%87%B2%F0%9F%87%A6%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={path(locale)}>{copy.title}</a>
      <nav class="langs">
        {LOCALES.map((l) => (
          <a href={path(l)} class:list={["lang", { on: l === locale }]} hreflang={l}>
            {LOCALE_NAMES[l]}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      {
        REPO_URL ? (
          <a href={REPO_URL}>{copy.repo}</a>
        ) : null
      }
      <span>HCP RGPH 2024 · © OpenStreetMap contributors (ODbL)</span>
    </footer>

    <style is:global>
      :root {
        --bg: #fbf9f6;
        --panel: #ffffff;
        --ink: #1d1b19;
        --muted: #6b645c;
        --line: #e6e0d8;
        --accent: #a4343a;
        --accent-soft: #f6eceb;
        --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #16150f;
          --panel: #1f1e17;
          --ink: #f3efe7;
          --muted: #a49c90;
          --line: #322f26;
          --accent: #e07a7f;
          --accent-soft: #2a2119;
        }
      }

      :root[data-theme="dark"] {
        --bg: #16150f;
        --panel: #1f1e17;
        --ink: #f3efe7;
        --muted: #a49c90;
        --line: #322f26;
        --accent: #e07a7f;
        --accent-soft: #2a2119;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      html[dir="rtl"] body { font-family: "Segoe UI", Tahoma, var(--sans); }

      main { max-width: 68rem; margin: 0 auto; padding: 0 16px 5rem; }

      .top {
        max-width: 68rem;
        margin: 0 auto;
        padding: 1.25rem 16px;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        font-weight: 620;
        letter-spacing: -0.01em;
        color: var(--ink);
        text-decoration: none;
      }

      .langs { display: flex; gap: 0.25rem; }

      .lang {
        font-size: 0.85rem;
        color: var(--muted);
        text-decoration: none;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        border: 1px solid transparent;
      }

      .lang:hover { color: var(--ink); }
      .lang.on { color: var(--accent); border-color: var(--line); background: var(--panel); }

      h1 {
        font-size: clamp(1.9rem, 5vw, 3rem);
        line-height: 1.12;
        letter-spacing: -0.025em;
        margin: 2.5rem 0 1rem;
        max-width: 34ch;
      }

      h2 {
        font-size: 1.05rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
        font-weight: 600;
        margin: 3.5rem 0 1.25rem;
      }

      h3 { font-size: 1rem; margin: 0 0 0.35rem; }

      p { margin: 0 0 1rem; max-width: 68ch; }
      .lede { font-size: 1.1rem; color: var(--muted); max-width: 60ch; }

      a { color: var(--accent); }

      .grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.1rem 1.2rem;
      }

      .card p { color: var(--muted); font-size: 0.92rem; margin: 0; }

      .counts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .counts li {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 0.7rem 1rem;
        min-width: 8.5rem;
      }

      .counts b { display: block; font-size: 1.5rem; letter-spacing: -0.02em; }
      .counts span { font-size: 0.82rem; color: var(--muted); }

      code, pre, .mono { font-family: var(--mono); }

      pre {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 0.9rem 1rem;
        overflow: auto;
        font-size: 0.82rem;
        line-height: 1.55;
        margin: 0;
        direction: ltr;
        text-align: left;
      }

      .routes { direction: ltr; text-align: left; }

      footer {
        max-width: 68rem;
        margin: 0 auto;
        padding: 2rem 16px 3rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.82rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }

      @media (max-width: 34rem) {
        h2 { margin-top: 2.5rem; }
      }
    </style>
  </body>
</html>
