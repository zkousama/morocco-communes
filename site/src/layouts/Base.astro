---
import { AUTHOR, LOCALE_NAMES, LOCALES, REPO_URL, path, t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** The page's path after the locale prefix, so switching language keeps the page. */
  route?: string;
  /** A page's own title and summary. The home page has neither, and uses the site's. */
  title?: string;
  description?: string;
}
const { locale, route = "", title, description } = Astro.props;
// Cloudflare Web Analytics, when a token is given at build time. It sets no cookies.
const analytics = process.env.CF_ANALYTICS_TOKEN;
const copy = t(locale);
const sections = [
  { route: "communes/", label: copy.navCommunes },
  { route: "docs/api/", label: copy.navApi },
  { route: "docs/mcp/", label: copy.navMcp },
  { route: "docs/components/", label: copy.navComponents },
  { route: "docs/npm/", label: copy.navNpm },
];
const site = Astro.site;
const absolute = (p: string) => (site ? new URL(p, site).href : null);
const canonical = absolute(Astro.url.pathname);
const ogImage = absolute("/og.png");
const themes = [
  { id: "auto", label: copy.themeAuto },
  { id: "light", label: copy.themeLight },
  { id: "dark", label: copy.themeDark },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${copy.title}` : copy.title}</title>
    <meta name="description" content={description ?? copy.tagline} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.title} />
    <meta property="og:title" content={title ?? copy.tagline} />
    <meta property="og:description" content={description ?? copy.intro} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? copy.tagline} />
    <meta name="twitter:description" content={description ?? copy.intro} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={copy.tagline} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      site &&
        LOCALES.map((l) => (
          <link rel="alternate" hreflang={l} href={absolute(path(l, route))!} />
        ))
    }
    {site && <link rel="alternate" hreflang="x-default" href={absolute(path("en", route))!} />}
    {site && <link rel="sitemap" href="/sitemap.xml" />}
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:ital,wght@0,400..600;1,400..500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Before first paint, so a chosen theme never flashes the other one. Storage can
      // throw in a private window, and the page has to render regardless.
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {
        /* no stored preference is readable; the media query decides */
      }
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="masthead">
      <a class="wordmark" href={path(locale)}>{copy.title}</a>
      <nav class="sections" aria-label={copy.navLabel}>
        {sections.map((s) => (
          <a
            href={path(locale, s.route)}
            aria-current={
              s.route === route
                ? "page"
                : s.route === "communes/" && /^(communes|provinces|regions)\//.test(route)
                  ? "true"
                  : undefined
            }
          >
            {s.label}
          </a>
        ))}
      </nav>
      <div class="controls">
        <nav class="tongues" aria-label={copy.language}>
          {LOCALES.map((l) => (
            <a href={path(l, route)} hreflang={l} lang={l} aria-current={l === locale ? "page" : undefined}>
              {LOCALE_NAMES[l]}
            </a>
          ))}
        </nav>
        <fieldset class="themes">
          <legend class="sr-only">{copy.theme}</legend>
          {themes.map((theme) => (
            <button type="button" data-set-theme={theme.id} aria-pressed="false">{theme.label}</button>
          ))}
        </fieldset>
      </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="credits">
        <p>{copy.footerData}</p>
        <p>{copy.footerGeometry}</p>
      </div>
      <div class="made">
        <p>© {new Date().getFullYear()} <a href={AUTHOR.url}>{AUTHOR.name}</a></p>
        <p class="links">
          <a href={REPO_URL}>{copy.repo}</a>
          <a href={`${REPO_URL}/blob/main/CITATION.cff`}>{copy.cite}</a>
          <a href={`${REPO_URL}/issues/new/choose`}>{copy.report}</a>
          <a href="/llms.txt">llms.txt</a>
        </p>
      </div>
    </footer>

    {
      analytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analytics })}
        />
      )
    }

    <script is:inline>
      // The bar stays at the top. Its height is published for the contents list and for
      // anchors to clear; on a phone, where it's tall, it slides away while reading down
      // and comes back on the way up.
      (function () {
        var bar = document.querySelector(".masthead");
        if (!bar) return;
        var root = document.documentElement;
        var publish = function () {
          root.style.setProperty("--bar-h", bar.offsetHeight + "px");
        };
        publish();
        if (window.ResizeObserver) new ResizeObserver(publish).observe(bar);
        var last = window.scrollY;
        var narrow = window.matchMedia("(max-width: 48rem)");
        window.addEventListener(
          "scroll",
          function () {
            var y = window.scrollY;
            bar.classList.toggle("scrolled", y > 4);
            bar.classList.toggle("away", narrow.matches && y > last && y > bar.offsetHeight);
            last = y;
          },
          { passive: true },
        );
      })();
    </script>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var buttons = Array.prototype.slice.call(document.querySelectorAll("[data-set-theme]"));
        var current = function () {
          return root.dataset.theme || "auto";
        };
        var paint = function () {
          var now = current();
          buttons.forEach(function (button) {
            button.setAttribute("aria-pressed", String(button.dataset.setTheme === now));
          });
        };
        buttons.forEach(function (button) {
          button.addEventListener("click", function () {
            var next = button.dataset.setTheme;
            if (next === "auto") delete root.dataset.theme;
            else root.dataset.theme = next;
            try {
              if (next === "auto") localStorage.removeItem("theme");
              else localStorage.setItem("theme", next);
            } catch (e) {
              /* the choice still applies to this page view */
            }
            paint();
          });
        });
        paint();
      })();
    </script>

    <style is:global>
      @font-face {
        font-family: "Bouazzi Maghribi";
        src: url("/fonts/BouazziMaghribi-Regular.woff2") format("woff2");
        font-display: swap;
        /* Its letters sit small beside the Latin faces; this brings them level. */
        size-adjust: 130%;
        unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
      }

      :root {
        /* The document ground: warm grey stock, survey ink, one rule colour. */
        --paper: #f1efe9;
        --ink: #191d19;
        --quiet: #5f6660;
        --rule: #dcd9d0;
        --brass: #836722;

        /* The data plate. Fixed in both themes, because it is a field the page sets
           data on rather than a surface that follows the page. */
        --plate: #0d1a17;
        --plate-ink: #e8efe9;
        --plate-quiet: #8ba398;
        --plate-rule: #26392f;
        --plate-accent: #7fcfae;
        --plate-warn: #d8a83e;

        /* Charts sit on the page, so their colours follow its theme. A diverging pair,
           checked with the dataviz validator against each surface: lightness band,
           chroma floor, colour-blind separation (protan ΔE 9.1 here, 10.7 in dark) and
           3:1 contrast. The neutral midpoint is the rule colour. */
        --chart-up: #0f8266;
        --chart-down: #b3781b;

        /* The map's ramps, checked with the dataviz validator against this page: one hue
           light to dark for density, and for change two arms on either side of a grey
           that means "about the same". The palest class clears the page at 2:1. */
        --seq-0: #80b19d;
        --seq-1: #61a088;
        --seq-2: #408e73;
        --seq-3: #257b60;
        --seq-4: #0d664d;
        --seq-5: #07503c;
        --div-0: #8f520d;
        --div-1: #b17d41;
        --div-2: #a6a59e;
        --div-3: #5c9b83;
        --div-4: #338469;
        --div-5: #096048;
        --map-none: #d3d0c6;

        /* Code sits in a well a shade off the page. Its string and number colours are
           darker than the brass and green above, to hold 4.5:1 on the well. */
        --well: #ebe8e0;
        --code-string: #7a5f1c;
        --code-number: #0c7059;

        /* Arabic is set in Bouazzi Maghribi, a revival of a Moroccan Maghribi face. Its
           @font-face covers the Arabic block only, so it sits in every stack and only
           ever draws Arabic. */
        --display: "Instrument Serif", "Bouazzi Maghribi", Georgia, "Times New Roman", serif;
        --sans: "Instrument Sans", "Bouazzi Maghribi", system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: "JetBrains Mono", "Bouazzi Maghribi", ui-monospace, Menlo, Consolas, monospace;

        /* A fourth, per Bringhurst. */
        --t-xs: 0.8125rem;
        --t-sm: 0.875rem;
        --t-base: 1rem;
        --t-md: 1.333rem;
        --t-lg: 1.777rem;
        --t-xl: 2.37rem;
        --t-2xl: 3.157rem;
        --measure: 68ch;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --paper: #191b16;
          --ink: #ece9df;
          --quiet: #9d9a8d;
          --rule: #313329;
          --brass: #cfa64a;
          --chart-up: #40a687;
          --chart-down: #b98a2c;
          --well: #20221c;
          --code-string: #cfa64a;
          --code-number: #5bb898;
          --seq-0: #2c614e;
          --seq-1: #367b63;
          --seq-2: #3f9578;
          --seq-3: #55af8f;
          --seq-4: #6fc9a8;
          --seq-5: #91e1c3;
          --div-0: #d6954a;
          --div-1: #a77438;
          --div-2: #5a5852;
          --div-3: #458a71;
          --div-4: #55af8f;
          --div-5: #78d3b1;
          --map-none: #34362e;
        }
      }

      :root[data-theme="dark"] {
        --paper: #191b16;
        --ink: #ece9df;
        --quiet: #9d9a8d;
        --rule: #313329;
        --brass: #cfa64a;
        --chart-up: #40a687;
        --chart-down: #b98a2c;
        --well: #20221c;
        --code-string: #cfa64a;
        --code-number: #5bb898;
        --seq-0: #2c614e;
        --seq-1: #367b63;
        --seq-2: #3f9578;
        --seq-3: #55af8f;
        --seq-4: #6fc9a8;
        --seq-5: #91e1c3;
        --div-0: #d6954a;
        --div-1: #a77438;
        --div-2: #5a5852;
        --div-3: #458a71;
        --div-4: #55af8f;
        --div-5: #78d3b1;
        --map-none: #34362e;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: var(--t-base);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        max-width: 74rem;
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 2.5rem) 6rem;
      }

      p {
        margin: 0 0 1.05rem;
        max-width: var(--measure);
      }

      a {
        color: var(--ink);
        text-decoration-color: var(--brass);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--brass);
      }

      :focus-visible {
        outline: 2px solid var(--brass);
        outline-offset: 2px;
      }

      code,
      .mono {
        font-family: var(--mono);
        font-size: 0.88em;
        font-variant-ligatures: none;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      /* The data plate, shared by the map and the charts. ------------------- */

      .plate {
        background: var(--plate);
        color: var(--plate-ink);
        border: 1px solid var(--plate-rule);
        border-radius: 4px;
        padding: clamp(1rem, 2.2vw, 1.6rem);
      }

      /* Masthead ------------------------------------------------------------ */

      html {
        scroll-padding-top: calc(var(--bar-h, 4.5rem) + 1rem);
      }

      .masthead {
        position: sticky;
        top: 0;
        z-index: 20;
        padding-top: env(safe-area-inset-top, 0px);
        background: var(--paper);
        border-bottom: 1px solid transparent;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .masthead.scrolled {
        border-bottom-color: var(--rule);
      }

      .masthead.away {
        transform: translateY(-100%);
      }

      .masthead {
        width: 100%;
        max-width: 74rem;
        margin: 0 auto;
        padding: 1rem clamp(1rem, 4vw, 2.5rem);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.75rem;
        align-items: baseline;
        justify-content: space-between;
      }

      .wordmark {
        font-family: var(--display);
        font-size: var(--t-md);
        letter-spacing: 0.002em;
        text-decoration: none;
      }

      .sections {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        margin-inline-end: auto;
        font-size: var(--t-sm);
      }

      .sections a {
        color: var(--quiet);
        text-decoration: none;
      }

      .sections a:hover,
      .sections a[aria-current] {
        color: var(--ink);
      }

      .sections a[aria-current] {
        text-decoration: underline;
        text-decoration-color: var(--brass);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
      }

      .controls {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 1.5rem;
        align-items: baseline;
      }

      .tongues {
        display: flex;
        gap: 1rem;
        font-size: var(--t-sm);
      }

      .tongues a {
        color: var(--quiet);
        text-decoration: none;
      }

      .tongues a:hover {
        color: var(--ink);
      }

      .tongues a[aria-current="page"] {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--brass);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
      }

      .themes {
        display: flex;
        gap: 0;
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 2px;
        margin: 0;
        min-width: 0;
      }

      .themes button {
        font: inherit;
        font-size: var(--t-xs);
        color: var(--quiet);
        background: none;
        border: 0;
        border-radius: 999px;
        padding: 0.18rem 0.6rem;
        cursor: pointer;
        line-height: 1.5;
      }

      .themes button:hover {
        color: var(--ink);
      }

      .themes button[aria-pressed="true"] {
        color: var(--paper);
        background: var(--ink);
      }

      /* Footer -------------------------------------------------------------- */

      /* The gutter is margin rather than padding, so the rule on top stops where the
         content does instead of running past it into the gutter. */
      footer {
        --gutter: clamp(1rem, 4vw, 2.5rem);
        width: calc(100% - 2 * var(--gutter));
        max-width: calc(74rem - 2 * var(--gutter));
        margin: 0 auto;
        padding: 2rem 0 4rem;
        border-top: 1px solid var(--rule);
        color: var(--quiet);
        font-size: var(--t-sm);
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 3rem;
        justify-content: space-between;
      }

      footer p {
        margin: 0 0 0.35rem;
        max-width: 70ch;
      }

      footer .made {
        text-align: end;
      }

      footer a {
        color: var(--quiet);
      }

      footer a:hover {
        color: var(--ink);
      }

      footer .links {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.2rem 1rem;
      }

      @media (max-width: 40rem) {
        footer .links {
          justify-content: flex-start;
        }
      }

      @media (max-width: 40rem) {
        footer .made {
          text-align: start;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
