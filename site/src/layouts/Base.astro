---
import { AUTHOR, HTML_LANG, LOCALE_NAMES, LOCALES, REPO_URL, path, t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const site = Astro.site;
const absolute = (p: string) => (site ? new URL(p, site).href : null);
const canonical = absolute(Astro.url.pathname);
const ogImage = absolute("/og.png");
const themes = [
  { id: "auto", label: copy.themeAuto },
  { id: "light", label: copy.themeLight },
  { id: "dark", label: copy.themeDark },
];
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.tagline} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.title} />
    <meta property="og:title" content={copy.tagline} />
    <meta property="og:description" content={copy.intro} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.tagline} />
    <meta name="twitter:description" content={copy.intro} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={copy.mapCaption} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      site &&
        LOCALES.map((l) => (
          <link rel="alternate" hreflang={HTML_LANG[l]} href={absolute(path(l))!} />
        ))
    }
    {site && <link rel="alternate" hreflang="x-default" href={absolute(path("en"))!} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:ital,wght@0,400..600;1,400..500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Before first paint, so a chosen theme never flashes the other one. Storage can
      // throw in a private window, and the page has to render regardless.
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {
        /* no stored preference is readable; the media query decides */
      }
    </script>
  </head>
  <body>
    <header class="masthead">
      <a class="wordmark" href={path(locale)}>{copy.title}</a>
      <div class="controls">
        <nav class="tongues" aria-label={copy.language}>
          {LOCALES.map((l) => (
            <a href={path(l)} hreflang={HTML_LANG[l]} aria-current={l === locale ? "page" : undefined}>
              {LOCALE_NAMES[l]}
            </a>
          ))}
        </nav>
        <fieldset class="themes">
          <legend class="sr-only">{copy.theme}</legend>
          {themes.map((theme) => (
            <button type="button" data-set-theme={theme.id} aria-pressed="false">{theme.label}</button>
          ))}
        </fieldset>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="credits">
        <p>{copy.footerData}</p>
        <p>{copy.footerGeometry}</p>
      </div>
      <div class="made">
        <p>© {new Date().getFullYear()} <a href={AUTHOR.url}>{AUTHOR.name}</a></p>
        <p><a href={REPO_URL}>{copy.repo}</a></p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var buttons = Array.prototype.slice.call(document.querySelectorAll("[data-set-theme]"));
        var current = function () {
          return root.dataset.theme || "auto";
        };
        var paint = function () {
          var now = current();
          buttons.forEach(function (button) {
            button.setAttribute("aria-pressed", String(button.dataset.setTheme === now));
          });
        };
        buttons.forEach(function (button) {
          button.addEventListener("click", function () {
            var next = button.dataset.setTheme;
            if (next === "auto") delete root.dataset.theme;
            else root.dataset.theme = next;
            try {
              if (next === "auto") localStorage.removeItem("theme");
              else localStorage.setItem("theme", next);
            } catch (e) {
              /* the choice still applies to this page view */
            }
            paint();
          });
        });
        paint();
      })();
    </script>

    <style is:global>
      :root {
        /* The document ground: warm grey stock, survey ink, one rule colour. */
        --paper: #f1efe9;
        --ink: #191d19;
        --quiet: #5f6660;
        --rule: #dcd9d0;
        --brass: #836722;

        /* The data plate. Fixed in both themes, because it is a field the page sets
           data on rather than a surface that follows the page. */
        --plate: #0d1a17;
        --plate-ink: #e8efe9;
        --plate-quiet: #8ba398;
        --plate-rule: #26392f;
        --plate-accent: #7fcfae;
        --plate-warn: #d8a83e;

        --display: "Instrument Serif", Georgia, "Times New Roman", serif;
        --sans: "Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;

        /* A fourth, per Bringhurst. */
        --t-xs: 0.8125rem;
        --t-sm: 0.875rem;
        --t-base: 1rem;
        --t-md: 1.333rem;
        --t-lg: 1.777rem;
        --t-xl: 2.37rem;
        --t-2xl: 3.157rem;
        --measure: 68ch;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --paper: #191b16;
          --ink: #ece9df;
          --quiet: #9d9a8d;
          --rule: #313329;
          --brass: #cfa64a;
        }
      }

      :root[data-theme="dark"] {
        --paper: #191b16;
        --ink: #ece9df;
        --quiet: #9d9a8d;
        --rule: #313329;
        --brass: #cfa64a;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: var(--t-base);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        max-width: 74rem;
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 2.5rem) 6rem;
      }

      p {
        margin: 0 0 1.05rem;
        max-width: var(--measure);
      }

      a {
        color: var(--ink);
        text-decoration-color: var(--brass);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--brass);
      }

      :focus-visible {
        outline: 2px solid var(--brass);
        outline-offset: 2px;
      }

      code,
      .mono {
        font-family: var(--mono);
        font-size: 0.88em;
        font-variant-ligatures: none;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      /* The data plate, shared by the map and the charts. ------------------- */

      .plate {
        background: var(--plate);
        color: var(--plate-ink);
        border: 1px solid var(--plate-rule);
        border-radius: 4px;
        padding: clamp(1rem, 2.2vw, 1.6rem);
      }

      /* Masthead ------------------------------------------------------------ */

      .masthead {
        width: 100%;
        max-width: 74rem;
        margin: 0 auto;
        padding: 1.5rem clamp(1rem, 4vw, 2.5rem);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.75rem;
        align-items: baseline;
        justify-content: space-between;
      }

      .wordmark {
        font-family: var(--display);
        font-size: var(--t-md);
        letter-spacing: 0.002em;
        text-decoration: none;
      }

      .controls {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 1.5rem;
        align-items: baseline;
      }

      .tongues {
        display: flex;
        gap: 1rem;
        font-size: var(--t-sm);
      }

      .tongues a {
        color: var(--quiet);
        text-decoration: none;
      }

      .tongues a:hover {
        color: var(--ink);
      }

      .tongues a[aria-current="page"] {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--brass);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
      }

      .themes {
        display: flex;
        gap: 0;
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 2px;
        margin: 0;
        min-width: 0;
      }

      .themes button {
        font: inherit;
        font-size: var(--t-xs);
        color: var(--quiet);
        background: none;
        border: 0;
        border-radius: 999px;
        padding: 0.18rem 0.6rem;
        cursor: pointer;
        line-height: 1.5;
      }

      .themes button:hover {
        color: var(--ink);
      }

      .themes button[aria-pressed="true"] {
        color: var(--paper);
        background: var(--ink);
      }

      /* Footer -------------------------------------------------------------- */

      footer {
        width: 100%;
        max-width: 74rem;
        margin: 0 auto;
        padding: 2rem clamp(1rem, 4vw, 2.5rem) 4rem;
        border-top: 1px solid var(--rule);
        color: var(--quiet);
        font-size: var(--t-sm);
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 3rem;
        justify-content: space-between;
      }

      footer p {
        margin: 0 0 0.35rem;
        max-width: 70ch;
      }

      footer .made {
        text-align: end;
      }

      footer a {
        color: var(--quiet);
      }

      footer a:hover {
        color: var(--ink);
      }

      @media (max-width: 40rem) {
        footer .made {
          text-align: start;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
