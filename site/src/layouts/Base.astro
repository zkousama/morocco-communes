---
import { LOCALE_NAMES, LOCALES, REPO_URL, path, t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.tagline} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..500&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="masthead">
      <a class="wordmark" href={path(locale)}>{copy.title}</a>
      <nav class="tongues" aria-label={copy.language}>
        {LOCALES.map((l) => (
          <a href={path(l)} hreflang={l} aria-current={l === locale ? "page" : undefined}>
            {LOCALE_NAMES[l]}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>{copy.footerData}</p>
      <p>{copy.footerGeometry}</p>
      {REPO_URL ? <p><a href={REPO_URL}>{copy.repo}</a></p> : null}
    </footer>

    <style is:global>
      :root {
        /* A document ground. Warm grey drafting stock, survey ink, one rule colour. */
        --paper: #f1efe9;
        --ink: #191d19;
        --quiet: #63695f;
        --rule: #dcd9d0;
        /* Machine output — code blocks and API responses — sits in a well, while the
           page itself stays document. The map went the other way: it reads as a survey
           drawing on the page ground rather than a panel fighting it. */
        --canvas: #0b1512;
        --brass: #8a6d24;

        --serif: "Newsreader", Georgia, "Times New Roman", serif;
        --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;

        /* A fourth, per Bringhurst. */
        --t-xs: 0.75rem;
        --t-sm: 0.875rem;
        --t-base: 1.0625rem;
        --t-md: 1.333rem;
        --t-lg: 1.777rem;
        --t-xl: 2.37rem;
        --t-2xl: 3.157rem;
        --measure: 64ch;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --paper: #12140f;
          --ink: #ece9df;
          --quiet: #999687;
          --rule: #2b2d24;
          --canvas: #050a08;
          --brass: #cfa64a;
        }
      }

      :root[data-theme="dark"] {
        --paper: #12140f;
        --ink: #ece9df;
        --quiet: #999687;
        --rule: #2b2d24;
        --canvas: #050a08;
        --brass: #cfa64a;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--serif);
        font-optical-sizing: auto;
        font-size: var(--t-base);
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 2.5rem) 6rem;
      }

      p {
        margin: 0 0 1.1rem;
        max-width: var(--measure);
      }

      a {
        color: var(--ink);
        text-decoration-color: var(--brass);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--brass);
      }

      :focus-visible {
        outline: 2px solid var(--brass);
        outline-offset: 2px;
      }

      code,
      .mono {
        font-family: var(--mono);
        font-size: 0.9em;
        font-variant-ligatures: none;
      }

      /* Masthead ------------------------------------------------------------- */

      .masthead {
        width: 100%;
        max-width: 72rem;
        margin: 0 auto;
        padding: 1.6rem clamp(1rem, 4vw, 2.5rem);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        align-items: baseline;
        justify-content: space-between;
      }

      .wordmark {
        font-size: var(--t-md);
        font-weight: 500;
        letter-spacing: -0.015em;
        text-decoration: none;
      }

      .tongues {
        display: flex;
        gap: 1rem;
        font-size: var(--t-sm);
      }

      .tongues a {
        color: var(--quiet);
        text-decoration: none;
      }

      .tongues a:hover {
        color: var(--ink);
      }

      .tongues a[aria-current="page"] {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--brass);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
      }

      /* Footer --------------------------------------------------------------- */

      footer {
        width: 100%;
        max-width: 72rem;
        margin: 0 auto;
        padding: 2rem clamp(1rem, 4vw, 2.5rem) 4rem;
        border-top: 1px solid var(--rule);
        color: var(--quiet);
        font-size: var(--t-sm);
      }

      footer p {
        margin: 0 0 0.35rem;
        max-width: 70ch;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
