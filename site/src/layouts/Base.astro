---
import { AUTHOR, LOCALE_NAMES, LOCALES, REPO_URL, path, t, type Locale } from "../i18n/ui";
import Search from "../components/Search.astro";

interface Props {
  locale: Locale;
  /** The page's path after the locale prefix, so switching language keeps the page. */
  route?: string;
  /** False on a page that is no route of its own, such as the one for an address with no page. */
  current?: boolean;
  /** A page's own title and summary. The home page has neither, and uses the site's. */
  title?: string;
  description?: string;
}
const { locale, route = "", title, description, current = true } = Astro.props;
// Cloudflare Web Analytics, when a token is given at build time. It sets no cookies.
const analytics = process.env.CF_ANALYTICS_TOKEN;
const copy = t(locale);
const sections = [
  { route: "communes/", label: copy.navCommunes },
  { route: "docs/indicators/", label: copy.navFigures },
  { route: "docs/glossary/", label: copy.navGlossary },
  { route: "docs/api/", label: copy.navApi },
  { route: "docs/mcp/", label: copy.navMcp },
  { route: "docs/components/", label: copy.navComponents },
  { route: "docs/npm/", label: copy.navNpm },
  { route: "docs/python/", label: copy.navPython },
];
const site = Astro.site;
const absolute = (p: string) => (site ? new URL(p, site).href : null);
// A page that is no route of its own, the one for an address with nothing at it, has no
// address to declare and nothing for a search engine to keep.
const canonical = current ? absolute(Astro.url.pathname) : null;
const ogImage = absolute("/og.png");
const themes = [
  { id: "auto", label: copy.themeAuto },
  { id: "light", label: copy.themeLight },
  { id: "dark", label: copy.themeDark },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${copy.title}` : copy.title}</title>
    <meta name="description" content={description ?? copy.tagline} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.title} />
    <meta property="og:title" content={title ?? copy.tagline} />
    <meta property="og:description" content={description ?? copy.intro} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? copy.tagline} />
    <meta name="twitter:description" content={description ?? copy.intro} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={copy.tagline} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {!current && <meta name="robots" content="noindex" />}
    {
      site && current &&
        LOCALES.map((l) => (
          <link rel="alternate" hreflang={l} href={absolute(path(l, route))!} />
        ))
    }
    {site && current && <link rel="alternate" hreflang="x-default" href={absolute(path("en", route))!} />}
    {site && <link rel="sitemap" href="/sitemap.xml" />}
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:ital,wght@0,400..600;1,400..500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // The phone menu only folds away once a script can open it again.
      document.documentElement.classList.add("js");
      // Before first paint, so a chosen theme never flashes the other one. Storage can
      // throw in a private window, and the page has to render regardless.
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {
        /* no stored preference is readable; the media query decides */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{copy.skip}</a>
    <header class="site-header">
      <div class="masthead">
      <a class="wordmark" href={path(locale)}>{copy.title}</a>
      <div class="menu" id="site-menu">
      <nav class="sections" aria-label={copy.navLabel}>
        {sections.map((s) => (
          <a
            href={path(locale, s.route)}
            aria-current={
              !current
                ? undefined
                : s.route === route
                  ? "page"
                  : s.route === "communes/" && /^(communes|provinces|regions)\//.test(route)
                    ? "true"
                    : undefined
            }
          >
            {s.label}
          </a>
        ))}
      </nav>
      <div class="settings">
        <nav class="tongues" aria-label={copy.language}>
          {LOCALES.map((l) => (
            <a href={path(l, route)} hreflang={l} lang={l} aria-current={current && l === locale ? "page" : undefined}>
              {LOCALE_NAMES[l]}
            </a>
          ))}
        </nav>
        <fieldset class="themes">
          <legend class="sr-only">{copy.theme}</legend>
          {themes.map((theme) => (
            <button type="button" data-set-theme={theme.id} aria-pressed="false">{theme.label}</button>
          ))}
        </fieldset>
      </div>
      </div>
      <div class="tools">
        <Search locale={locale} />
        <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" aria-label={copy.menu}>
          <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
            <g class="open-lines">
              <line x1="2.5" y1="5" x2="15.5" y2="5" />
              <line x1="2.5" y1="9" x2="15.5" y2="9" />
              <line x1="2.5" y1="13" x2="15.5" y2="13" />
            </g>
            <g class="shut">
              <line x1="4" y1="4" x2="14" y2="14" />
              <line x1="14" y1="4" x2="4" y2="14" />
            </g>
          </svg>
        </button>
      </div>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <button type="button" class="totop" aria-label={copy.backToTop} hidden>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <line x1="8" y1="13" x2="8" y2="3.5" />
        <polyline points="3.6,8 8,3.4 12.4,8" />
      </svg>
    </button>

    <footer>
      <div class="credits">
        <p>{copy.footerData}</p>
        <p>{copy.footerGeometry}</p>
      </div>
      <div class="made">
        <p>© {new Date().getFullYear()} <a href={AUTHOR.url}>{AUTHOR.name}</a></p>
        <p class="links">
          <a href={REPO_URL}>{copy.repo}</a>
          <a href={`${REPO_URL}/blob/main/CITATION.cff`}>{copy.cite}</a>
          <a href={`${REPO_URL}/issues/new/choose`}>{copy.report}</a>
          <a href="/llms.txt">llms.txt</a>
        </p>
      </div>
    </footer>

    {
      analytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analytics })}
        />
      )
    }

    <script is:inline>
      // The bar stays at the top. Its height is published for the contents list and for
      // anchors to clear; on a phone, where it's tall, it slides away while reading down
      // and comes back on the way up.
      (function () {
        var bar = document.querySelector(".site-header");
        if (!bar) return;
        var root = document.documentElement;
        var publish = function () {
          root.style.setProperty("--bar-h", bar.offsetHeight + "px");
        };
        publish();
        if (window.ResizeObserver) new ResizeObserver(publish).observe(bar);
        var last = window.scrollY;
        var narrow = window.matchMedia("(max-width: 48rem)");
        // The way back up appears once a screenful and a half is behind you.
        var top = document.querySelector(".totop");
        if (top) {
          top.hidden = false;
          top.addEventListener("click", function () {
            window.scrollTo({ top: 0, behavior: "smooth" });
            var main = document.getElementById("content");
            if (main) main.focus({ preventScroll: true });
          });
        }
        window.addEventListener(
          "scroll",
          function () {
            var y = window.scrollY;
            bar.classList.toggle("scrolled", y > 4);
            bar.classList.toggle(
              "away",
              narrow.matches && y > last && y > bar.offsetHeight && !bar.classList.contains("menu-open"),
            );
            if (top) top.classList.toggle("shown", y > window.innerHeight * 1.5);
            last = y;
          },
          { passive: true },
        );
      })();
    </script>

    <script is:inline>
      // The phone menu: the button opens it, and Escape, a tap outside the bar, or a
      // window grown past the phone layout closes it.
      (function () {
        var bar = document.querySelector(".site-header");
        var button = document.querySelector(".menu-toggle");
        var menu = document.getElementById("site-menu");
        if (!bar || !button || !menu) return;
        var set = function (open) {
          button.setAttribute("aria-expanded", String(open));
          menu.classList.toggle("open", open);
          bar.classList.toggle("menu-open", open);
        };
        button.addEventListener("click", function () {
          set(button.getAttribute("aria-expanded") !== "true");
        });
        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && menu.classList.contains("open")) {
            set(false);
            button.focus();
          }
        });
        document.addEventListener("click", function (event) {
          if (menu.classList.contains("open") && !bar.contains(event.target)) set(false);
        });
        var narrow = window.matchMedia("(max-width: 48rem)");
        var widen = function () {
          if (!narrow.matches) set(false);
        };
        if (narrow.addEventListener) narrow.addEventListener("change", widen);
      })();
    </script>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var buttons = Array.prototype.slice.call(document.querySelectorAll("[data-set-theme]"));
        var current = function () {
          return root.dataset.theme || "auto";
        };
        var paint = function () {
          var now = current();
          buttons.forEach(function (button) {
            button.setAttribute("aria-pressed", String(button.dataset.setTheme === now));
          });
        };
        buttons.forEach(function (button) {
          button.addEventListener("click", function () {
            var next = button.dataset.setTheme;
            if (next === "auto") delete root.dataset.theme;
            else root.dataset.theme = next;
            try {
              if (next === "auto") localStorage.removeItem("theme");
              else localStorage.setItem("theme", next);
            } catch (e) {
              /* the choice still applies to this page view */
            }
            paint();
          });
        });
        paint();
      })();
    </script>

    <style is:global>
      @font-face {
        font-family: "Bouazzi Maghribi";
        src: url("/fonts/BouazziMaghribi-Regular.woff2") format("woff2");
        font-display: swap;
        /* Its letters sit small beside the Latin faces; this brings them level. */
        size-adjust: 130%;
        unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
      }

      :root {
        /* The document ground: warm grey stock, survey ink, one rule colour. */
        --paper: #f1efe9;
        --ink: #191d19;
        --quiet: #5f6660;
        --rule: #dcd9d0;
        --brass: #836722;

        /* The data plate. Fixed in both themes, because it is a field the page sets
           data on rather than a surface that follows the page. */
        --plate: #0d1a17;
        --plate-ink: #e8efe9;
        --plate-quiet: #8ba398;
        --plate-rule: #26392f;
        --plate-accent: #7fcfae;
        --plate-warn: #d8a83e;

        /* Charts sit on the page, so their colours follow its theme. A diverging pair,
           checked with the dataviz validator against each surface: lightness band,
           chroma floor, colour-blind separation (protan ΔE 9.1 here, 10.7 in dark) and
           3:1 contrast. The neutral midpoint is the rule colour. */
        --chart-up: #0f8266;
        --chart-down: #b3781b;

        /* The map's ramps, checked with the dataviz validator against this page: one hue
           light to dark for density, and for change two arms on either side of a grey
           that means "about the same". The palest class clears the page at 2:1. */
        --seq-0: #80b19d;
        --seq-1: #61a088;
        --seq-2: #408e73;
        --seq-3: #257b60;
        --seq-4: #0d664d;
        --seq-5: #07503c;
        --div-0: #8f520d;
        --div-1: #b17d41;
        --div-2: #a6a59e;
        --div-3: #5c9b83;
        --div-4: #338469;
        --div-5: #096048;
        --map-none: #d3d0c6;

        /* Code sits in a well a shade off the page. Its string and number colours are
           darker than the brass and green above, to hold 4.5:1 on the well. */
        --well: #ebe8e0;
        --code-string: #7a5f1c;
        --code-number: #0c7059;

        /* Arabic is set in Bouazzi Maghribi, a revival of a Moroccan Maghribi face. Its
           @font-face covers the Arabic block only, so it sits in every stack and only
           ever draws Arabic. */
        --display: "Instrument Serif", "Bouazzi Maghribi", Georgia, "Times New Roman", serif;
        --sans: "Instrument Sans", "Bouazzi Maghribi", system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: "JetBrains Mono", "Bouazzi Maghribi", ui-monospace, Menlo, Consolas, monospace;

        /* A fourth, per Bringhurst. */
        --t-xs: 0.8125rem;
        --t-sm: 0.875rem;
        --t-base: 1rem;
        --t-md: 1.333rem;
        --t-lg: 1.777rem;
        --t-xl: 2.37rem;
        --t-2xl: 3.157rem;
        --measure: 68ch;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --paper: #191b16;
          --ink: #ece9df;
          --quiet: #9d9a8d;
          --rule: #313329;
          --brass: #cfa64a;
          --chart-up: #40a687;
          --chart-down: #b98a2c;
          --well: #20221c;
          --code-string: #cfa64a;
          --code-number: #5bb898;
          --seq-0: #2c614e;
          --seq-1: #367b63;
          --seq-2: #3f9578;
          --seq-3: #55af8f;
          --seq-4: #6fc9a8;
          --seq-5: #91e1c3;
          --div-0: #d6954a;
          --div-1: #a77438;
          --div-2: #5a5852;
          --div-3: #458a71;
          --div-4: #55af8f;
          --div-5: #78d3b1;
          --map-none: #34362e;
        }
      }

      :root[data-theme="dark"] {
        --paper: #191b16;
        --ink: #ece9df;
        --quiet: #9d9a8d;
        --rule: #313329;
        --brass: #cfa64a;
        --chart-up: #40a687;
        --chart-down: #b98a2c;
        --well: #20221c;
        --code-string: #cfa64a;
        --code-number: #5bb898;
        --seq-0: #2c614e;
        --seq-1: #367b63;
        --seq-2: #3f9578;
        --seq-3: #55af8f;
        --seq-4: #6fc9a8;
        --seq-5: #91e1c3;
        --div-0: #d6954a;
        --div-1: #a77438;
        --div-2: #5a5852;
        --div-3: #458a71;
        --div-4: #55af8f;
        --div-5: #78d3b1;
        --map-none: #34362e;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      /* A big screen is read from further away. Sizes are in rem, so a larger root scales
         the type, the spacing and the 74rem column together. */
      @media (min-width: 1800px) {
        html {
          font-size: 106.25%;
        }
      }

      @media (min-width: 2300px) {
        html {
          font-size: 118.75%;
        }
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: var(--t-base);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        max-width: 74rem;
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 2.5rem) 6rem;
      }

      p {
        margin: 0 0 1.05rem;
        max-width: var(--measure);
      }

      a {
        color: var(--ink);
        text-decoration-color: var(--brass);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--brass);
      }

      :focus-visible {
        outline: 2px solid var(--brass);
        outline-offset: 2px;
      }

      code,
      .mono {
        font-family: var(--mono);
        font-size: 0.88em;
        font-variant-ligatures: none;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      /* The data plate, shared by the map and the charts. ------------------- */

      .plate {
        background: var(--plate);
        color: var(--plate-ink);
        border: 1px solid var(--plate-rule);
        border-radius: 4px;
        padding: clamp(1rem, 2.2vw, 1.6rem);
      }

      /* Masthead ------------------------------------------------------------ */

      html {
        scroll-padding-top: calc(var(--bar-h, 4.5rem) + 1rem);
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        padding-top: env(safe-area-inset-top, 0px);
        background: var(--paper);
        border-bottom: 1px solid transparent;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .site-header.scrolled {
        border-bottom-color: var(--rule);
      }

      .site-header.away {
        transform: translateY(-100%);
      }

      /* The header runs the width of the window rather than the measure the pages hold
         to, so the wordmark sits at one end and the theme at the other, and what is
         between them has room. */
      .masthead {
        width: 100%;
        padding: 1rem clamp(1rem, 3vw, 2.5rem);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.75rem;
        align-items: baseline;
        justify-content: space-between;
      }

      .wordmark {
        font-family: var(--display);
        font-size: var(--t-md);
        letter-spacing: 0.002em;
        text-decoration: none;
      }

      .sections {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        margin-inline-end: auto;
        font-size: var(--t-sm);
      }

      /* The wordmark holds its end; the controls still wrap on a narrow window. */
      .wordmark {
        flex: none;
      }

      .sections a {
        color: var(--quiet);
        text-decoration: none;
      }

      .sections a:hover,
      .sections a[aria-current] {
        color: var(--ink);
      }

      /* Off the top until a keyboard reaches it. */
      .skip {
        position: absolute;
        inset-inline-start: 0.5rem;
        top: -3rem;
        z-index: 30;
        padding: 0.5rem 0.9rem;
        border-radius: 2px;
        background: var(--ink);
        color: var(--paper);
        font-size: var(--t-sm);
        transition: top 0.12s;
      }

      .skip:focus {
        top: 0.5rem;
      }

      /* Back to the top of a long page, once there is a long page behind you. */
      .totop {
        position: fixed;
        inset-block-end: clamp(1rem, 3vw, 2rem);
        inset-inline-end: clamp(1rem, 3vw, 2rem);
        z-index: 15;
        width: 2.4rem;
        height: 2.4rem;
        display: grid;
        place-items: center;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: var(--paper);
        color: var(--quiet);
        cursor: pointer;
        opacity: 0;
        transform: translateY(0.4rem);
        transition: opacity 0.18s ease, transform 0.18s ease, color 0.18s ease, border-color 0.18s ease;
      }

      .totop[hidden] {
        display: none;
      }

      .totop.shown {
        opacity: 1;
        transform: none;
      }

      .totop:hover {
        color: var(--ink);
        border-color: var(--ink);
      }

      .totop svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      @media (prefers-reduced-motion: reduce) {
        .totop {
          transition: none;
        }
      }

      main:focus {
        outline: 0;
      }

      .sections a[aria-current] {
        text-decoration: underline;
        text-decoration-color: var(--brass);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
      }

      /* On a wide window the menu's wrapper steps aside and its parts line up in the
         bar as they always have: sections, search, language, theme. */
      .menu {
        display: contents;
      }

      .sections {
        order: 1;
      }

      .tools {
        order: 2;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .settings {
        order: 3;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem clamp(0.75rem, 2vw, 1.5rem);
        align-items: baseline;
      }

      .menu-toggle {
        display: none;
      }

      /* On a phone the bar keeps the wordmark, search and a menu button, and the rest
         opens under it. Only with a script: without one there is nothing to open the
         menu with, so the full bar stays. */
      @media (max-width: 48rem) {
        .js .masthead {
          flex-wrap: nowrap;
          align-items: center;
        }

        .js .tools {
          margin-inline-start: auto;
        }

        .js .menu-toggle {
          display: inline-grid;
          place-items: center;
          width: 2.4rem;
          height: 2.4rem;
          padding: 0;
          border: 1px solid var(--rule);
          border-radius: 999px;
          background: none;
          color: var(--ink);
          cursor: pointer;
        }

        .menu-toggle svg {
          width: 1.1rem;
          height: 1.1rem;
          fill: none;
          stroke: currentColor;
          stroke-width: 1.6;
          stroke-linecap: round;
        }

        .menu-toggle .shut {
          display: none;
        }

        .menu-toggle[aria-expanded="true"] .open-lines {
          display: none;
        }

        .menu-toggle[aria-expanded="true"] .shut {
          display: inline;
        }

        .js .menu {
          display: none;
        }

        .js .menu.open {
          display: flex;
          flex-direction: column;
          position: absolute;
          top: 100%;
          inset-inline: 0;
          max-height: calc(100dvh - var(--bar-h, 4rem));
          overflow-y: auto;
          padding: 0.25rem clamp(1rem, 3vw, 2.5rem) 1.25rem;
          background: var(--paper);
          border-bottom: 1px solid var(--rule);
        }

        .js .menu.open .sections {
          flex-direction: column;
          flex-wrap: nowrap;
          gap: 0;
          margin: 0;
          font-size: var(--t-md);
        }

        .js .menu.open .sections a {
          padding: 0.65rem 0;
          border-bottom: 1px solid var(--rule);
        }

        .js .menu.open .settings {
          justify-content: space-between;
          align-items: center;
          gap: 1rem;
          padding-top: 1.1rem;
        }
      }

      .tongues {
        display: flex;
        gap: 1rem;
        font-size: var(--t-sm);
      }

      .tongues a {
        color: var(--quiet);
        text-decoration: none;
      }

      .tongues a:hover {
        color: var(--ink);
      }

      .tongues a[aria-current="page"] {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--brass);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
      }

      .themes {
        display: flex;
        gap: 0;
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 2px;
        margin: 0;
        min-width: 0;
      }

      .themes button {
        font: inherit;
        font-size: var(--t-xs);
        color: var(--quiet);
        background: none;
        border: 0;
        border-radius: 999px;
        padding: 0.18rem 0.6rem;
        cursor: pointer;
        line-height: 1.5;
      }

      .themes button:hover {
        color: var(--ink);
      }

      .themes button[aria-pressed="true"] {
        color: var(--paper);
        background: var(--ink);
      }

      /* Footer -------------------------------------------------------------- */

      /* The gutter is margin rather than padding, so the rule on top stops where the
         content does instead of running past it into the gutter. */
      footer {
        --gutter: clamp(1rem, 4vw, 2.5rem);
        width: calc(100% - 2 * var(--gutter));
        max-width: calc(74rem - 2 * var(--gutter));
        margin: 0 auto;
        padding: 2rem 0 4rem;
        border-top: 1px solid var(--rule);
        color: var(--quiet);
        font-size: var(--t-sm);
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 3rem;
        justify-content: space-between;
      }

      /* Wide enough for the whole credit on one line: at 70ch it overflowed by 10px and
         dropped the year onto a second line, leaving the credits 3 lines against the 2
         beside them. */
      footer p {
        margin: 0 0 0.35rem;
        max-width: 74ch;
      }

      footer .made {
        text-align: end;
      }

      footer a {
        color: var(--quiet);
      }

      footer a:hover {
        color: var(--ink);
      }

      footer .links {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.2rem 1rem;
      }

      @media (max-width: 40rem) {
        footer .links {
          justify-content: flex-start;
        }
      }

      @media (max-width: 40rem) {
        footer .made {
          text-align: start;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
