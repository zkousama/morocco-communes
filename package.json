{
  "name": "morocco-communes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dataset:build": "node --experimental-strip-types pipeline/src/index.ts",
    "dataset:fetch": "node --experimental-strip-types pipeline/src/fetchSources.ts",
    "api:build": "node --experimental-strip-types api/src/emit/index.ts",
    "api:dev": "wrangler pages dev --port 8788",
    "deploy": "wrangler pages deploy --branch main",
    "api:smoke": "node --experimental-strip-types api/smoke.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
    "check": "pnpm typecheck && pnpm test",
    "site:dev": "astro dev --root site",
    "site:build": "pnpm site:data && astro build --root site",
    "build": "pnpm site:build && pnpm api:build",
    "site:data": "node --experimental-strip-types site/scripts/map.ts && node --experimental-strip-types site/scripts/hierarchy.ts && node --experimental-strip-types site/scripts/charts.ts && node --experimental-strip-types site/scripts/downloads.ts && node --experimental-strip-types site/scripts/reference.ts",
    "site:og": "node --experimental-strip-types site/scripts/og.ts",
    "npm:build": "node --experimental-strip-types packages/morocco-communes/build.ts",
    "py:build": "python3 packages/morocco-communes-py/build_data.py",
    "eval": "node --experimental-strip-types evals/run.ts",
    "stats": "node --experimental-strip-types scripts/stats.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/solid-js": "^7.0.2",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^22.10.0",
    "@types/polylabel": "^2.0.0",
    "@types/topojson-server": "^3.0.4",
    "astro": "^7.3.3",
    "polygon-clipping": "~0.15.7",
    "shiki": "^3.23.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.134.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ]
  }
}
